@page "/sales"
@using GastroApp.Models
@using GastroApp.Services
@using GastroApp.Shared.Pos
@inject ProductService ProductService
@inject ProductCategoryService CategoryService
@inject SaleService SaleService
@inject CashRegisterService CashService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Vender</PageTitle>

@{
    var register = CashService.GetCurrent();
    var registerOpen = CashService.IsOpen();
}

<div class="page-header pos-header">
    <div>
        <div class="page-header__title-row">
            <h1>Punto de Venta</h1>
            @if (registerOpen)
            {
                <Badge Variant="ok" Icon="checkCircle" Label="@($"Caja abierta · Sesión #{register?.Id}")" />
            }
            else
            {
                <Badge Variant="danger" Icon="alertOctagon" Label="Caja cerrada" />
            }
        </div>
        <p class="page-header__subtitle">Tocá o hacé clic en los productos para sumarlos al pedido. Los productos sin stock de receta quedan bloqueados; el stock se vuelve a validar al confirmar el cobro.</p>
    </div>
    @if (lastCompletedSale is not null)
    {
        <div class="page-header__actions">
            <button type="button" id="btn-last-receipt" class="btn btn--sm" @onclick="ShowLastReceipt">
                <Icon Name="receipt" Size="16" /> <span>Último comprobante (#@lastCompletedSale.Id)</span>
            </button>
        </div>
    }
</div>

@if (!registerOpen)
{
    <Banner Variant="danger" Title="La caja está cerrada. Abrí la caja para empezar a vender.">
        <Actions>
            <button type="button" class="btn btn--primary btn--sm" @onclick="GoToCash">Ir a Caja</button>
        </Actions>
    </Banner>
}
else
{
    if (!string.IsNullOrEmpty(stockError))
    {
        <div class="mb-4">
            <Banner Variant="danger" Title="No se pudo completar la venta">@stockError</Banner>
        </div>
    }

    var activeProducts = products.Where(p => p.IsActive).ToList();
    var filtered = FilteredProducts.ToList();

    <div class="pos-layout">
        <section class="stack" aria-label="Catálogo de productos">
            <search class="card card--compact stack stack--sm">
                <div class="toolbar">
                    <div class="search-wrap">
                        <span class="search-wrap__icon"><Icon Name="search" Size="18" /></span>
                        <label for="pos-search" class="visually-hidden">Buscar producto por nombre</label>
                        <input id="pos-search" @ref="searchInput" type="search" class="input" autocomplete="off" autocorrect="off" spellcheck="false"
                               placeholder="Buscar por nombre (ej.: café, hamburguesa, limonada…)"
                               @bind="nameSearch" @bind:event="oninput" />
                    </div>
                    @if (nameSearch.Length > 0)
                    {
                        <button type="button" class="btn btn--sm" @onclick="ClearSearch">Limpiar</button>
                    }
                </div>

                <div class="chip-row" role="group" aria-label="Filtrar por categoría">
                    <button type="button" class="chip" aria-pressed="@(categoryFilter == string.Empty ? "true" : "false")"
                            @onclick="@(() => categoryFilter = string.Empty)">Todos (@activeProducts.Count)</button>
                    @foreach (var category in categories)
                    {
                        var id = category.Id.ToString();
                        <button type="button" class="chip" aria-pressed="@(categoryFilter == id ? "true" : "false")"
                                @onclick="@(() => categoryFilter = id)">@category.Name (@activeProducts.Count(p => p.CategoryId == category.Id))</button>
                    }
                    @if (activeProducts.Any(p => !p.CategoryId.HasValue))
                    {
                        <button type="button" class="chip" aria-pressed="@(categoryFilter == UncategorizedFilter ? "true" : "false")"
                                @onclick="@(() => categoryFilter = UncategorizedFilter)">Sin categoría</button>
                    }
                </div>
            </search>

            @if (filtered.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state__icon"><Icon Name="products" Size="24" /></div>
                    <div class="stack stack--sm">
                        <h3>@(activeProducts.Count == 0 ? "No hay productos activos" : "Sin coincidencias en el catálogo")</h3>
                        <p class="text-sm text-secondary">
                            @(activeProducts.Count == 0
                                ? "Activá o creá productos en el módulo de Catálogo para comenzar a vender."
                                : "Probá limpiando la búsqueda o eligiendo otra categoría.")
                        </p>
                    </div>
                    @if (activeProducts.Count > 0)
                    {
                        <button type="button" class="btn" @onclick="ResetFilters">Mostrar todos los productos</button>
                    }
                </div>
            }
            else
            {
                <div class="pos-catalog-grid" role="list">
                    @foreach (var product in filtered)
                    {
                        <div role="listitem" @key="product.Id">
                            <ProductTile Product="product" CategoryName="@CategoryNameOf(product)"
                                         InCartQuantity="@QuantityInCart(product.Id)"
                                         Availability="@AvailabilityOf(product)"
                                         OnAdd="AddToCart" OnBlocked="ShowBlockedReason" />
                        </div>
                    }
                </div>
            }
        </section>

        <CartPanel Sale="currentSale" QuantityEditVersion="quantityEditVersion" MaxQuantity="MaxQuantityOf"
                   OnIncrement="IncrementQuantity" OnDecrement="DecrementQuantity"
                   OnQuantityChanged="EditQuantity" OnRemove="RemoveFromCart"
                   OnEditLine="OpenLineOptions" OnEditSaleDiscount="OpenSaleDiscount"
                   OnClear="ClearCartWithNotice" OnCheckout="OpenCheckout" />
    </div>

    <LineOptionsDialog @ref="lineDialog" Apply="ApplyLineOptions" />
    <SaleDiscountDialog @ref="discountDialog" Apply="ApplySaleDiscount" />
    <CheckoutDialog @ref="checkoutDialog" OnConfirm="CompleteSale" OnClosed="HandleCheckoutClosed" />
    <ReceiptDialog @ref="receiptDialog" OnClosed="HandleReceiptClosed" />
}

<Toast @ref="toast" />

@code {
    private const string UncategorizedFilter = "uncategorized";
    private const string RejectedSuffix = " Se mantuvo el carrito anterior.";

    private List<Product> products = new();
    private List<ProductCategory> categories = new();
    private string categoryFilter = string.Empty;
    private string nameSearch = string.Empty;
    private Sale currentSale = new();
    private string stockError = string.Empty;
    private int quantityEditVersion;

    private Toast toast = default!;
    private LineOptionsDialog lineDialog = default!;
    private SaleDiscountDialog discountDialog = default!;
    private CheckoutDialog checkoutDialog = default!;
    private ReceiptDialog receiptDialog = default!;
    private ElementReference searchInput;

    // Seam for the receipt (S10, T5): the sale exactly as SaleService stored it (Id, date, payments, change).
    private Sale? lastCompletedSale;
    // Set once per checkout; the receipt opens when the checkout dialog has finished closing.
    private bool receiptPending;
    // The receipt reopened from the header button returns focus to that button (native behavior), not to the search.
    private bool receiptFromCheckout;

    // Los filtros sólo proyectan el catálogo; no modifican productos ni el carrito.
    private IEnumerable<Product> FilteredProducts => products.Where(p =>
        p.IsActive
        && (categoryFilter == string.Empty
            || (categoryFilter == UncategorizedFilter ? !p.CategoryId.HasValue : p.CategoryId?.ToString() == categoryFilter))
        && p.Name.Contains(nameSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        products = ProductService.GetAll();
        categories = CategoryService.GetAll();
    }

    // S8: a product whose recipe cannot cover one more unit (counting what the cart already reserves) is blocked
    // and names the missing ingredient. The atomic checkout validation remains the second line of defense.
    private TileAvailability AvailabilityOf(Product product)
    {
        var availability = SaleService.GetAvailability(currentSale.Items, product);
        if (!availability.IsBlocked) return TileAvailability.Available;

        var ingredient = availability.LimitingIngredient;
        var reason = ingredient is null ? "No hay stock suficiente para una unidad más."
            : availability.InvalidRecipe ? $"La receta tiene una cantidad inválida de {ingredient}."
            : availability.ReservedByCart ? $"El carrito ya reserva todo el {ingredient} disponible."
            : $"Falta {ingredient}: no alcanza para una unidad más.";
        return availability.ReservedByCart && !availability.InvalidRecipe
            ? new TileAvailability(IsBlocked: true, Reason: reason, BadgeLabel: "Máximo en carrito", BadgeVariant: "warn")
            : new TileAvailability(IsBlocked: true, Reason: reason, BadgeLabel: "Sin stock", BadgeVariant: "danger");
    }

    // S8: maximum units of the line's product the cart may hold after the other lines reserve theirs; null = no cap.
    private int? MaxQuantityOf(SaleItem item) => SaleService.GetMaxQuantity(currentSale.Items, item);

    private string CategoryNameOf(Product product) =>
        categories.FirstOrDefault(c => c.Id == product.CategoryId)?.Name ?? "Sin categoría";

    private int QuantityInCart(int productId) =>
        (int)Math.Min(int.MaxValue, currentSale.Items.Where(i => i.ProductId == productId).Sum(i => (long)i.Quantity));

    private void ClearSearch() => nameSearch = string.Empty;

    private void ResetFilters()
    {
        nameSearch = string.Empty;
        categoryFilter = string.Empty;
    }

    private void ShowBlockedReason(string reason) => toast.Show(reason, "warn");

    private void AddToCart(Product product)
    {
        if (!product.IsActive) return;

        var availability = AvailabilityOf(product);
        if (availability.IsBlocked)
        {
            ShowBlockedReason(availability.Reason ?? "Producto no disponible.");
            return;
        }

        var existingItem = currentSale.Items.FirstOrDefault(i => i.ProductId == product.Id);

        if (existingItem != null)
        {
            IncrementQuantity(existingItem);
        }
        else
        {
            stockError = string.Empty;
            currentSale.Items.Add(new SaleItem
            {
                ProductId = product.Id,
                ProductName = product.Name,
                Price = product.Price,
                Quantity = 1
            });
        }
    }

    private void IncrementQuantity(SaleItem item)
    {
        if (!currentSale.Items.Contains(item)) return;
        if (item.Quantity == int.MaxValue)
        {
            RejectQuantityEdit("La cantidad no puede superar el máximo permitido.");
            return;
        }

        ApplyQuantity(item, item.Quantity + 1);
    }

    private void DecrementQuantity(SaleItem item)
    {
        if (!currentSale.Items.Contains(item)) return;
        if (item.Quantity <= 1)
        {
            RemoveFromCart(item);
            return;
        }

        ApplyQuantity(item, item.Quantity - 1);
    }

    private void EditQuantity((SaleItem Item, string? Value) change)
    {
        if (!currentSale.Items.Contains(change.Item)) return;
        if (!int.TryParse(change.Value, out var quantity) || quantity <= 0)
        {
            RejectQuantityEdit("La cantidad debe ser un entero positivo. Se mantuvo la cantidad anterior.");
            return;
        }

        ApplyQuantity(change.Item, quantity);
    }

    private void ApplyQuantity(SaleItem item, int quantity)
    {
        var candidate = CopyLine(item);
        candidate.Quantity = quantity;
        var error = ValidateCartChange(item, candidate, currentSale.DiscountType, currentSale.DiscountValue);
        if (error is not null)
        {
            RejectQuantityEdit(error + RejectedSuffix);
            return;
        }

        item.Quantity = quantity;
        stockError = string.Empty;
    }

    // Un rechazo recrea los editores de cantidad para restaurar el valor visible del modelo.
    private void RejectQuantityEdit(string message)
    {
        quantityEditVersion++;
        toast.Show(message, "warn");
    }

    private static SaleItem CopyLine(SaleItem item) => new()
    {
        ProductId = item.ProductId,
        ProductName = item.ProductName,
        Price = item.Price,
        Quantity = item.Quantity,
        Notes = item.Notes,
        DiscountType = item.DiscountType,
        DiscountValue = item.DiscountValue
    };

    // Valida el carrito candidato sin mutarlo; devuelve el mensaje de error o null.
    private string? ValidateCartChange(SaleItem? original, SaleItem? candidate, DiscountType saleType, decimal saleValue)
    {
        if (candidate != null)
        {
            var max = MaxQuantityOf(candidate);
            if (max.HasValue && candidate.Quantity > max.Value)
                return $"No hay stock suficiente para {candidate.ProductName}: máximo disponible {max.Value} u.";

            var lineValidation = SaleService.ValidateDiscount(candidate.DiscountType,
                candidate.DiscountValue, candidate.GrossSubtotal, $"El descuento de {candidate.ProductName}");
            if (!lineValidation.IsValid)
                return lineValidation.ErrorMessage;
        }

        // La base candidata usa los importes del modelo; no se cambia el carrito para validarla.
        var subtotal = currentSale.Items.Sum(i => i == original ? candidate?.Subtotal ?? 0m : i.Subtotal);
        var saleValidation = SaleService.ValidateDiscount(saleType, saleValue, subtotal, "El descuento de la venta");
        return saleValidation.IsValid ? null : saleValidation.ErrorMessage;
    }

    private string? ApplyLineOptions(SaleItem item, string? notes, DiscountType type, decimal value)
    {
        if (!currentSale.Items.Contains(item)) return "La línea ya no está en el carrito.";

        var candidate = CopyLine(item);
        candidate.DiscountType = type;
        candidate.DiscountValue = value;
        var error = ValidateCartChange(item, candidate, currentSale.DiscountType, currentSale.DiscountValue);
        if (error is not null) return error + RejectedSuffix;

        item.Notes = string.IsNullOrWhiteSpace(notes) ? null : notes.Trim();
        item.DiscountType = type;
        item.DiscountValue = value;
        stockError = string.Empty;
        StateHasChanged(); // el diálogo es quien dispara el evento: el carrito de la página debe redibujarse
        return null;
    }

    private string? ApplySaleDiscount(DiscountType type, decimal value)
    {
        var error = ValidateCartChange(null, null, type, value);
        if (error is not null) return error + RejectedSuffix;

        currentSale.DiscountType = type;
        currentSale.DiscountValue = value;
        stockError = string.Empty;
        StateHasChanged();
        return null;
    }

    private void RemoveFromCart(SaleItem item)
    {
        if (!currentSale.Items.Contains(item)) return;
        var error = ValidateCartChange(item, null, currentSale.DiscountType, currentSale.DiscountValue);
        if (error is not null)
        {
            RejectQuantityEdit(error + RejectedSuffix);
            return;
        }

        currentSale.Items.Remove(item);
        stockError = string.Empty;
    }

    private Task OpenLineOptions(SaleItem item) => lineDialog.ShowAsync(item);

    private Task OpenSaleDiscount() => discountDialog.ShowAsync(currentSale);

    private async Task OpenCheckout()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        if (!currentSale.Items.Any()) return;

        stockError = string.Empty;
        await checkoutDialog.ShowAsync(currentSale);
    }

    private void ClearCart()
    {
        currentSale = new Sale();
        stockError = string.Empty;
    }

    private void ClearCartWithNotice()
    {
        ClearCart();
        toast.Show("Se vació el carrito.");
    }

    // Devuelve el mensaje de error del servicio, o null cuando la venta quedó registrada.
    private string? CompleteSale(List<SalePayment> payments)
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return "La sesión expiró. Iniciá sesión nuevamente.";
        }
        if (!currentSale.Items.Any()) return "La venta debe contener al menos un producto.";

        // Pagos nuevos desde las asignaciones aceptadas por el diálogo, nunca desde texto inválido.
        var checkoutSale = new Sale
        {
            Items = currentSale.Items,
            DiscountType = currentSale.DiscountType,
            DiscountValue = currentSale.DiscountValue,
            Payments = payments
        };

        // Validar descuentos, pago, elegibilidad y stock antes de registrar la venta.
        var (isValid, errorMessage) = SaleService.ValidateSale(checkoutSale);
        if (!isValid)
        {
            stockError = errorMessage;
            StateHasChanged();
            return errorMessage;
        }

        // Venta validada; Add vuelve a validar antes de cualquier mutación.
        try
        {
            SaleService.Add(checkoutSale, AuthService.CurrentUser);
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
            return "La sesión expiró. Iniciá sesión nuevamente.";
        }
        catch (InvalidOperationException ex)
        {
            stockError = ex.Message;
            StateHasChanged();
            return ex.Message;
        }

        OnSaleCompleted(checkoutSale);
        return null;
    }

    // Seam for the post-checkout receipt (S10, T5): runs once, after the sale is stored and before the cart resets.
    private void OnSaleCompleted(Sale sale)
    {
        lastCompletedSale = sale;
        receiptPending = true;
        ClearCart();
        StateHasChanged();
        toast.Show($"Venta #{sale.Id} registrada · {PosFormat.Money(sale.Total)}");
    }

    // S10: the receipt shows the stored sale once the checkout dialog is gone (never over it, never on cancel).
    private async Task HandleCheckoutClosed(string returnValue)
    {
        if (!receiptPending) return;
        receiptPending = false;
        if (returnValue != "confirmed" || lastCompletedSale is null) return;

        receiptFromCheckout = true;
        await receiptDialog.ShowAsync(lastCompletedSale);
    }

    private async Task ShowLastReceipt()
    {
        if (lastCompletedSale is null) return;
        receiptFromCheckout = false;
        await receiptDialog.ShowAsync(lastCompletedSale);
    }

    // Closing the post-checkout receipt (Nueva venta, Esc or ✕) leaves the cart empty and the search ready.
    private async Task HandleReceiptClosed(string returnValue)
    {
        if (!receiptFromCheckout) return;
        receiptFromCheckout = false;
        try { await searchInput.FocusAsync(); }
        catch (JSDisconnectedException) { }
    }

    private void GoToCash()
    {
        Navigation.NavigateTo("/cash");
    }
}
