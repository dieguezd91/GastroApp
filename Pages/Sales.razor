@page "/sales"
@using GastroApp.Models
@using GastroApp.Services
@using System.Globalization
@inject ProductService ProductService
@inject ProductCategoryService CategoryService
@inject SaleService SaleService
@inject CashRegisterService CashService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Vender</PageTitle>

<div class="page-container">
    <h1>💰 Punto de Venta</h1>

    @if (!CashService.IsOpen())
    {
        <div class="alert alert-warning">
            <p>⚠️ La caja está cerrada. Abrí la caja para empezar a vender.</p>
            <button class="btn btn-primary" @onclick="GoToCash">Ir a Caja</button>
        </div>
    }
    else
    {
        <div class="sales-layout">
            <div>
                <h3>Productos</h3>
                <div class="form-group">
                    <label for="sales-category">Filtrar por categoría</label>
                    <select id="sales-category" class="form-control" @bind="categoryFilter">
                        <option value="">Todos</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                        @if (products.Any(p => !p.CategoryId.HasValue))
                        {
                            <option value="uncategorized">Sin categoría</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label for="sales-search">Buscar por nombre</label>
                    <input id="sales-search" type="search" class="form-control"
                           placeholder="Buscar productos..." @bind="nameSearch" @bind:event="oninput" />
                </div>
                <div class="products-grid">
                    @foreach (var product in FilteredProducts)
                    {
                        <button class="product-button" @onclick="() => AddToCart(product)">
                            <div class="product-name">@product.Name</div>
                            <div class="product-price">$@product.Price</div>
                        </button>
                    }
                </div>
                @if (!FilteredProducts.Any())
                {
                    <p class="empty-state">No hay productos para mostrar con este filtro.</p>
                }
            </div>

            <div class="cart-panel">
                <h3>Carrito</h3>

                @if (!string.IsNullOrEmpty(stockError))
                {
                    <div class="alert alert-danger" role="alert">
                        <strong>⚠️ No se pudo completar la venta</strong>
                        <p>@stockError</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(quantityError))
                {
                    <div class="alert alert-danger" role="alert">@quantityError</div>
                }

                <div id="sales-discount-error" role="alert" aria-live="assertive">
                    @if (!string.IsNullOrEmpty(discountError))
                    {
                        <div class="alert alert-danger">@discountError</div>
                    }
                </div>

                @if (currentSale.Items.Any())
                {
                    <div class="cart-items">
                        @foreach (var item in currentSale.Items)
                        {
                            <div class="cart-item d-flex flex-wrap align-items-start gap-2" @key="item">
                                <div class="item-info" style="flex: 1 1 12rem; min-width: 0;">
                                    <strong>@item.ProductName</strong>
                                    <div class="d-flex align-items-center gap-1 flex-wrap">
                                        <button type="button" class="btn btn-secondary btn-sm"
                                                aria-label="@($"Disminuir cantidad de {item.ProductName}")"
                                                @onclick="() => DecrementQuantity(item)">−</button>
                                        <input @key="(item.Quantity, quantityEditVersion)" type="text" inputmode="numeric"
                                               class="form-control" style="width: 5rem;"
                                               aria-label="@($"Cantidad de {item.ProductName}")"
                                               value="@item.Quantity" @onchange="e => EditQuantity(item, e)" />
                                        <button type="button" class="btn btn-secondary btn-sm"
                                                aria-label="@($"Aumentar cantidad de {item.ProductName}")"
                                                @onclick="() => IncrementQuantity(item)">+</button>
                                    </div>
                                    <div class="form-group">
                                        <label for="@($"sale-item-notes-{item.ProductId}")">Observación (opcional)</label>
                                        <input id="@($"sale-item-notes-{item.ProductId}")" type="text" class="form-control"
                                               aria-describedby="@($"sale-item-notes-help-{item.ProductId}")"
                                               @bind:get="item.Notes" @bind:set="value => EditNotes(item, value)" />
                                        <small id="@($"sale-item-notes-help-{item.ProductId}")">Aplica a toda la cantidad de esta línea.</small>
                                    </div>
                                    <div @key="discountEditVersion">
                                        <div class="form-group">
                                            <label for="@($"sale-item-discount-type-{item.ProductId}")">Descuento de línea</label>
                                            <select id="@($"sale-item-discount-type-{item.ProductId}")" class="form-control"
                                                    aria-describedby="sales-discount-help sales-discount-error"
                                                    value="@((int)item.DiscountType)" @onchange="e => EditDiscountType(item, e)">
                                                <option value="0">Sin descuento</option>
                                                <option value="1">Porcentaje (%)</option>
                                                <option value="2">Importe fijo ($ por línea)</option>
                                            </select>
                                        </div>
                                        <div class="form-group">
                                            <label for="@($"sale-item-discount-value-{item.ProductId}")">Valor del descuento de línea (@(item.DiscountType == DiscountType.Percentage ? "%" : "$"))</label>
                                            <input id="@($"sale-item-discount-value-{item.ProductId}")" type="text" inputmode="decimal"
                                                   class="form-control" disabled="@(item.DiscountType == DiscountType.None)"
                                                   aria-describedby="sales-discount-help sales-discount-error"
                                                   value="@item.DiscountValue" @onchange="e => EditDiscountValue(item, e)" />
                                        </div>
                                    </div>
                                    <div class="item-price">
                                        <div>Bruto de línea: $@item.GrossSubtotal</div>
                                        <div>Descuento de línea: $@item.DiscountAmount</div>
                                        <strong>Subtotal final de línea: $@item.Subtotal</strong>
                                    </div>
                                </div>
                                <button class="btn-remove" aria-label="@($"Quitar {item.ProductName}")"
                                        @onclick="() => RemoveFromCart(item)">❌</button>
                            </div>
                        }
                    </div>

                    <p id="sales-discount-help">
                        El importe fijo de línea se descuenta una vez, no por unidad. El descuento de venta se aplica después de los de línea.
                        Usá «@CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator» como separador decimal, sin separador de miles.
                        Cambiar el tipo reinicia el valor a cero.
                    </p>
                    <div @key="discountEditVersion">
                        <div class="form-group">
                            <label for="sale-discount-type">Descuento de toda la venta</label>
                            <select id="sale-discount-type" class="form-control"
                                    aria-describedby="sales-discount-help sales-discount-error"
                                    value="@((int)currentSale.DiscountType)" @onchange="e => EditDiscountType(null, e)">
                                <option value="0">Sin descuento</option>
                                <option value="1">Porcentaje (%)</option>
                                <option value="2">Importe fijo ($)</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="sale-discount-value">Valor del descuento de venta (@(currentSale.DiscountType == DiscountType.Percentage ? "%" : "$"))</label>
                            <input id="sale-discount-value" type="text" inputmode="decimal" class="form-control"
                                   disabled="@(currentSale.DiscountType == DiscountType.None)"
                                   aria-describedby="sales-discount-help sales-discount-error"
                                   value="@currentSale.DiscountValue" @onchange="e => EditDiscountValue(null, e)" />
                        </div>
                    </div>
                    <div class="cart-total">
                        <div>Subtotal tras descuentos de línea: $@currentSale.Subtotal</div>
                        <div>Descuento de venta: $@currentSale.DiscountAmount</div>
                        <h2>Total final: $@currentSale.Total</h2>
                    </div>

                    <button class="btn btn-success btn-large" @onclick="CompleteSale">
                        ✅ Cobrar
                    </button>
                    <button class="btn btn-secondary" @onclick="ClearCart">Limpiar</button>
                }
                else
                {
                    <p class="empty-cart">Carrito vacío</p>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<Product> products = new();
    private List<ProductCategory> categories = new();
    private string categoryFilter = string.Empty;
    private string nameSearch = string.Empty;
    private Sale currentSale = new();
    private string stockError = string.Empty;
    private string quantityError = string.Empty;
    private int quantityEditVersion;
    private string discountError = string.Empty;
    private int discountEditVersion;

    // Los filtros sólo proyectan el catálogo; no modifican productos ni el carrito.
    private IEnumerable<Product> FilteredProducts => products.Where(p =>
        p.IsActive
        && (categoryFilter == string.Empty
            || (categoryFilter == "uncategorized" ? !p.CategoryId.HasValue : p.CategoryId?.ToString() == categoryFilter))
        && p.Name.Contains(nameSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        products = ProductService.GetAll();
        categories = CategoryService.GetAll();
        await Task.CompletedTask;
    }

    private void AddToCart(Product product)
    {
        if (!product.IsActive) return;

        var existingItem = currentSale.Items.FirstOrDefault(i => i.ProductId == product.Id);

        if (existingItem != null)
        {
            IncrementQuantity(existingItem);
        }
        else
        {
            stockError = string.Empty;
            quantityError = string.Empty;
            discountError = string.Empty;
            currentSale.Items.Add(new SaleItem
            {
                ProductId = product.Id,
                ProductName = product.Name,
                Price = product.Price,
                Quantity = 1
            });
        }
    }

    private void IncrementQuantity(SaleItem item)
    {
        if (!currentSale.Items.Contains(item)) return;
        if (item.Quantity == int.MaxValue)
        {
            quantityError = "La cantidad no puede superar el máximo permitido.";
            return;
        }

        var candidate = CopyLine(item);
        candidate.Quantity++;
        if (!CanApplyCartChange(item, candidate, currentSale.DiscountType, currentSale.DiscountValue)) return;

        item.Quantity++;
        stockError = string.Empty;
        quantityError = string.Empty;
    }

    private void DecrementQuantity(SaleItem item)
    {
        if (!currentSale.Items.Contains(item)) return;
        if (item.Quantity <= 1)
        {
            RemoveFromCart(item);
            return;
        }

        var candidate = CopyLine(item);
        candidate.Quantity--;
        if (!CanApplyCartChange(item, candidate, currentSale.DiscountType, currentSale.DiscountValue)) return;

        item.Quantity--;
        stockError = string.Empty;
        quantityError = string.Empty;
    }

    private void EditQuantity(SaleItem item, ChangeEventArgs e)
    {
        if (!currentSale.Items.Contains(item)) return;
        if (!int.TryParse(e.Value?.ToString(), out var quantity) || quantity <= 0)
        {
            quantityError = "La cantidad debe ser un entero positivo. Se mantuvo la cantidad anterior.";
            // Recrear el editor restaura el valor visible aunque el modelo no haya cambiado.
            quantityEditVersion++;
            return;
        }

        var candidate = CopyLine(item);
        candidate.Quantity = quantity;
        if (!CanApplyCartChange(item, candidate, currentSale.DiscountType, currentSale.DiscountValue)) return;

        item.Quantity = quantity;
        stockError = string.Empty;
        quantityError = string.Empty;
    }

    private static SaleItem CopyLine(SaleItem item) => new()
    {
        ProductId = item.ProductId,
        ProductName = item.ProductName,
        Price = item.Price,
        Quantity = item.Quantity,
        Notes = item.Notes,
        DiscountType = item.DiscountType,
        DiscountValue = item.DiscountValue
    };

    private void RejectDiscountEdit(string message)
    {
        discountError = $"{message} Se mantuvo el carrito anterior.";
        // Recrear sólo los editores restaura entradas rechazadas sin tocar notas ni filtros.
        discountEditVersion++;
        quantityEditVersion++;
    }

    private bool CanApplyCartChange(SaleItem? original, SaleItem? candidate,
        DiscountType saleType, decimal saleValue)
    {
        if (candidate != null)
        {
            var lineValidation = GastroApp.Services.SaleService.ValidateDiscount(candidate.DiscountType,
                candidate.DiscountValue, candidate.GrossSubtotal, $"El descuento de {candidate.ProductName}");
            if (!lineValidation.IsValid)
            {
                RejectDiscountEdit(lineValidation.ErrorMessage);
                return false;
            }
        }

        // La base candidata usa los importes del modelo; no se cambia el carrito para validarla.
        var subtotal = currentSale.Items.Sum(i => i == original ? candidate?.Subtotal ?? 0m : i.Subtotal);
        var saleValidation = GastroApp.Services.SaleService.ValidateDiscount(saleType, saleValue,
            subtotal, "El descuento de la venta");
        if (!saleValidation.IsValid)
        {
            RejectDiscountEdit(saleValidation.ErrorMessage);
            return false;
        }

        discountError = string.Empty;
        return true;
    }

    private void EditDiscountType(SaleItem? item, ChangeEventArgs e)
    {
        if (item != null && !currentSale.Items.Contains(item)) return;
        if (!int.TryParse(e.Value?.ToString(), out var type))
        {
            RejectDiscountEdit("El tipo de descuento es inválido.");
            return;
        }

        ApplyDiscountEdit(item, (DiscountType)type, 0m);
    }

    private void EditDiscountValue(SaleItem? item, ChangeEventArgs e)
    {
        if (item != null && !currentSale.Items.Contains(item)) return;
        const NumberStyles styles = NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint
            | NumberStyles.AllowLeadingWhite | NumberStyles.AllowTrailingWhite;
        if (!decimal.TryParse(e.Value?.ToString(), styles, CultureInfo.CurrentCulture, out var value))
        {
            RejectDiscountEdit("El valor del descuento debe ser un número decimal válido, sin separador de miles.");
            return;
        }

        ApplyDiscountEdit(item, item?.DiscountType ?? currentSale.DiscountType, value);
    }

    private void ApplyDiscountEdit(SaleItem? item, DiscountType type, decimal value)
    {
        var candidate = item == null ? null : CopyLine(item);
        if (candidate != null)
        {
            candidate.DiscountType = type;
            candidate.DiscountValue = value;
        }

        if (!CanApplyCartChange(item, candidate,
            item == null ? type : currentSale.DiscountType,
            item == null ? value : currentSale.DiscountValue)) return;

        if (item == null)
        {
            currentSale.DiscountType = type;
            currentSale.DiscountValue = value;
        }
        else
        {
            item.DiscountType = type;
            item.DiscountValue = value;
        }

        discountEditVersion++;
        stockError = string.Empty;
        quantityError = string.Empty;
    }

    private void EditNotes(SaleItem item, string? value)
    {
        if (!currentSale.Items.Contains(item)) return;
        item.Notes = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private void RemoveFromCart(SaleItem item)
    {
        if (!currentSale.Items.Contains(item)) return;
        if (!CanApplyCartChange(item, null, currentSale.DiscountType, currentSale.DiscountValue)) return;

        currentSale.Items.Remove(item);
        stockError = string.Empty;
        quantityError = string.Empty;
    }

    private void ClearCart()
    {
        currentSale = new Sale();
        stockError = string.Empty;
        quantityError = string.Empty;
        discountError = string.Empty;
    }

    private void CompleteSale()
    {
        if (!currentSale.Items.Any()) return;

        // Validar descuentos, elegibilidad y stock antes de registrar la venta.
        var (isValid, errorMessage) = SaleService.ValidateSale(currentSale);

        if (!isValid)
        {
            stockError = errorMessage;
            return;
        }

        // Venta validada; Add vuelve a validar antes de cualquier mutación.
        try
        {
            SaleService.Add(currentSale);
        }
        catch (InvalidOperationException ex)
        {
            stockError = ex.Message;
            return;
        }

        stockError = string.Empty;
        quantityError = string.Empty;
        discountError = string.Empty;
        currentSale = new Sale();
    }

    private void GoToCash()
    {
        Navigation.NavigateTo("/cash");
    }
}
