@page "/invoices"
@using GastroApp.Models
@using GastroApp.Services
@using GastroApp.Shared.Purchasing
@inject InvoiceService InvoiceService
@inject SupplierService SupplierService
@inject IngredientService IngredientService
@inject BusinessSettingsService BusinessSettingsService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Facturas</PageTitle>

@if (AuthService.IsAuthenticated && AuthService.IsInRole(UserRole.Admin))
{
    @if (showForm)
    {
        <InvoiceWorkspace Invoice="editingInvoice" Suppliers="suppliers" Ingredients="activeIngredients"
                          BusinessCondition="BusinessSettingsService.TaxCondition" TypeNotice="@typeNotice"
                          FormError="@invoiceError" BuilderError="@builderError" TaxError="@taxError" CanSave="CanSaveInvoice"
                          SupplierIdChanged="SetSupplier"
                          SelectedIngredientId="selectedIngredientId" SelectedIngredientIdChanged="SelectIngredient"
                          QuantityText="@itemQuantityText" QuantityTextChanged="SetQuantity"
                          Unit="@itemUnit" UnitChanged="SetUnit"
                          PriceText="@itemUnitPriceText" PriceTextChanged="SetUnitPrice"
                          VatRate="itemVatRate" VatRateChanged="SetVatRate"
                          ContainedVatText="@containedVatText" ContainedVatTextChanged="SetContainedVat"
                          TaxKind="taxKind" TaxKindChanged="SetTaxKind"
                          TaxDetail="@taxDetail" TaxDetailChanged="SetTaxDetail"
                          TaxAmountText="@taxAmountText" TaxAmountTextChanged="SetTaxAmount"
                          OnAdd="AddItem" OnRemove="RemoveItem" OnAddTax="AddTax" OnRemoveTax="RemoveTax"
                          OnSave="SaveInvoice" OnCancel="CancelEdit" />
    }
    else
    {
        <PurchasingView @ref="purchasingView" ActiveTab="PurchasingTab.Invoices" InvoiceCount="invoices.Count" SupplierCount="suppliers.Count">
            <HeaderActions>
                <button type="button" class="btn btn--primary" @onclick="ShowAddForm">
                    <Icon Name="plus" Size="17" />
                    <span>Nueva factura</span>
                </button>
            </HeaderActions>
            <ChildContent>
                <InvoiceList Invoices="invoices" Suppliers="suppliers" OnNew="ShowAddForm" OnDelete="ConfirmDelete" />
            </ChildContent>
        </PurchasingView>
    }

    <ModalDialog @ref="deleteDialog" Title="@($"¿Eliminar {InvoiceLabel(pendingDelete)}?")" Size="md" OnClosed="HandleDeleteClosed">
        <ChildContent>
            <p>Eliminar una factura no revierte el stock ya ingresado ni sus movimientos de inventario. El último precio de cada ingrediente vuelve al de la factura anterior.</p>
        </ChildContent>
        <Footer>
            <button value="cancel" class="btn" autofocus>Cancelar</button>
            <button type="button" class="btn btn--danger" @onclick="() => DeleteInvoice(pendingDelete?.Id ?? 0)">Eliminar factura</button>
        </Footer>
    </ModalDialog>

    <Toast @ref="toast" />
}

@code {
    private const decimal DefaultVatRate = 21m;
    private const InvoiceTaxKind DefaultTaxKind = InvoiceTaxKind.PercepcionIibb;

    private List<Invoice> invoices = new();
    private List<Supplier> suppliers = new();
    private List<Ingredient> activeIngredients = new();
    private Invoice editingInvoice = new();
    private Invoice? pendingDelete;
    private bool showForm = false;
    private string? invoiceError;
    private string? builderError;
    private string? taxError;
    private string? typeNotice;

    // Para agregar items
    private int selectedIngredientId = 0;
    private string itemQuantityText = string.Empty;
    private string itemUnit = string.Empty;
    private string itemUnitPriceText = string.Empty;
    private decimal itemVatRate = DefaultVatRate; // Factura A only: the rate of the next line

    // Factura B: informative IVA contenido, parsed when saving
    private string containedVatText = string.Empty;

    // Other taxes: the row being composed
    private InvoiceTaxKind taxKind = DefaultTaxKind;
    private string taxDetail = string.Empty;
    private string taxAmountText = string.Empty;

    private PurchasingView? purchasingView;
    private ModalDialog? deleteDialog;
    private Toast? toast;
    private bool focusListHeading;

    protected override async Task OnInitializedAsync()
    {
        if (!EnsureAdmin()) return;

        LoadData();
        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Back from the workspace: put focus on the list heading, like the prototype.
        if (!focusListHeading || showForm || purchasingView is null) return;
        focusListHeading = false;
        await purchasingView.FocusHeadingAsync();
    }

    private bool EnsureAdmin()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return false;
        }
        if (!AuthService.IsInRole(UserRole.Admin))
        {
            Navigation.NavigateTo("/unauthorized");
            return false;
        }
        return true;
    }

    private void LoadData()
    {
        invoices = InvoiceService.GetAll();
        suppliers = SupplierService.GetAll();
        activeIngredients = IngredientService.GetActive();
    }

    private static string InvoiceLabel(Invoice? invoice) =>
        invoice == null ? "la factura"
        : string.IsNullOrEmpty(invoice.InvoiceNumber) ? $"la factura #{invoice.Id}" : $"la factura {invoice.InvoiceNumber}";

    private void ShowAddForm()
    {
        if (!EnsureAdmin()) return;
        LoadData();
        invoiceError = null;
        builderError = null;
        taxError = null;
        typeNotice = null;
        ResetPicker();
        ResetTaxInputs();
        containedVatText = string.Empty;
        editingInvoice = new Invoice { Date = DateTime.Now };
        showForm = true;
    }

    private void ResetPicker()
    {
        selectedIngredientId = 0;
        itemQuantityText = string.Empty;
        itemUnit = string.Empty;
        itemUnitPriceText = string.Empty;
        itemVatRate = DefaultVatRate;
    }

    private void ResetTaxInputs()
    {
        taxKind = DefaultTaxKind;
        taxDetail = string.Empty;
        taxAmountText = string.Empty;
    }

    // The type is derived from the business and the supplier (S3), never chosen. Null when it cannot be derived yet.
    private InvoiceType? DerivedType(int supplierId)
    {
        var business = BusinessSettingsService.TaxCondition;
        var supplier = SupplierService.GetById(supplierId);
        if (business == null || supplier == null || !supplier.HasFiscalData) return null;
        return FiscalRules.ExpectedInvoiceType(supplier.TaxCondition!.Value, business.Value);
    }

    private string TypeUnavailableMessage() =>
        BusinessSettingsService.TaxCondition == null ? "Configurá la condición frente al IVA del negocio en Datos fiscales antes de registrar facturas."
        : editingInvoice.SupplierId <= 0 ? "Seleccioná un proveedor antes de agregar ítems."
        : "Completá el CUIT y la condición frente al IVA del proveedor antes de registrar la factura.";

    private void SetSupplier(int supplierId)
    {
        if (!EnsureAdmin()) return;
        editingInvoice.SupplierId = supplierId;
        var newType = DerivedType(supplierId);
        var typeChanged = editingInvoice.Type != newType;
        editingInvoice.Type = newType;
        typeNotice = null;
        if (!typeChanged) return;

        // What was typed under the previous type (net or final prices, rates, IVA contenido, perceptions) no longer applies.
        var hadData = editingInvoice.Items.Count > 0 || editingInvoice.OtherTaxes.Count > 0
            || editingInvoice.ContainedVat.HasValue || !string.IsNullOrWhiteSpace(containedVatText);
        editingInvoice.Items.Clear();
        editingInvoice.OtherTaxes.Clear();
        editingInvoice.ContainedVat = null;
        editingInvoice.Legend = InvoiceLegend.None;
        containedVatText = string.Empty;
        ResetTaxInputs();
        builderError = null;
        taxError = null;
        invoiceError = null;
        if (hadData) typeNotice = "Se quitaron los ítems porque cambió el tipo de factura.";
    }

    private void SelectIngredient(int ingredientId)
    {
        if (!EnsureAdmin()) return;
        selectedIngredientId = ingredientId;
        var ingredient = ingredientId == 0 ? null : IngredientService.GetById(ingredientId);
        // Poka-yoke: the unit always restarts from the ingredient's own unit, the only choices being its compatible units.
        itemUnit = ingredient?.Unit ?? string.Empty;
        builderError = null;
    }

    private void SetQuantity(string? text)
    {
        if (!EnsureAdmin()) return;
        itemQuantityText = text ?? string.Empty;
    }

    private void SetUnitPrice(string? text)
    {
        if (!EnsureAdmin()) return;
        itemUnitPriceText = text ?? string.Empty;
    }

    private void SetUnit(string unit)
    {
        if (!EnsureAdmin()) return;
        var ingredient = selectedIngredientId == 0 ? null : IngredientService.GetById(selectedIngredientId);
        if (ingredient == null || !PurchasingFormat.UnitOptions(ingredient.Unit).Contains(unit)) return;
        itemUnit = unit;
    }

    private void SetVatRate(decimal rate)
    {
        if (!EnsureAdmin()) return;
        // Poka-yoke: only the rates of FiscalRules.VatRates can be chosen.
        if (!FiscalRules.VatRates.Contains(rate)) return;
        itemVatRate = rate;
    }

    private void SetContainedVat(string? text)
    {
        if (!EnsureAdmin()) return;
        containedVatText = text ?? string.Empty;
    }

    private void SetTaxKind(InvoiceTaxKind kind)
    {
        if (!EnsureAdmin()) return;
        if (!Enum.IsDefined(kind)) return;
        taxKind = kind;
        taxError = null;
    }

    private void SetTaxDetail(string? text)
    {
        if (!EnsureAdmin()) return;
        taxDetail = text ?? string.Empty;
    }

    private void SetTaxAmount(string? text)
    {
        if (!EnsureAdmin()) return;
        taxAmountText = text ?? string.Empty;
    }

    private void AddItem()
    {
        if (!EnsureAdmin()) return;
        if (selectedIngredientId == 0)
        {
            builderError = "Seleccioná un ingrediente.";
            return;
        }
        if (!PurchasingFormat.TryParseDecimal(itemQuantityText, out var quantity) || quantity <= 0)
        {
            builderError = "Ingresá una cantidad mayor a cero antes de agregar el ítem.";
            return;
        }
        if (!PurchasingFormat.TryParseDecimal(itemUnitPriceText, out var unitPrice) || unitPrice <= 0)
        {
            builderError = "Ingresá un precio unitario mayor a cero.";
            return;
        }

        var ingredient = IngredientService.GetById(selectedIngredientId);
        if (ingredient == null)
        {
            builderError = "El ingrediente seleccionado ya no existe.";
            return;
        }

        // The control only offers compatible units; this keeps the rule even if a stale unit slips through.
        var item = PurchasingFormat.BuildItem(ingredient, quantity, itemUnit, unitPrice);
        if (item == null)
        {
            builderError = $"La unidad {itemUnit} no es compatible con {ingredient.Name} ({ingredient.Unit}).";
            return;
        }

        // The price means net or final depending on the type, so no line is taken before the type is known.
        editingInvoice.Type ??= DerivedType(editingInvoice.SupplierId);
        if (editingInvoice.Type == null)
        {
            builderError = TypeUnavailableMessage();
            return;
        }
        if (editingInvoice.Type == InvoiceType.A)
        {
            if (!FiscalRules.VatRates.Contains(itemVatRate))
            {
                builderError = "Elegí una alícuota de IVA válida.";
                return;
            }
            item.VatRate = itemVatRate;
        }

        editingInvoice.Items.Add(item);

        // Reset
        builderError = null;
        invoiceError = null;
        ResetPicker();
    }

    private void RemoveItem(InvoiceItem item)
    {
        if (!EnsureAdmin()) return;
        editingInvoice.Items.Remove(item);
        builderError = null;
    }

    private void AddTax()
    {
        if (!EnsureAdmin()) return;
        if (!PurchasingFormat.TryParseDecimal(taxAmountText, out var amount) || amount <= 0)
        {
            taxError = "Ingresá un importe mayor a cero.";
            return;
        }
        // The jurisdiction / description is validated by the service when saving.
        if (taxKind == InvoiceTaxKind.PercepcionIva && editingInvoice.Type != InvoiceType.A)
        {
            taxError = "La percepción de IVA solo corresponde a facturas A.";
            return;
        }

        editingInvoice.OtherTaxes.Add(new InvoiceTax { Kind = taxKind, Detail = taxDetail, Amount = amount });
        taxError = null;
        invoiceError = null;
        taxDetail = string.Empty;
        taxAmountText = string.Empty;
    }

    private void RemoveTax(InvoiceTax tax)
    {
        if (!EnsureAdmin()) return;
        editingInvoice.OtherTaxes.Remove(tax);
        taxError = null;
    }

    // Save rule, evaluated on every render: the business condition must be set and a supplier with fiscal data chosen.
    // Everything else (type, rates, taxes) is validated by the service and surfaces in the form error.
    private bool CanSaveInvoice()
    {
        if (BusinessSettingsService.TaxCondition == null) return false;
        if (editingInvoice.SupplierId <= 0 || !editingInvoice.Items.Any()) return false;
        var supplier = SupplierService.GetById(editingInvoice.SupplierId);
        return supplier == null || supplier.HasFiscalData;
    }

    // Factura B only: a blank field means no IVA contenido; anything that is not a number stays in the form.
    private bool ApplyContainedVat()
    {
        if (editingInvoice.Type != InvoiceType.B) return true;
        if (string.IsNullOrWhiteSpace(containedVatText))
        {
            editingInvoice.ContainedVat = null;
            return true;
        }
        if (!PurchasingFormat.TryParseDecimal(containedVatText, out var containedVat))
        {
            invoiceError = "Ingresá un IVA contenido válido.";
            return false;
        }
        editingInvoice.ContainedVat = containedVat;
        return true;
    }

    private void SaveInvoice()
    {
        if (!EnsureAdmin()) return;
        if (!CanSaveInvoice())
            return;
        if (!ApplyContainedVat())
            return;

        var itemCount = editingInvoice.Items.Count;
        try
        {
            InvoiceService.Add(editingInvoice, AuthService.CurrentUser);
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            if (EnsureAdmin()) invoiceError = ex.Message;
            return;
        }
        LoadData();
        CancelEdit();
        toast?.Show($"Factura registrada con {itemCount} ítem(s): stock y costos actualizados.");
    }

    private async Task ConfirmDelete(Invoice invoice)
    {
        if (!EnsureAdmin()) return;
        pendingDelete = invoice;
        if (deleteDialog is not null) await deleteDialog.ShowAsync();
    }

    private async Task DeleteInvoice(int id)
    {
        if (!EnsureAdmin()) return;
        var existing = InvoiceService.GetById(id);
        InvoiceService.Delete(id);
        LoadData();
        if (deleteDialog is not null) await deleteDialog.CloseAsync("deleted");
        if (existing is not null) toast?.Show($"Se eliminó {InvoiceLabel(existing)}.", "warn");
    }

    private void HandleDeleteClosed(string _) => pendingDelete = null;

    private void CancelEdit()
    {
        showForm = false;
        focusListHeading = true;
        invoiceError = null;
        builderError = null;
        taxError = null;
        typeNotice = null;
        containedVatText = string.Empty;
        editingInvoice = new Invoice();
        ResetPicker();
        ResetTaxInputs();
    }
}
