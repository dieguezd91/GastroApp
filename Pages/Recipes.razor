@page "/recipes"
@using GastroApp.Models
@using GastroApp.Services
@inject RecipeService RecipeService
@inject IngredientService IngredientService
@inject DataStorageService DataStorage
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Recetas</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>📖 Recetas Estandarizadas</h1>
        <button class="btn btn-primary" @onclick="ShowAddForm">+ Nueva Receta</button>
    </div>

    @if (showForm)
    {
        <div class="form-card">
            <h3>@(editingRecipe.Id == 0 ? "Nueva Receta" : "Editar Receta")</h3>

            <div class="form-group">
                <label>Nombre de la Receta</label>
                <input type="text" @bind="editingRecipe.Name" class="form-control" placeholder="Ej: Pizza Margarita" />
            </div>

            <div class="form-group">
                <label>Rendimiento (porciones/pax)</label>
                <input type="number" @bind="editingRecipe.Yield" class="form-control" placeholder="1" min="1" />
            </div>

            <hr />

            <h4>Ingredientes de la Receta</h4>

            <div class="recipe-ingredients">
                <div class="form-group">
                    <label>Ingrediente</label>
                    <select @bind="selectedIngredientId" class="form-control">
                        <option value="0">Seleccionar...</option>
                        @foreach (var ingredient in activeIngredients)
                        {
                            var lastPrice = IngredientService.GetLastPrice(ingredient.Id);
                            var priceInfo = lastPrice.HasValue ? $"- ${lastPrice.Value}/{ingredient.Unit}" : "- Sin precio";
                            <option value="@ingredient.Id">@ingredient.Name (@ingredient.Unit) @priceInfo</option>
                        }
                    </select>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Cantidad</label>
                        <input type="number" @bind="ingredientQuantity" class="form-control" placeholder="0" step="0.01" />
                    </div>

                    <div class="form-group">
                        <button class="btn btn-secondary" @onclick="AddIngredient" style="margin-top: 1.75rem;">+ Agregar</button>
                    </div>
                </div>

                @if (editingRecipe.Ingredients.Any())
                {
                    <div class="items-list">
                        <h5>Ingredientes agregados:</h5>
                        @foreach (var item in editingRecipe.Ingredients)
                        {
                            var ingredientInfo = DataStorage.Ingredients.FirstOrDefault(i => i.Id == item.IngredientId);
                            var isCompatible = ingredientInfo != null && UnitConverter.AreCompatible(item.Unit, ingredientInfo.Unit);

                            <div class="recipe-ingredient-item">
                                <span><strong>@item.IngredientName</strong></span>
                                <span>@item.Quantity @item.Unit</span>
                                @if (!isCompatible)
                                {
                                    <span class="unit-warning">⚠️ Unidad incompatible</span>
                                }
                                else if (item.UnitPrice > 0)
                                {
                                    <span>$@item.UnitPrice/@item.Unit = $@item.Subtotal</span>
                                }
                                else
                                {
                                    <span class="no-price">⚠️ Sin precio</span>
                                }
                                <button class="btn-remove" @onclick="() => RemoveIngredient(item)">❌</button>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (editingRecipe.Ingredients.Any())
            {
                <div class="recipe-cost-preview">
                    <div class="cost-item">
                        <span>Costo Total:</span>
                        <strong>$@previewTotalCost.ToString("F2")</strong>
                    </div>
                    <div class="cost-item">
                        <span>Costo por Porción:</span>
                        <strong>$@previewUnitCost.ToString("F2")</strong>
                    </div>
                </div>
            }

            <div class="form-actions">
                <button class="btn btn-success" @onclick="SaveRecipe" disabled="@(!CanSaveRecipe())">Guardar Receta</button>
                <button class="btn btn-secondary" @onclick="CancelEdit">Cancelar</button>
            </div>
        </div>
    }

    <div class="products-list">
        @foreach (var recipe in recipes)
        {
            var indicatorEmoji = recipe.CostIndicator switch
            {
                "green" => "🟢",
                "yellow" => "🟡",
                "red" => "🔴",
                _ => "⚪"
            };

            <div class="product-card">
                <div class="product-info">
                    <h3>@indicatorEmoji @recipe.Name</h3>
                    <p class="cost">👨‍🍳 Rinde: @recipe.Yield porciones</p>
                    <p class="cost">🥘 @recipe.Ingredients.Count ingrediente(s)</p>
                    <p class="price">Costo total: $@recipe.TotalCost.ToString("F2")</p>
                    <p class="price">Costo x porción: $@recipe.UnitCost.ToString("F2")</p>

                    @if (recipe.Ingredients.Any())
                    {
                        <details class="recipe-details">
                            <summary>Ver ingredientes</summary>
                            <ul>
                                @foreach (var ing in recipe.Ingredients)
                                {
                                    <li>@ing.IngredientName: @ing.Quantity @ing.Unit</li>
                                }
                            </ul>
                        </details>
                    }
                </div>
                <div class="product-actions">
                    <button class="btn btn-small" @onclick="() => EditRecipe(recipe)">✏️</button>
                    <button class="btn btn-small" @onclick="() => RecalculateCost(recipe.Id)" title="Recalcular costo">🔄</button>
                    <button class="btn btn-small btn-danger" @onclick="() => DeleteRecipe(recipe.Id)">🗑️</button>
                </div>
            </div>
        }
    </div>

    @if (recipes.Count == 0)
    {
        <p class="empty-state">No hay recetas. Creá la primera!</p>
    }
</div>

<style>
    .form-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1rem;
        align-items: end;
    }

    .recipe-ingredients {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 4px;
        margin: 1rem 0;
    }

    .items-list {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 2px solid #dee2e6;
    }

    .recipe-ingredient-item {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr auto;
        gap: 1rem;
        align-items: center;
        background: white;
        padding: 0.75rem;
        border-radius: 4px;
        margin-bottom: 0.5rem;
    }

    .no-price {
        color: #ffc107;
        font-size: 0.9rem;
    }

    .unit-warning {
        color: #dc3545;
        font-size: 0.9rem;
        font-weight: bold;
    }

    .recipe-cost-preview {
        background: #e7f3ff;
        border: 2px solid #1b6ec2;
        border-radius: 8px;
        padding: 1rem;
        margin: 1rem 0;
    }

    .cost-item {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        font-size: 1.1rem;
    }

    .recipe-details {
        margin-top: 0.5rem;
        padding: 0.5rem;
        background: #f8f9fa;
        border-radius: 4px;
    }

    .recipe-details summary {
        cursor: pointer;
        font-weight: bold;
        color: #1b6ec2;
    }

    .recipe-details ul {
        margin: 0.5rem 0 0 1rem;
        padding: 0;
    }

    .recipe-details li {
        margin: 0.25rem 0;
    }

    .btn-remove {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1rem;
    }
</style>

@code {
    private List<Recipe> recipes = new();
    private List<Ingredient> activeIngredients = new();
    private Recipe editingRecipe = new();
    private bool showForm = false;

    // Para agregar ingredientes
    private int selectedIngredientId = 0;
    private decimal ingredientQuantity = 0;

    // Preview de costos
    private decimal previewTotalCost = 0;
    private decimal previewUnitCost = 0;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        if (!AuthService.IsInRole(UserRole.Admin))
        {
            Navigation.NavigateTo("/unauthorized", true);
            return;
        }

        LoadData();
        await Task.CompletedTask;
    }

    private void LoadData()
    {
        recipes = RecipeService.GetAll();
        activeIngredients = IngredientService.GetActive();
    }

    private void ShowAddForm()
    {
        editingRecipe = new Recipe { Yield = 1 };
        showForm = true;
        UpdatePreview();
    }

    private void AddIngredient()
    {
        if (selectedIngredientId == 0 || ingredientQuantity <= 0)
            return;

        var ingredient = IngredientService.GetById(selectedIngredientId);
        if (ingredient == null)
            return;

        var lastPrice = IngredientService.GetLastPrice(ingredient.Id) ?? 0;

        editingRecipe.Ingredients.Add(new RecipeIngredient
        {
            IngredientId = ingredient.Id,
            IngredientName = ingredient.Name,
            Quantity = ingredientQuantity,
            Unit = ingredient.Unit,
            UnitPrice = lastPrice,
            Subtotal = ingredientQuantity * lastPrice
        });

        // Reset
        selectedIngredientId = 0;
        ingredientQuantity = 0;

        UpdatePreview();
    }

    private void RemoveIngredient(RecipeIngredient item)
    {
        editingRecipe.Ingredients.Remove(item);
        UpdatePreview();
    }

    private void UpdatePreview()
    {
        decimal total = 0;

        foreach (var item in editingRecipe.Ingredients)
        {
            var ingredientInfo = DataStorage.Ingredients.FirstOrDefault(i => i.Id == item.IngredientId);
            if (ingredientInfo != null && UnitConverter.AreCompatible(item.Unit, ingredientInfo.Unit))
            {
                // Convertir cantidad a unidad base del ingrediente
                var convertedQty = UnitConverter.Convert(item.Quantity, item.Unit, ingredientInfo.Unit);
                if (convertedQty.HasValue && item.UnitPrice > 0)
                {
                    total += convertedQty.Value * item.UnitPrice;
                }
            }
            else
            {
                // Sin conversión o incompatible: usar subtotal original
                total += item.Subtotal;
            }
        }

        previewTotalCost = total;
        previewUnitCost = editingRecipe.Yield > 0 ? total / editingRecipe.Yield : 0;
    }

    private bool CanSaveRecipe()
    {
        return !string.IsNullOrWhiteSpace(editingRecipe.Name)
            && editingRecipe.Yield > 0
            && editingRecipe.Ingredients.Any();
    }

    private void SaveRecipe()
    {
        if (!CanSaveRecipe())
            return;

        if (editingRecipe.Id == 0)
        {
            RecipeService.Add(editingRecipe);
        }
        else
        {
            RecipeService.Update(editingRecipe);
        }

        LoadData();
        CancelEdit();
    }

    private void EditRecipe(Recipe recipe)
    {
        // Crear copia profunda para editar
        editingRecipe = new Recipe
        {
            Id = recipe.Id,
            Name = recipe.Name,
            Yield = recipe.Yield,
            Ingredients = recipe.Ingredients.Select(i => new RecipeIngredient
            {
                IngredientId = i.IngredientId,
                IngredientName = i.IngredientName,
                Quantity = i.Quantity,
                Unit = i.Unit,
                UnitPrice = i.UnitPrice,
                Subtotal = i.Subtotal
            }).ToList()
        };

        showForm = true;
        UpdatePreview();
    }

    private void RecalculateCost(int recipeId)
    {
        var recipe = RecipeService.GetById(recipeId);
        if (recipe != null)
        {
            RecipeService.CalculateCosts(recipe);
            RecipeService.Update(recipe);
            LoadData();
        }
    }

    private void DeleteRecipe(int id)
    {
        RecipeService.Delete(id);
        LoadData();
    }

    private void CancelEdit()
    {
        showForm = false;
        editingRecipe = new Recipe();
        selectedIngredientId = 0;
        ingredientQuantity = 0;
        previewTotalCost = 0;
        previewUnitCost = 0;
    }
}
