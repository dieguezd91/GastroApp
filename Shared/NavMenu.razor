@using GastroApp.Services
@using GastroApp.Models
@implements IDisposable
@inject AuthService AuthService
@inject NavigationManager Navigation

@* Role-grouped navigation (docs: prototypes/ui-ux/docs/NAVIGATION_MAP.md). Rendered twice by MainLayout:
   in the persistent sidebar (>= 72rem) and inside the <dialog> drawer below it.
   Reportes and Configuración are intentionally absent (proposals, not implemented). *@
@if (AuthService.IsAuthenticated)
{
    <div class="nav-group">
        <p class="nav-group__title">Operación diaria</p>
        <ul class="nav-list">
            <li>
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="nav-link__main"><Icon Name="dashboard" /><span>@(AuthService.IsInRole(UserRole.Admin) ? "Panel operativo" : "Inicio")</span></span>
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="sales" Match="NavLinkMatch.All">
                    <span class="nav-link__main"><Icon Name="pos" /><span>Vender (POS)</span></span>
                </NavLink>
            </li>
        </ul>
    </div>

    @if (AuthService.IsInRole(UserRole.Admin))
    {
        <div class="nav-group">
            <p class="nav-group__title">Caja y ventas</p>
            <ul class="nav-list">
                <li>
                    <NavLink class="nav-link" href="cash" Match="NavLinkMatch.All">
                        <span class="nav-link__main"><Icon Name="cash" /><span>Caja diaria</span></span>
                    </NavLink>
                </li>
                <li>
                    <NavLink class="nav-link" href="cash/history">
                        <span class="nav-link__main"><Icon Name="history" /><span>Historial de cajas</span></span>
                    </NavLink>
                </li>
                <li>
                    <NavLink class="nav-link" href="sales/history">
                        <span class="nav-link__main"><Icon Name="receipt" /><span>Historial de ventas</span></span>
                    </NavLink>
                </li>
                <li>
                    <NavLink class="nav-link" href="summary">
                        <span class="nav-link__main"><Icon Name="summary" /><span>Resumen del día</span></span>
                    </NavLink>
                </li>
            </ul>
        </div>

        <div class="nav-group">
            <p class="nav-group__title">Catálogo e inventario</p>
            <ul class="nav-list">
                <li>
                    <SectionNavLink class="nav-link" href="products" AlsoMatch="@CatalogRoutes">
                        <span class="nav-link__main"><Icon Name="products" /><span>Productos y categorías</span></span>
                    </SectionNavLink>
                </li>
                <li>
                    <SectionNavLink class="nav-link" href="ingredients" AlsoMatch="@InventoryRoutes">
                        <span class="nav-link__main"><Icon Name="ingredients" /><span>Ingredientes y stock</span></span>
                    </SectionNavLink>
                </li>
                <li>
                    <NavLink class="nav-link" href="recipes">
                        <span class="nav-link__main"><Icon Name="recipes" /><span>Recetas y costos</span></span>
                    </NavLink>
                </li>
                <li>
                    <SectionNavLink class="nav-link" href="invoices" AlsoMatch="@PurchasingRoutes">
                        <span class="nav-link__main"><Icon Name="suppliers" /><span>Proveedores y facturas</span></span>
                    </SectionNavLink>
                </li>
            </ul>
        </div>
    }

    <div class="sidebar__footer">
        @if (AuthService.IsInRole(UserRole.Admin))
        {
            <div class="sidebar__admin-zone">
                <NavLink class="nav-link nav-link--danger" href="settings/reset">
                    <span class="nav-link__main"><Icon Name="alertTriangle" /><span>Reiniciar datos</span></span>
                </NavLink>
            </div>
        }
        <div class="user-pill">
            <span class="user-pill__avatar" aria-hidden="true">@Initials</span>
            <span class="user-pill__meta">
                <span class="user-pill__name">@AuthService.CurrentUser?.Username</span>
                <span class="user-pill__role">@(AuthService.IsInRole(UserRole.Admin) ? "Administrador" : "Empleado")</span>
            </span>
        </div>
        <button type="button" class="nav-link" @onclick="HandleLogout">
            <span class="nav-link__main"><Icon Name="logout" /><span>Cerrar sesión</span></span>
        </button>
    </div>
}

@code {
    // Tab sub-routes that belong to a sidebar entry (S5).
    private static readonly string[] CatalogRoutes = ["product-categories"];
    private static readonly string[] InventoryRoutes = ["stock/count"];
    private static readonly string[] PurchasingRoutes = ["suppliers"];

    private bool disposed;

    private string Initials
    {
        get
        {
            var name = AuthService.CurrentUser?.Username?.Trim();
            if (string.IsNullOrEmpty(name)) return "US";
            return name.Length == 1 ? name.ToUpperInvariant() : name[..2].ToUpperInvariant();
        }
    }

    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += HandleAuthStateChanged;
    }

    private void HandleAuthStateChanged()
    {
        if (!disposed) _ = InvokeAsync(() => { if (!disposed) StateHasChanged(); });
    }

    public void Dispose()
    {
        disposed = true;
        AuthService.OnAuthStateChanged -= HandleAuthStateChanged;
    }

    private void HandleLogout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login");
    }
}
