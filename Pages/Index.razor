@page "/"
@using GastroApp.Services
@inject CashRegisterService CashService
@inject SaleService SaleService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Dashboard - GastroApp</PageTitle>

<div class="dashboard">
    <!-- Estado de Caja y Acción Principal -->
    <div class="dashboard-header">
        @if (cashRegister != null && cashRegister.IsOpen)
        {
            <div class="cash-status open">
                <div class="status-indicator">
                    <span class="status-dot"></span>
                    <h2>Caja Abierta</h2>
                </div>
                <div class="cash-metrics">
                    <div class="metric">
                        <span class="metric-label">Inicio</span>
                        <span class="metric-value">@cashRegister.OpenDate.ToString("HH:mm")</span>
                    </div>
                    <div class="metric">
                        <span class="metric-label">Inicial</span>
                        <span class="metric-value">$@cashRegister.InitialAmount</span>
                    </div>
                    <div class="metric highlight">
                        <span class="metric-label">Ventas Hoy</span>
                        <span class="metric-value">$@SaleService.GetTodayTotal()</span>
                    </div>
                </div>
            </div>
            <a href="/sales" class="btn-action-primary">
                <span class="btn-icon">💰</span>
                <span class="btn-text">VENDER</span>
            </a>
        }
        else
        {
            <div class="cash-status closed">
                <div class="status-indicator">
                    <span class="status-dot"></span>
                    <h2>Caja Cerrada</h2>
                </div>
                <p class="status-message">Abrí la caja para comenzar</p>
            </div>
            @if (AuthService.IsInRole(Models.UserRole.Admin))
            {
                <a href="/cash" class="btn-action-secondary">
                    <span class="btn-icon">🔓</span>
                    <span class="btn-text">Abrir Caja</span>
                </a>
            }
        }
    </div>

    <!-- Accesos Rápidos -->
    @if (AuthService.IsInRole(Models.UserRole.Admin))
    {
        <div class="quick-access">
            <h3 class="section-title">Accesos Rápidos</h3>
            <div class="quick-grid">
                <a href="/products" class="quick-card">
                    <span class="quick-icon">📦</span>
                    <span>Productos</span>
                </a>
                <a href="/recipes" class="quick-card">
                    <span class="quick-icon">📖</span>
                    <span>Recetas</span>
                </a>
                <a href="/cash" class="quick-card">
                    <span class="quick-icon">💵</span>
                    <span>Caja</span>
                </a>
                <a href="/summary" class="quick-card">
                    <span class="quick-icon">📊</span>
                    <span>Resumen</span>
                </a>
            </div>
        </div>
    }
</div>

@code {
    private Models.CashRegister? cashRegister;
    private bool isOpen => cashRegister?.IsOpen ?? false;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        cashRegister = CashService.GetCurrent();
        await Task.CompletedTask;
    }
}
