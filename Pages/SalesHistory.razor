@page "/sales/history"
@page "/sales/history/{SaleId:int}"
@using GastroApp.Models
@using GastroApp.Services
@inject SaleHistoryService HistoryService
@inject SaleService SaleService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Historial de ventas</PageTitle>

<div class="page-container">
    <h1>🧾 Historial de ventas</h1>
    <p>Consulta de ventas registradas. Las ventas nunca se eliminan: desde su detalle pueden anularse (venta cobrada sin devoluciones) o devolverse total o parcialmente, siempre con motivo y confirmación.</p>

    @if (SaleId.HasValue)
    {
        <div class="form-card history-detail" role="region" aria-label="Detalle de venta">
            @if (detail == null)
            {
                <h3>Venta #@SaleId</h3>
                <p role="alert">@(detailMessage ?? "No se pudo cargar la venta.")</p>
            }
            else
            {
                var entry = detail.Entry;
                <h3>Venta #@entry.Id — @StatusLabel(entry.DisplayStatus)</h3>

                <h4>Información general</h4>
                <div class="cash-info">
                    <div class="info-card">
                        <h4>Fecha</h4>
                        <p>@entry.Date.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <div class="info-card">
                        <h4>Operador</h4>
                        <p>@OperatorLabel(entry)</p>
                    </div>
                    <div class="info-card">
                        <h4>Caja</h4>
                        <p>
                            @if (entry.CashRegisterId.HasValue)
                            {
                                <a href="/cash/history/@entry.CashRegisterId">Caja #@entry.CashRegisterId</a>
                            }
                            else
                            {
                                @:Sin caja asociada
                            }
                        </p>
                    </div>
                    <div class="info-card">
                        <h4>Estado</h4>
                        <p>@StatusLabel(entry.DisplayStatus)</p>
                    </div>
                    <div class="info-card">
                        <h4>Total</h4>
                        <p class="amount">@Money(detail.Total)</p>
                    </div>
                    <div class="info-card">
                        <h4>Devuelto</h4>
                        <p class="amount">@Money(entry.RefundedTotal)</p>
                    </div>
                </div>
                @if (entry.AmountsUnavailable)
                {
                    <p role="alert">Algunos importes no están disponibles porque superan el límite de cálculo; no se muestran cifras aproximadas.</p>
                }

                <h4>Productos</h4>
                @if (detail.Lines.Count == 0)
                {
                    <p>La venta no tiene productos registrados.</p>
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <table class="table">
                            <thead>
                                <tr><th>Producto</th><th>Precio</th><th>Cantidad</th><th>Observaciones</th><th>Descuento de línea</th><th>Subtotal</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var line in detail.Lines)
                                {
                                    <tr>
                                        <td>@line.ProductName</td>
                                        <td>$@line.Price</td>
                                        <td>@line.Quantity</td>
                                        <td>@(string.IsNullOrWhiteSpace(line.Notes) ? "—" : line.Notes)</td>
                                        <td>@DiscountLabel(line.DiscountType, line.DiscountValue, line.DiscountAmount)</td>
                                        <td>@Money(line.Subtotal)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <p>Subtotal: @Money(detail.Subtotal)</p>
                <p>Descuento de la venta: @DiscountLabel(detail.SaleDiscountType, detail.SaleDiscountValue, detail.DiscountAmount)</p>
                <p><strong>Total: @Money(detail.Total)</strong></p>

                <h4>Pagos</h4>
                @if (detail.Payments.Count == 0)
                {
                    <p>La venta no tiene pagos registrados.</p>
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <table class="table">
                            <thead><tr><th>Medio de pago</th><th>Importe aplicado</th><th>Recibido</th><th>Vuelto</th></tr></thead>
                            <tbody>
                                @foreach (var payment in detail.Payments)
                                {
                                    <tr>
                                        <td>@PaymentLabel(payment.Method)</td>
                                        <td>$@payment.Amount</td>
                                        <td>@(payment.ReceivedAmount.HasValue ? $"${payment.ReceivedAmount.Value}" : "—")</td>
                                        <td>@(payment.Change > 0m ? $"${payment.Change}" : "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <h4>Eventos</h4>
                <ul>
                    @foreach (var evt in detail.Events)
                    {
                        <li>
                            <strong>@EventLabel(evt.Kind)</strong>
                            — @(evt.At.HasValue ? evt.At.Value.ToString("dd/MM/yyyy HH:mm") : "Sin fecha registrada")
                            — @(string.IsNullOrWhiteSpace(evt.Username) ? "Sin registro" : evt.Username)
                            @if (evt.Kind == SaleHistoryEventKind.Refunded)
                            {
                                <span>— Devolución #@evt.RefundId por @Money(evt.Amount)</span>
                            }
                            @if (evt.Kind != SaleHistoryEventKind.Created)
                            {
                                <span>— Motivo: @(string.IsNullOrWhiteSpace(evt.Reason) ? "Sin motivo registrado" : evt.Reason)</span>
                            }
                        </li>
                    }
                </ul>

                <h4>Devoluciones</h4>
                @if (!string.IsNullOrEmpty(refundSuccess))
                {
                    <p role="status">@refundSuccess</p>
                }
                @if (refunds.Count == 0)
                {
                    <p>La venta no tiene devoluciones registradas.</p>
                }
                else
                {
                    <div style="overflow-x: auto;">
                        <table class="table">
                            <thead><tr><th>Fecha</th><th>Usuario</th><th>Motivo</th><th>Líneas</th><th>Medios e importes</th><th>Total</th></tr></thead>
                            <tbody>
                                @foreach (var refund in refunds)
                                {
                                    <tr @key="refund.Id">
                                        <td>@refund.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@(string.IsNullOrWhiteSpace(refund.Username) ? "Sin registro" : refund.Username)</td>
                                        <td>@(string.IsNullOrWhiteSpace(refund.Reason) ? "Sin motivo registrado" : refund.Reason)</td>
                                        <td>
                                            @foreach (var line in refund.Lines)
                                            {
                                                <div>@line.Quantity × @RefundLineName(line.SaleItemIndex) — @DispositionLabel(line.Disposition) ($@line.Amount)</div>
                                            }
                                        </td>
                                        <td>
                                            @foreach (var payment in refund.Payments)
                                            {
                                                <div>@PaymentLabel(payment.PaymentMethod): $@payment.Amount</div>
                                            }
                                        </td>
                                        <td>$@refund.Total</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (refundability != null && refundability.CanRefund)
                {
                    <h5>Registrar devolución</h5>
                    <p>Indique cuántas unidades se devuelven de cada línea y qué pasa con la mercadería. El importe se calcula con los descuentos prorrateados.</p>
                    <div style="overflow-x: auto;">
                        <table class="table">
                            <thead><tr><th>Producto</th><th>Vendidas</th><th>Ya devueltas</th><th>Cantidad a devolver</th><th>Destino</th></tr></thead>
                            <tbody>
                                @foreach (var line in refundability.Lines)
                                {
                                    var index = line.SaleItemIndex;
                                    <tr @key="index">
                                        <td>@line.ProductName</td>
                                        <td>@line.SoldQuantity</td>
                                        <td>@line.RefundedQuantity</td>
                                        <td>
                                            @if (line.RemainingQuantity > 0)
                                            {
                                                <input type="number" min="0" max="@line.RemainingQuantity" class="form-control" aria-label="Cantidad a devolver de @line.ProductName"
                                                       @bind="refundQuantities[index]" @bind:after="InvalidatePreview" />
                                            }
                                            else
                                            {
                                                @:Sin unidades pendientes
                                            }
                                        </td>
                                        <td>
                                            @if (line.RemainingQuantity > 0)
                                            {
                                                <select class="form-control" aria-label="Destino de @line.ProductName" @bind="refundDispositions[index]" @bind:after="InvalidatePreview">
                                                    <option value="@RefundDisposition.Restock" disabled="@(!line.CanRestock)">@DispositionLabel(RefundDisposition.Restock)</option>
                                                    <option value="@RefundDisposition.Waste">@DispositionLabel(RefundDisposition.Waste)</option>
                                                </select>
                                                @if (!line.CanRestock)
                                                {
                                                    <small>Sin registro de consumo: solo merma</small>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-secondary" @onclick="CalculateRefund">Calcular importe</button>
                    </div>
                    @if (refundPreviewTotal.HasValue)
                    {
                        <p role="status"><strong>Importe a devolver: $@refundPreviewTotal.Value</strong></p>
                        @if (refundPreviewLines != null)
                        {
                            <ul>
                                @foreach (var line in refundPreviewLines)
                                {
                                    <li>@line.Quantity × @RefundLineName(line.SaleItemIndex): $@line.Amount</li>
                                }
                            </ul>
                        }
                    }

                    <h5>Medios e importes reintegrados</h5>
                    <p>El efectivo se reintegra como egreso de la caja abierta actual. La suma debe ser igual al importe a devolver.</p>
                    <div class="form-group">
                        @foreach (var method in refundability.Methods.Where(m => m.RemainingAmount > 0m))
                        {
                            var methodKey = method.PaymentMethod;
                            <div>
                                <label for="refund-amount-@((int)methodKey)">@PaymentLabel(methodKey) — cobrado $@method.PaidAmount, devuelto $@method.RefundedAmount, disponible $@method.RemainingAmount</label>
                                <input id="refund-amount-@((int)methodKey)" type="number" min="0" step="0.01" class="form-control" @bind="refundAmounts[methodKey]" />
                            </div>
                        }
                    </div>
                    <p>Asignado: $@RefundAssigned()@(refundPreviewTotal.HasValue ? $" de ${refundPreviewTotal.Value}" : "")</p>
                    <div class="form-group">
                        <label for="refund-reason">Motivo de la devolución (obligatorio)</label>
                        <textarea id="refund-reason" class="form-control" @bind="refundReason" @bind:event="oninput"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="refund-confirm">
                            <input id="refund-confirm" type="checkbox" @bind="refundConfirmed" />
                            Confirmo que quiero registrar esta devolución
                        </label>
                    </div>
                    <div class="form-actions">
                        <button class="btn btn-danger" @onclick="ConfirmRefund">Confirmar devolución</button>
                    </div>
                }
                else if (refundability != null)
                {
                    <p>@(entry.DisplayStatus == SaleDisplayStatus.Cancelled ? "La venta anulada no admite devoluciones."
                        : refundability.Lines.Any(l => l.RemainingQuantity > 0) && !refundability.HasRefundableMoney ? "La venta no tiene pagos registrados; no puede devolverse."
                        : "No quedan unidades pendientes de devolución.")</p>
                }
                @if (!string.IsNullOrEmpty(refundError))
                {
                    <p role="alert">@refundError</p>
                }

                <h4>Anulación</h4>
                @if (!string.IsNullOrEmpty(cancelSuccess))
                {
                    <p role="status">@cancelSuccess</p>
                }
                @if (entry.DisplayStatus == SaleDisplayStatus.Collected)
                {
                    @if (!cancelOpen)
                    {
                        <button class="btn btn-danger" @onclick="StartCancel">Anular venta</button>
                    }
                    else
                    {
                        <div class="form-group">
                            <label for="cancel-reason">Motivo de la anulación (obligatorio)</label>
                            <textarea id="cancel-reason" class="form-control" @bind="cancelReason" @bind:event="oninput"></textarea>
                        </div>
                        <div class="form-group">
                            <label for="cancel-confirm">
                                <input id="cancel-confirm" type="checkbox" @bind="cancelConfirmed" />
                                Confirmo que quiero anular esta venta
                            </label>
                        </div>
                        <div class="form-actions">
                            <button class="btn btn-danger" @onclick="ConfirmCancel">Confirmar anulación</button>
                            <button class="btn btn-secondary" @onclick="AbortCancel">No anular</button>
                        </div>
                    }
                }
                else if (entry.DisplayStatus == SaleDisplayStatus.Cancelled)
                {
                    <p>La venta ya no está cobrada, por lo que no puede anularse de nuevo.</p>
                }
                else
                {
                    <p>La venta tiene devoluciones registradas y no puede anularse: anular y devolver dinero son operaciones distintas, y el dinero ya devuelto no se revierte.</p>
                }
                @if (!string.IsNullOrEmpty(cancelError))
                {
                    <p role="alert">@cancelError</p>
                }
            }
            <div class="form-actions">
                <button class="btn btn-secondary" @onclick="CloseDetail">Volver al listado</button>
            </div>
        </div>
    }

    <div class="form-card">
        <h3>Ventas registradas</h3>
        <div class="history-filters">
            <div class="form-group">
                <label for="history-from">Desde</label>
                <input id="history-from" type="date" class="form-control" @bind="filterFrom" />
            </div>
            <div class="form-group">
                <label for="history-to">Hasta</label>
                <input id="history-to" type="date" class="form-control" @bind="filterTo" />
            </div>
            <div class="form-group">
                <label for="history-number">N.º de venta</label>
                <input id="history-number" type="number" min="1" class="form-control" @bind="filterSaleNumber" />
            </div>
            <div class="form-group">
                <label for="history-operator">Operador</label>
                <select id="history-operator" class="form-control" @bind="filterOperator">
                    <option value="">Todos</option>
                    <option value="@NoOperatorOption">Sin registro</option>
                    @foreach (var op in operators)
                    {
                        <option value="@op.UserId">@op.Username</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="history-payment">Medio de pago</label>
                <select id="history-payment" class="form-control" @bind="filterPayment">
                    <option value="">Todos</option>
                    @foreach (var method in Enum.GetValues<PaymentMethod>())
                    {
                        <option value="@method">@PaymentLabel(method)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="history-register">Caja (ID)</label>
                <input id="history-register" type="number" min="1" class="form-control" @bind="filterRegister" />
            </div>
            <div class="form-group">
                <label for="history-status">Estado</label>
                <select id="history-status" class="form-control" @bind="filterStatus">
                    <option value="@SaleHistoryStatusFilter.All">Todas</option>
                    <option value="@SaleHistoryStatusFilter.Completed">Cobradas</option>
                    <option value="@SaleHistoryStatusFilter.Cancelled">Anuladas</option>
                    <option value="@SaleHistoryStatusFilter.PartiallyRefunded">Parcialmente devueltas</option>
                    <option value="@SaleHistoryStatusFilter.Refunded">Devueltas</option>
                </select>
            </div>
            <div class="form-group">
                <label for="history-text">Producto</label>
                <input id="history-text" type="text" class="form-control" placeholder="Nombre del producto" @bind="filterText" />
            </div>
        </div>
        <div class="form-actions">
            <button class="btn btn-primary" @onclick="ApplyFilters">Aplicar filtros</button>
            <button class="btn btn-secondary" @onclick="ClearFilters">Limpiar</button>
        </div>

        @if (!string.IsNullOrEmpty(historyError))
        {
            <p role="alert">@historyError</p>
        }
        else if (historyPage == null)
        {
            <p>Cargando historial…</p>
        }
        else if (historyPage.TotalCount == 0)
        {
            <p>No hay ventas que coincidan con los filtros.</p>
        }
        else
        {
            <div style="overflow-x: auto;">
                <table class="table">
                    <thead>
                        <tr><th>N.º</th><th>Fecha</th><th>Operador</th><th>Caja</th><th>Productos</th><th>Medios de pago</th><th>Estado</th><th>Total</th><th>Devuelto</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in historyPage.Entries)
                        {
                            <tr @key="entry.Id" class="@(entry.Id == SaleId ? "history-selected" : null)">
                                <td>@entry.Id</td>
                                <td>@entry.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@OperatorLabel(entry)</td>
                                <td>@(entry.CashRegisterId.HasValue ? $"#{entry.CashRegisterId}" : "—")</td>
                                <td>@(entry.ProductNames.Count == 0 ? "—" : string.Join(", ", entry.ProductNames))</td>
                                <td>@(entry.PaymentMethods.Count == 0 ? "—" : string.Join(", ", entry.PaymentMethods.Select(PaymentLabel)))</td>
                                <td>@StatusLabel(entry.DisplayStatus)</td>
                                <td>@Money(entry.Total)</td>
                                <td>@(entry.RefundedTotal == 0m ? "—" : Money(entry.RefundedTotal))</td>
                                <td><button class="btn btn-secondary btn-small" @onclick="() => ShowDetail(entry.Id)">Ver detalle</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="form-actions history-pagination">
                <button class="btn btn-secondary" @onclick="PreviousPage" disabled="@(historyPage.Page <= 1)">Anterior</button>
                <span>Página @historyPage.Page de @historyPage.TotalPages · @historyPage.TotalCount ventas</span>
                <button class="btn btn-secondary" @onclick="NextPage" disabled="@(historyPage.Page >= historyPage.TotalPages)">Siguiente</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int? SaleId { get; set; }

    private const int PageSize = 10;
    private const string NoOperatorOption = "none";
    private DateTime? filterFrom;
    private DateTime? filterTo;
    private int? filterSaleNumber;
    private string filterOperator = string.Empty;
    private string filterPayment = string.Empty;
    private int? filterRegister;
    private SaleHistoryStatusFilter filterStatus = SaleHistoryStatusFilter.All;
    private string? filterText;
    // Applied filter: edits to the inputs only take effect on "Aplicar filtros".
    private SaleHistoryFilter appliedFilter = new(PageSize: PageSize);
    private SaleHistoryPage? historyPage;
    private string? historyError;
    private IReadOnlyList<SaleHistoryOperator> operators = Array.Empty<SaleHistoryOperator>();
    private SaleHistoryDetail? detail;
    private string? detailMessage;
    private int? shownSaleId;
    private bool cancelOpen;
    private string? cancelReason;
    private bool cancelConfirmed;
    private string? cancelError;
    private string? cancelSuccess;
    // Refund form: per-line quantity/destination and per-method amounts, keyed by line index / payment method.
    private SaleRefundability? refundability;
    private IReadOnlyList<SaleRefund> refunds = Array.Empty<SaleRefund>();
    private readonly Dictionary<int, int> refundQuantities = new();
    private readonly Dictionary<int, RefundDisposition> refundDispositions = new();
    private readonly Dictionary<PaymentMethod, decimal?> refundAmounts = new();
    private decimal? refundPreviewTotal;
    private IReadOnlyList<SaleRefundLine>? refundPreviewLines;
    private string? refundReason;
    private bool refundConfirmed;
    private string? refundError;
    private string? refundSuccess;

    // Runs on first load and on every route change, so each selection rechecks live permissions.
    protected override void OnParametersSet()
    {
        if (!EnsureAdmin()) return;
        if (shownSaleId != SaleId)
        {
            shownSaleId = SaleId;
            ResetCancelForm();
            cancelSuccess = null;
            ResetRefundForm();
            refundSuccess = null;
        }
        if (historyPage == null && historyError == null) LoadHistory();
        LoadDetail();
    }

    private bool EnsureAdmin()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return false;
        }
        if (!AuthService.IsInRole(UserRole.Admin))
        {
            Navigation.NavigateTo("/unauthorized");
            return false;
        }
        return true;
    }

    // The singleton service revalidates the freshly resolved circuit actor on every query.
    private void LoadHistory()
    {
        historyError = null;
        try
        {
            var actor = AuthService.CurrentUser;
            historyPage = HistoryService.GetHistory(appliedFilter, actor);
            operators = HistoryService.GetOperators(actor);
        }
        catch (UnauthorizedAccessException) { historyPage = null; EnsureAdmin(); }
        catch (InvalidOperationException ex) { historyPage = null; historyError = ex.Message; }
    }

    private void LoadDetail()
    {
        detail = null;
        detailMessage = null;
        refundability = null;
        refunds = Array.Empty<SaleRefund>();
        if (!SaleId.HasValue) return;
        try
        {
            detail = HistoryService.GetDetail(SaleId.Value, AuthService.CurrentUser);
            if (detail == null) detailMessage = $"No existe una venta con el ID {SaleId}.";
        }
        catch (UnauthorizedAccessException) { EnsureAdmin(); }
        if (detail != null) LoadRefundData(detail.Entry.Id);
    }

    // Reached only after the strict history query accepted the live admin.
    private void LoadRefundData(int saleId)
    {
        refundability = SaleService.GetRefundability(saleId);
        refunds = SaleService.GetRefunds(saleId);
        foreach (var line in refundability?.Lines ?? Array.Empty<SaleRefundLineStatus>())
        {
            refundQuantities.TryAdd(line.SaleItemIndex, 0);
            refundDispositions.TryAdd(line.SaleItemIndex, RefundDisposition.Waste);
        }
        foreach (var method in refundability?.Methods ?? Array.Empty<SaleRefundMethodStatus>())
            refundAmounts.TryAdd(method.PaymentMethod, null);
    }

    private SaleHistoryFilter BuildFilter(int page)
    {
        int? operatorId = int.TryParse(filterOperator, out var parsedOperator) ? parsedOperator : null;
        PaymentMethod? method = Enum.TryParse<PaymentMethod>(filterPayment, out var parsedMethod) ? parsedMethod : null;
        return new SaleHistoryFilter(filterFrom, filterTo, filterSaleNumber, operatorId,
            filterOperator == NoOperatorOption, method, filterRegister, filterStatus, filterText, page, PageSize);
    }

    private void ApplyFilters()
    {
        if (!EnsureAdmin()) return;
        if (filterFrom.HasValue && filterTo.HasValue && filterFrom.Value.Date > filterTo.Value.Date)
        {
            historyPage = null;
            historyError = "La fecha inicial no puede ser posterior a la fecha final.";
            return;
        }
        appliedFilter = BuildFilter(1);
        LoadHistory();
    }

    private void ClearFilters()
    {
        if (!EnsureAdmin()) return;
        filterFrom = null;
        filterTo = null;
        filterSaleNumber = null;
        filterOperator = string.Empty;
        filterPayment = string.Empty;
        filterRegister = null;
        filterStatus = SaleHistoryStatusFilter.All;
        filterText = null;
        appliedFilter = new SaleHistoryFilter(PageSize: PageSize);
        LoadHistory();
    }

    private void ChangePage(int delta)
    {
        if (!EnsureAdmin() || historyPage == null) return;
        appliedFilter = appliedFilter with { Page = historyPage.Page + delta };
        LoadHistory();
    }

    private void PreviousPage() => ChangePage(-1);
    private void NextPage() => ChangePage(1);

    private void ShowDetail(int saleId)
    {
        if (!EnsureAdmin()) return;
        Navigation.NavigateTo($"/sales/history/{saleId}");
    }

    private void CloseDetail()
    {
        if (!EnsureAdmin()) return;
        Navigation.NavigateTo("/sales/history");
    }

    private void StartCancel()
    {
        if (!EnsureAdmin()) return;
        if (detail?.Entry.DisplayStatus != SaleDisplayStatus.Collected) return;
        ResetCancelForm();
        cancelSuccess = null;
        cancelOpen = true;
    }

    private void AbortCancel()
    {
        if (!EnsureAdmin()) return;
        ResetCancelForm();
    }

    private void ResetCancelForm()
    {
        cancelOpen = false;
        cancelReason = null;
        cancelConfirmed = false;
        cancelError = null;
    }

    // The only mutation of this page: SaleService.Cancel, after explicit confirmation and a reason.
    private void ConfirmCancel()
    {
        if (!EnsureAdmin()) return;
        cancelError = null;
        cancelSuccess = null;
        if (!SaleId.HasValue || detail == null) return;
        if (!cancelConfirmed)
        {
            cancelError = "Debe confirmar la anulación.";
            return;
        }
        if (string.IsNullOrWhiteSpace(cancelReason))
        {
            cancelError = "Debe indicar un motivo de cancelación.";
            return;
        }
        try
        {
            var actor = AuthService.CurrentUser;
            // Strict live-admin revalidation (identity, credentials hash and role) before the command.
            HistoryService.GetDetail(SaleId.Value, actor);
            SaleService.Cancel(SaleId.Value, cancelReason, actor);
        }
        catch (UnauthorizedAccessException ex)
        {
            if (EnsureAdmin()) cancelError = ex.Message;
            return;
        }
        catch (InvalidOperationException ex)
        {
            cancelError = ex.Message;
            return;
        }
        ResetCancelForm();
        cancelSuccess = "Venta anulada; stock restaurado.";
        LoadDetail();
        LoadHistory();
    }

    private void ResetRefundForm()
    {
        refundQuantities.Clear();
        refundDispositions.Clear();
        refundAmounts.Clear();
        refundPreviewTotal = null;
        refundPreviewLines = null;
        refundReason = null;
        refundConfirmed = false;
        refundError = null;
    }

    // The amount shown is only valid for the quantities it was computed from.
    private void InvalidatePreview()
    {
        refundPreviewTotal = null;
        refundPreviewLines = null;
    }

    private decimal RefundAssigned() => refundAmounts.Values.Sum(a => a ?? 0m);

    private List<SaleRefundLine> BuildRefundLines() => refundQuantities
        .Where(q => q.Value != 0)
        .OrderBy(q => q.Key)
        .Select(q => new SaleRefundLine
        {
            SaleItemIndex = q.Key, Quantity = q.Value,
            Disposition = refundDispositions.GetValueOrDefault(q.Key, RefundDisposition.Waste)
        }).ToList();

    private List<SaleRefundPayment> BuildRefundPayments() => refundAmounts
        .Where(a => a.Value.HasValue && a.Value.Value != 0m)
        .OrderBy(a => a.Key)
        .Select(a => new SaleRefundPayment { PaymentMethod = a.Key, Amount = a.Value!.Value }).ToList();

    // Non-mutating: computes the amount SaleService.Refund would use for the chosen lines.
    private void CalculateRefund()
    {
        if (!EnsureAdmin()) return;
        refundError = null;
        refundSuccess = null;
        InvalidatePreview();
        if (!SaleId.HasValue || detail == null) return;
        try
        {
            HistoryService.GetDetail(SaleId.Value, AuthService.CurrentUser);
            var preview = SaleService.PreviewRefund(SaleId.Value, BuildRefundLines());
            refundPreviewTotal = preview.Total;
            refundPreviewLines = preview.Lines;
        }
        catch (UnauthorizedAccessException ex)
        {
            if (EnsureAdmin()) refundError = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            refundError = ex.Message;
        }
    }

    // Second mutation of this page besides cancellation: SaleService.Refund, after explicit confirmation.
    // Reason, quantities, amounts and per-method caps are validated by the service, which owns those rules.
    private void ConfirmRefund()
    {
        if (!EnsureAdmin()) return;
        refundError = null;
        refundSuccess = null;
        if (!SaleId.HasValue || detail == null) return;
        if (!refundConfirmed)
        {
            refundError = "Debe confirmar la devolución.";
            return;
        }
        SaleRefund refund;
        try
        {
            var actor = AuthService.CurrentUser;
            // Strict live-admin revalidation (identity, credentials hash and role) before the command.
            HistoryService.GetDetail(SaleId.Value, actor);
            refund = SaleService.Refund(SaleId.Value, refundReason, BuildRefundLines(), BuildRefundPayments(), actor);
        }
        catch (UnauthorizedAccessException ex)
        {
            if (EnsureAdmin()) refundError = ex.Message;
            return;
        }
        catch (InvalidOperationException ex)
        {
            refundError = ex.Message;
            return;
        }
        ResetRefundForm();
        refundSuccess = $"Devolución #{refund.Id} registrada por ${refund.Total}.";
        LoadDetail();
        LoadHistory();
    }

    private string RefundLineName(int index)
    {
        var line = refundability?.Lines.FirstOrDefault(l => l.SaleItemIndex == index);
        return string.IsNullOrWhiteSpace(line?.ProductName) ? $"Línea {index + 1}" : line.ProductName;
    }

    private static string DispositionLabel(RefundDisposition disposition) => disposition switch
    {
        RefundDisposition.Restock => "Vuelve a stock",
        RefundDisposition.Waste => "Merma",
        _ => "Destino desconocido"
    };

    private static string Money(decimal? amount) => amount.HasValue ? $"${amount.Value}" : "No disponible";

    private static string StatusLabel(SaleDisplayStatus status) => SaleService.GetDisplayStatusLabel(status);

    private static string OperatorLabel(SaleHistoryEntry entry) =>
        !string.IsNullOrWhiteSpace(entry.OperatorUsername) ? entry.OperatorUsername
        : entry.OperatorUserId.HasValue ? $"Usuario ID {entry.OperatorUserId}" : "Sin registro";

    private static string EventLabel(SaleHistoryEventKind kind) => kind switch
    {
        SaleHistoryEventKind.Created => "Venta registrada",
        SaleHistoryEventKind.Cancelled => "Venta anulada",
        SaleHistoryEventKind.Refunded => "Devolución",
        _ => "Evento"
    };

    private static string DiscountLabel(DiscountType type, decimal value, decimal? amount) => type switch
    {
        DiscountType.Percentage => $"{value}% ({Money(amount)})",
        DiscountType.Fixed => $"${value} fijo ({Money(amount)})",
        _ => "Sin descuento"
    };

    private static string PaymentLabel(PaymentMethod method) => method switch
    {
        PaymentMethod.Cash => "Efectivo",
        PaymentMethod.DebitCard => "Tarjeta de débito",
        PaymentMethod.CreditCard => "Tarjeta de crédito",
        PaymentMethod.Transfer => "Transferencia",
        PaymentMethod.MercadoPago => "Mercado Pago",
        _ => "Otro"
    };
}
