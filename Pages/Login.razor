@page "/login"
@using GastroApp.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión - GastroApp</PageTitle>

<div class="login-stage">
    <section class="login-card" aria-labelledby="login-heading">
        <div class="stack stack--sm">
            <div class="flex-wrap-gap">
                <span class="brand__mark" aria-hidden="true"><Icon Name="utensils" Size="20" /></span>
                <div>
                    <p class="text-xs fw-700 text-muted" style="text-transform: uppercase; letter-spacing: 0.06em;">GastroApp</p>
                    <h1 id="login-heading">Ingresá a GastroApp</h1>
                </div>
            </div>
            <p class="text-sm text-secondary">Usá tu usuario del local para acceder al punto de venta o al panel de administración.</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <Banner Variant="danger" Title="No pudimos iniciar sesión">@errorMessage</Banner>
        }

        <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin" class="stack">
            <div class="field">
                <label class="field__label" for="login-user">Usuario</label>
                <InputText id="login-user" @bind-Value="loginModel.Username" class="input"
                           autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="admin" />
            </div>

            <div class="field">
                <label class="field__label" for="login-pass">Contraseña</label>
                <div class="password-wrap">
                    <InputText id="login-pass" @bind-Value="loginModel.Password" type="@(showPassword ? "text" : "password")"
                               class="input" autocomplete="current-password" placeholder="••••••" />
                    <button type="button" class="password-wrap__toggle" aria-pressed="@(showPassword ? "true" : "false")"
                            aria-label="@(showPassword ? "Ocultar contraseña" : "Mostrar contraseña")" @onclick="ToggleShowPassword">
                        <Icon Name="@(showPassword ? "eyeOff" : "eye")" />
                    </button>
                </div>
            </div>

            <button type="submit" class="btn btn--primary btn--lg btn--block">
                <Icon Name="lock" />
                <span>Iniciar sesión</span>
            </button>
        </EditForm>

        <div class="card card--compact card--subtle">
            <p class="text-xs text-muted">Usuario por defecto: <strong>admin</strong> / <strong>admin</strong></p>
        </div>
    </section>
</div>

@code {
    private LoginModel loginModel = new();
    private string errorMessage = string.Empty;
    private bool showPassword;

    private class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }

    protected override void OnInitialized()
    {
        // Si ya está autenticado, redirigir al dashboard
        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
        }
    }

    private void ToggleShowPassword() => showPassword = !showPassword;

    private void HandleLogin()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(loginModel.Username) || string.IsNullOrWhiteSpace(loginModel.Password))
        {
            errorMessage = "Por favor complete todos los campos";
            return;
        }

        if (AuthService.Login(loginModel.Username, loginModel.Password))
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            errorMessage = "Usuario o contraseña incorrectos";
        }
    }
}
