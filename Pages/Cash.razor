@page "/cash"
@using GastroApp.Models
@using GastroApp.Services
@using GastroApp.Shared.Cash
@using GastroApp.Shared.Pos
@using System.Globalization
@inject CashRegisterService CashService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Caja diaria</PageTitle>

@{
    // Resolve once per render, so a replaced current pointer cannot leave a stale header.
    cashRegister = CashService.GetCurrent();
    var paymentSummary = CashService.GetCurrentPaymentSummary();
    var isOpen = cashRegister?.IsOpen == true;
    dialogHostRendered = false;
    dialogWanted = false;
}

<div class="page-header">
    <div>
        <div class="page-header__title-row">
            <h1>Caja diaria</h1>
            @if (isOpen)
            {
                <Badge Variant="ok" Icon="checkCircle" Label="@($"Abierta · Sesión #{cashRegister!.Id}")" />
            }
            else
            {
                <Badge Variant="danger" Icon="alertOctagon" Label="Cerrada" />
            }
        </div>
        <p class="page-header__subtitle">Controlá el efectivo disponible, registrá movimientos manuales y cerrá la jornada con arqueo por denominación.</p>
    </div>
    <div class="page-header__actions">
        <a href="/cash/history" class="btn">
            <Icon Name="history" Size="18" />
            <span>Historial de cajas</span>
        </a>
    </div>
</div>

<div class="stack stack--lg">
    @if (!string.IsNullOrEmpty(closeMessage))
    {
        <div role="status">
            <Banner Variant="ok">
                @closeMessage <a href="/summary">Ver resumen del día</a>
            </Banner>
        </div>
    }
    @if (!string.IsNullOrEmpty(countError) && !isOpen)
    {
        @* A confirmation rejected because another circuit closed the session must stay visible. *@
        <Banner Variant="danger">@countError</Banner>
    }

    @if (!isOpen)
    {
        <section class="card stack" aria-labelledby="open-cash-title">
            <div>
                <h2 id="open-cash-title" class="card__title">Abrir nueva sesión de caja</h2>
                <p class="card__desc">Ingresá el monto inicial con el que empezás el día.</p>
            </div>
            @if (!string.IsNullOrEmpty(cashError))
            {
                <Banner Variant="danger">@cashError</Banner>
            }
            <form class="toolbar" novalidate @onsubmit="OpenCash">
                <div class="field cash-open-field">
                    <label class="field__label" for="initial-amount">Monto inicial ($)</label>
                    <input id="initial-amount" type="number" @bind="initialAmount" class="input tnum" placeholder="0" step="0.01" />
                </div>
                <button type="submit" class="btn btn--collect btn--lg">
                    <Icon Name="checkCircle" Size="18" />
                    <span>Abrir caja</span>
                </button>
            </form>
        </section>

        @if (cashRegister != null)
        {
            var count = CashService.GetCount(cashRegister.Id);
            var closedDifference = count?.Difference ?? cashRegister.Difference;
            var (closedVariant, closedIcon) = CashFormat.DifferenceBadge(closedDifference);
            <section class="card stack" aria-labelledby="last-closed-title">
                <div class="row-between">
                    <div>
                        <h2 id="last-closed-title" class="card__title">Última caja cerrada — Sesión #@cashRegister.Id</h2>
                        <p class="card__desc">
                            Apertura @cashRegister.OpenDate.ToString("dd/MM/yyyy HH:mm")@(cashRegister.CloseDate.HasValue ? $" · Cierre {cashRegister.CloseDate.Value:dd/MM/yyyy HH:mm}" : "")
                        </p>
                    </div>
                    <Badge Variant="@closedVariant" Icon="@closedIcon" Label="@($"{DifferenceLabel(closedDifference)} ({CashFormat.SignedMoney(closedDifference)})")" />
                </div>
                <div class="grid-kpi">
                    <KpiCard Label="Fondo inicial" Value="@PosFormat.Money(cashRegister.InitialAmount)" />
                    <KpiCard Label="Esperado en caja" Value="@PosFormat.Money(count?.ExpectedAmount ?? cashRegister.ExpectedAmount)" />
                    <KpiCard Label="@(count == null ? "Monto final" : "Total contado")" Value="@PosFormat.Money(count?.CountedAmount ?? cashRegister.FinalAmount)" />
                </div>
                @if (count == null)
                {
                    <Banner Variant="info" Title="Cierre sin arqueo">Esta caja se cerró sin arqueo detallado.</Banner>
                }
                else
                {
                    <div class="stack stack--sm">
                        <h3 class="card__title">Arqueo registrado</h3>
                        <p class="text-sm text-secondary">Responsable: @count.Username (ID @count.UserId) · Fecha: @count.CountedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        <p class="text-sm">Motivo: @(string.IsNullOrWhiteSpace(count.Reason) ? "Sin motivo (cierre exacto)" : count.Reason)</p>
                        <CountLinesTable Lines="count.Lines" AriaLabel="Denominaciones del arqueo registrado" />
                    </div>
                }
                <div>
                    <a href="/summary" class="btn btn--sm"><Icon Name="summary" Size="16" /> <span>Ver resumen del día</span></a>
                </div>
            </section>
        }
    }
    else
    {
        var fresh = TryGetFreshReview();
        var stale = countReview == null || fresh == null || fresh != countReview;
        var (preview, previewError) = BuildPreview();
        var activeRows = countRows.Where(r => !IsBlank(r)).ToList();
        var differenceMissing = preview != null && preview.Difference != 0m;
        dialogHostRendered = true;
        dialogWanted = confirmingClose && preview != null && !stale;

        <section class="grid-kpi" aria-label="Indicadores de la caja abierta">
            <KpiCard Label="Apertura" Value="@cashRegister!.OpenDate.ToString("HH:mm")"
                     Meta="@($"{cashRegister.OpenDate:dd/MM/yyyy} · Fondo inicial: {PosFormat.Money(cashRegister.InitialAmount)}")" />
            <KpiCard Label="Efectivo ingresado" Value="@PosFormat.Money(CashService.GetCashInflow(cashRegister.Id))"
                     Meta="Ventas en efectivo + ingresos manuales" />
            <KpiCard Label="Esperado en caja" Value="@PosFormat.Money(CashService.GetExpectedCash(cashRegister.Id))"
                     Meta="Inicial + ventas/ingresos − gastos/retiros/devoluciones">
                <StatusContent><Badge Variant="ok" Label="En vivo" /></StatusContent>
            </KpiCard>
            <KpiCard Label="Cobros netos" Value="@CashFormat.Money(paymentSummary.NetTotal)"
                     Meta="Todos los medios de pago de la sesión" />
        </section>

        <div class="grid-2 cash-workspace">
            <section class="card stack" aria-labelledby="cash-move-title">
                <div>
                    <h2 id="cash-move-title" class="card__title">Movimiento de efectivo</h2>
                    <p class="card__desc">Registrá un ingreso, gasto o retiro de la caja abierta. Los movimientos no se pueden editar ni eliminar.</p>
                </div>
                @if (!string.IsNullOrEmpty(cashError))
                {
                    <Banner Variant="danger">@cashError</Banner>
                }
                <form class="stack" novalidate @onsubmit="RecordMovement">
                    <div class="form-grid">
                        <div class="field">
                            <label class="field__label" for="movement-type">Tipo</label>
                            <select id="movement-type" @bind="movementType" class="select">
                                <option value="@CashMovementType.Income">Ingreso (+)</option>
                                <option value="@CashMovementType.Expense">Gasto (−)</option>
                                <option value="@CashMovementType.Withdrawal">Retiro (−)</option>
                            </select>
                        </div>
                        <div class="field">
                            <label class="field__label" for="movement-amount">Monto ($) <span class="field__req" aria-hidden="true">*</span></label>
                            <input id="movement-amount" type="text" inputmode="decimal" @bind="movementAmount" @bind:event="oninput"
                                   class="input tnum" placeholder="Ej.: 5000" aria-describedby="movement-amount-hint" />
                            <span id="movement-amount-hint" class="field__hint">Mayor que cero, sin separador de miles. Separador decimal: @PosFormat.DecimalSeparator</span>
                        </div>
                    </div>
                    <div class="field">
                        <label class="field__label" for="movement-reason">Motivo (obligatorio) <span class="field__req" aria-hidden="true">*</span></label>
                        <input id="movement-reason" type="text" @bind="movementReason" @bind:event="oninput" class="input"
                               placeholder="Ej.: Compra de hielo, refuerzo de cambio, retiro a caja fuerte" />
                    </div>
                    <div class="flex-wrap-gap">
                        <button type="submit" class="btn btn--primary">
                            <Icon Name="plus" Size="17" />
                            <span>Registrar movimiento</span>
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(movementMessage))
                    {
                        <div role="status">
                            <Banner Variant="ok">@movementMessage</Banner>
                        </div>
                    }
                </form>
            </section>

            <section class="card stack cash-arqueo" aria-labelledby="arqueo-title">
                <div class="row-between">
                    <div>
                        <h2 id="arqueo-title" class="card__title">Arqueo y cierre de caja</h2>
                        <p class="card__desc">Contá el efectivo por denominación. Las filas vacías se ignoran y el cierre es definitivo.</p>
                    </div>
                    @if (preview != null)
                    {
                        var (diffVariant, diffIcon) = CashFormat.DifferenceBadge(preview.Difference);
                        <Badge Variant="@diffVariant" Icon="@diffIcon" Label="@DifferenceText(preview.Difference)" />
                    }
                </div>
                <p class="text-sm text-secondary">Esperado en caja (según tu última revisión): <strong class="tnum">@(countReview == null ? "—" : PosFormat.Money(countReview.ExpectedAmount))</strong></p>

                @if (stale)
                {
                    <div role="alert">
                        <Banner Variant="warn" Title="Saldo esperado desactualizado">
                            <ChildContent>@StaleText(fresh)</ChildContent>
                            <Actions>
                                <button type="button" class="btn btn--sm" @onclick="RefreshCountReview">
                                    <Icon Name="refresh" Size="14" />
                                    <span>Actualizar saldo esperado</span>
                                </button>
                            </Actions>
                        </Banner>
                    </div>
                }
                else if (!string.IsNullOrEmpty(countNotice))
                {
                    <div role="alert">
                        <Banner Variant="warn">@countNotice</Banner>
                    </div>
                }

                <div class="denom-grid" role="group" aria-label="Conteo de efectivo por denominación">
                    <div class="denom-row denom-row--head" aria-hidden="true">
                        <span>Denominación</span>
                        <span>Cantidad</span>
                        <span class="denom-row__sub">Subtotal</span>
                        <span></span>
                    </div>
                    @for (var i = 0; i < countRows.Count; i++)
                    {
                        var row = countRows[i];
                        var number = i + 1;
                        var rowError = ParseRow(row, out _);
                        var activeIndex = activeRows.IndexOf(row);
                        <div class="denom-row" @key="row">
                            <input id="count-denomination-@number" type="text" inputmode="decimal" class="input input--compact tnum"
                                   placeholder="Denominación" aria-label="@($"Denominación de la fila {number}")" aria-invalid="@(rowError != null ? "true" : null)"
                                   @bind="row.Denomination" @bind:event="oninput" @bind:after="ResetConfirmation" />
                            <input id="count-quantity-@number" type="text" inputmode="numeric" class="input input--compact tnum"
                                   placeholder="Cantidad" aria-label="@($"Cantidad de la fila {number}")" aria-invalid="@(rowError != null ? "true" : null)"
                                   @bind="row.Quantity" @bind:event="oninput" @bind:after="ResetConfirmation" />
                            <span class="denom-row__sub fw-700 tnum">@(preview != null && activeIndex >= 0 ? PosFormat.Money(preview.Lines[activeIndex].Subtotal) : "—")</span>
                            <button class="btn btn--ghost btn--icon" type="button" aria-label="@($"Quitar la fila {number}")" @onclick="() => RemoveCountRow(row)">
                                <Icon Name="trash" Size="14" />
                            </button>
                            @if (rowError != null)
                            {
                                <p class="denom-row__error" role="alert"><Icon Name="alertOctagon" Size="14" /> <span>Fila @number: @rowError</span></p>
                            }
                        </div>
                    }
                </div>
                <div class="flex-wrap-gap">
                    <button class="btn btn--sm" type="button" @onclick="AddCountRow">
                        <Icon Name="plus" Size="14" />
                        <span>Agregar denominación</span>
                    </button>
                    <span class="text-xs text-muted">Denominación mayor que cero, sin separador de miles. Separador decimal: @PosFormat.DecimalSeparator</span>
                </div>

                @if (previewError != null)
                {
                    <Banner Variant="danger">@previewError</Banner>
                }

                <div class="card card--compact card--subtle stack stack--sm" aria-live="polite">
                    <div class="tally-row">
                        <span class="text-secondary">Total contado</span>
                        <span class="fw-700 tnum">@(preview == null ? "—" : PosFormat.Money(preview.CountedAmount))</span>
                    </div>
                    <div class="tally-row">
                        <span class="text-secondary">Esperado en caja</span>
                        <span class="fw-700 tnum">@(countReview == null ? "—" : PosFormat.Money(countReview.ExpectedAmount))</span>
                    </div>
                    <div class="tally-row tally-row--total">
                        <span>Diferencia</span>
                        <span class="tnum @(preview == null ? "" : preview.Difference == 0m ? "text-ok" : preview.Difference < 0m ? "text-danger" : "")">@(preview == null ? "—" : DifferenceText(preview.Difference))</span>
                    </div>
                </div>

                <div class="field">
                    <label class="field__label" for="count-reason">Motivo de la diferencia @if (differenceMissing){<span class="field__req" aria-hidden="true">*</span>}</label>
                    <textarea id="count-reason" class="textarea" rows="2" aria-required="@(differenceMissing ? "true" : null)" aria-describedby="count-reason-hint"
                              @bind="countReason" @bind:event="oninput" @bind:after="ResetConfirmation"></textarea>
                    <span id="count-reason-hint" class="field__hint">@(differenceMissing ? "Obligatorio: el conteo no coincide con el esperado." : "Opcional si el cierre es exacto.")</span>
                </div>

                @if (!string.IsNullOrEmpty(countError) && !confirmingClose)
                {
                    <Banner Variant="danger">@countError</Banner>
                }
                <button type="button" class="btn btn--danger btn--lg btn--block" @onclick="ReviewClose" disabled="@stale">
                    <Icon Name="clipboard" Size="18" />
                    <span>Revisar cierre de caja</span>
                </button>
            </section>
        </div>

        <ModalDialog @ref="closeDialog" Title="@($"Confirmá el cierre · Caja #{cashRegister.Id}")"
                     Subtitle="Esta acción cierra la sesión actual, guarda el arqueo y genera el resumen diario. El cierre es definitivo."
                     LightDismiss="false" OnClosed="HandleCloseDialogClosed">
            <ChildContent>
                @if (preview != null)
                {
                    <div class="stack cash-dialog">
                        @if (!string.IsNullOrEmpty(countError))
                        {
                            <Banner Variant="danger">@countError</Banner>
                        }
                        <div class="card card--compact card--subtle stack stack--sm">
                            <div class="tally-row"><span>Total contado</span><strong class="tnum">@PosFormat.Money(preview.CountedAmount)</strong></div>
                            <div class="tally-row"><span>Esperado en caja</span><strong class="tnum">@PosFormat.Money(preview.ExpectedAmount)</strong></div>
                            <div class="tally-row">
                                <span>Diferencia</span>
                                <Badge Variant="@CashFormat.DifferenceBadge(preview.Difference).Variant" Icon="@CashFormat.DifferenceBadge(preview.Difference).Icon"
                                       Label="@DifferenceText(preview.Difference)" />
                            </div>
                            <p class="text-xs text-secondary">Motivo: @(string.IsNullOrWhiteSpace(countReason) ? "Sin motivo (cierre exacto)" : countReason.Trim())</p>
                        </div>
                        @if (preview.CountedAmount == 0m)
                        {
                            <label class="check-field">
                                <input type="checkbox" id="count-zero-confirmed" @bind="zeroConfirmed" />
                                <span>Confirmo que el efectivo contado es cero</span>
                            </label>
                        }
                    </div>
                }
            </ChildContent>
            <Footer>
                <button value="cancel" class="btn" autofocus>Volver a editar</button>
                <button type="button" class="btn btn--danger" @onclick="CloseCash"
                        disabled="@(preview != null && preview.CountedAmount == 0m && !zeroConfirmed)">Confirmar cierre definitivo</button>
            </Footer>
        </ModalDialog>
    }

    <PaymentBreakdown Summary="paymentSummary" Title="Cobros registrados por medio de pago" TitleId="cash-pay-title"
                       Description="Importes aplicados a las ventas de esta caja, incluidas las canceladas: no se revierten los cobros. No son las ventas completadas del día ni el efectivo disponible en caja. No incluyen monto inicial, movimientos manuales, efectivo entregado ni vuelto.">
        <div class="table-wrapper" tabindex="0" role="region" aria-labelledby="cash-pay-title">
            <table class="data-table data-table--stack">
                <thead>
                    <tr>
                        <th scope="col">Medio de pago</th>
                        <th scope="col" class="col-num">Importe registrado</th>
                        <th scope="col" class="col-num">Devuelto</th>
                        <th scope="col" class="col-num">Neto</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in paymentSummary.Rows)
                    {
                        <tr @key="row.Method">
                            <th scope="row">@PosFormat.PaymentLabel(row.Method)</th>
                            <td data-label="Registrado" class="col-num">@CashFormat.Money(row.Amount)</td>
                            <td data-label="Devuelto" class="@CashFormat.RefundClass(row.RefundedAmount)">@CashFormat.Money(row.RefundedAmount)</td>
                            <td data-label="Neto" class="col-num fw-700">@CashFormat.Money(row.NetAmount)</td>
                        </tr>
                    }
                    <tr class="payment-total">
                        <th scope="row">Total de cobros registrados</th>
                        <td data-label="Registrado" class="col-num fw-700">@CashFormat.Money(paymentSummary.RegisteredTotal)</td>
                        <td data-label="Devuelto" class="@CashFormat.RefundClass(paymentSummary.RefundedTotal) fw-700">@CashFormat.Money(paymentSummary.RefundedTotal)</td>
                        <td data-label="Neto" class="col-num fw-700">@CashFormat.Money(paymentSummary.NetTotal)</td>
                    </tr>
                </tbody>
            </table>
        </div>
        @foreach (var warning in paymentSummary.Warnings)
        {
            <div role="alert">
                <Banner Variant="warn">@warning.Message Registros afectados: @warning.Count.</Banner>
            </div>
        }
    </PaymentBreakdown>

    @if (cashRegister != null)
    {
        var movements = CashService.GetCurrentMovements();
        <section class="card stack" aria-labelledby="cash-ledger-title">
            <div>
                <h2 id="cash-ledger-title" class="card__title">Movimientos de esta caja (@movements.Count)</h2>
                <p class="card__desc">Libro cronológico de entradas y salidas de efectivo en la sesión #@cashRegister.Id.</p>
            </div>
            @if (movements.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state__icon"><Icon Name="cash" Size="24" /></div>
                    <div class="stack stack--sm">
                        <h3>Sin movimientos registrados</h3>
                        <p class="text-sm text-secondary">No hay movimientos registrados. Las ventas en efectivo y los movimientos manuales aparecerán en esta tabla.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="table-wrapper" style="overflow-x: auto;" tabindex="0" role="region" aria-labelledby="cash-ledger-title">
                    <table class="data-table data-table--stack">
                        <thead>
                            <tr>
                                <th scope="col">ID / Fecha</th>
                                <th scope="col">Tipo</th>
                                <th scope="col">Motivo</th>
                                <th scope="col">Responsable</th>
                                <th scope="col">Venta</th>
                                <th scope="col" class="col-num">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var movement in movements)
                            {
                                var sign = movement.Type == CashMovementType.Expense || movement.Type == CashMovementType.Withdrawal || movement.Type == CashMovementType.Refund ? "−" : "+";
                                <tr @key="movement.Id">
                                    <th scope="row">#@movement.Id <span class="text-xs text-muted fw-600">· @movement.Date.ToString("dd/MM/yyyy HH:mm")</span></th>
                                    <td data-label="Tipo"><Badge Variant="@MovementVariant(movement.Type)" Label="@MovementLabel(movement.Type)" /></td>
                                    <td data-label="Motivo">@(string.IsNullOrWhiteSpace(movement.Reason) ? "Sin motivo registrado" : movement.Reason)</td>
                                    <td data-label="Responsable">@(string.IsNullOrWhiteSpace(movement.Username) ? "Sin responsable registrado" : movement.Username) @(movement.UserId.HasValue ? $"(ID {movement.UserId})" : "")</td>
                                    <td data-label="Venta">@(movement.SaleId?.ToString() ?? "—")</td>
                                    <td data-label="Monto" class="col-num fw-700 @(sign == "−" ? "text-danger" : "text-ok")">@sign@PosFormat.Money(movement.Amount)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }
</div>

<Toast @ref="toast" />

@code {
    private const string ProgrammaticClose = "sync";

    private CashRegister? cashRegister;
    private decimal initialAmount;
    private sealed class CountRow
    {
        public string Denomination { get; set; } = string.Empty;
        public string Quantity { get; set; } = string.Empty;
    }

    private readonly List<CountRow> countRows = new() { new CountRow() };
    private CashCountReview? countReview; // Snapshot the counter reviewed; refreshed only explicitly.
    private string? countReason;
    private bool confirmingClose;
    private bool zeroConfirmed;
    private string? countNotice;
    private string? closeMessage;
    private string? cashError;
    private string? countError; // Count-flow errors render inside the arqueo card (or its confirmation dialog).
    private CashMovementType movementType = CashMovementType.Income;
    private string movementAmount = string.Empty;
    private string? movementReason;
    private string? movementMessage;

    // The confirmation dialog mirrors confirmingClose: opened/closed after render, never from the handlers,
    // so every handler stays a plain synchronous state change.
    private Toast? toast;
    private ModalDialog? closeDialog;
    private bool dialogHostRendered;
    private bool dialogWanted;
    private bool dialogShown;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!dialogHostRendered || closeDialog is null)
        {
            dialogShown = false; // The dialog left the tree together with its host (session closed elsewhere).
            return;
        }
        try
        {
            if (dialogWanted && !dialogShown)
            {
                dialogShown = true;
                await closeDialog.ShowAsync();
            }
            else if (!dialogWanted && dialogShown)
            {
                dialogShown = false;
                await closeDialog.CloseAsync(ProgrammaticClose);
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            // Circuit already gone; nothing to show or close.
        }
    }

    // Esc, "Volver a editar" or the header close button: back to editing without closing the session.
    private Task HandleCloseDialogClosed(string returnValue)
    {
        dialogShown = false;
        if (returnValue != ProgrammaticClose && confirmingClose) ResetConfirmation();
        return Task.CompletedTask;
    }

    private static string MovementLabel(CashMovementType type) => type switch
    {
        CashMovementType.Sale => "Venta",
        CashMovementType.Income => "Ingreso",
        CashMovementType.Expense => "Gasto",
        CashMovementType.Withdrawal => "Retiro",
        CashMovementType.Refund => "Devolución",
        _ => "Tipo desconocido"
    };

    private static string MovementVariant(CashMovementType type) => type switch
    {
        CashMovementType.Sale or CashMovementType.Income => "ok",
        CashMovementType.Refund => "warn",
        _ => "danger"
    };

    private void RecordMovement()
    {
        if (!EnsureAdmin()) return;
        cashError = null;
        movementMessage = null;
        // Resolve again at click time; a singleton service must never retain circuit auth.
        var actor = AuthService.CurrentUser;
        if (actor == null || actor.Role != UserRole.Admin)
        {
            EnsureAdmin();
            return;
        }
        if (!decimal.TryParse(movementAmount, NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint
            | NumberStyles.AllowLeadingWhite | NumberStyles.AllowTrailingWhite, CultureInfo.CurrentCulture, out var amount)
            || amount <= 0m)
        {
            cashError = "Ingresá un monto decimal válido mayor que cero, sin separador de miles.";
            return;
        }
        try
        {
            CashService.AddManualMovement(movementType, amount, movementReason, actor);
            cashRegister = CashService.GetCurrent();
            movementMessage = $"{MovementLabel(movementType)} de {PosFormat.Money(amount)} registrado en caja.";
            movementAmount = string.Empty;
            movementReason = null;
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            cashError = ex.Message;
            cashRegister = CashService.GetCurrent();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!EnsureAdmin()) return;

        cashRegister = CashService.GetCurrent();
        if (cashRegister?.IsOpen == true) countReview = TryGetFreshReview();
        await Task.CompletedTask;
    }

    private bool EnsureAdmin()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return false;
        }
        if (!AuthService.IsInRole(UserRole.Admin))
        {
            Navigation.NavigateTo("/unauthorized");
            return false;
        }
        return true;
    }

    private void OpenCash()
    {
        if (!EnsureAdmin()) return;
        cashError = null;
        try
        {
            var opened = initialAmount;
            CashService.Open(opened);
            cashRegister = CashService.GetCurrent();
            initialAmount = 0;
            closeMessage = null;
            ResetCountForm();
            countReview = TryGetFreshReview();
            toast?.Show($"Caja #{cashRegister?.Id} abierta con {PosFormat.Money(opened)}.");
        }
        catch (InvalidOperationException ex) { cashError = ex.Message; }
    }

    private const NumberStyles DecimalStyles = NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint
        | NumberStyles.AllowLeadingWhite | NumberStyles.AllowTrailingWhite;
    private const NumberStyles IntegerStyles = NumberStyles.AllowLeadingSign
        | NumberStyles.AllowLeadingWhite | NumberStyles.AllowTrailingWhite;

    private static bool IsBlank(CountRow row) =>
        string.IsNullOrWhiteSpace(row.Denomination) && string.IsNullOrWhiteSpace(row.Quantity);

    // Raw-text parsing only; value rules (positive denomination, quantity, duplicates) live in the service.
    private static string? ParseRow(CountRow row, out CashCountLineInput? input)
    {
        input = null;
        if (IsBlank(row)) return null;
        if (string.IsNullOrWhiteSpace(row.Denomination)) return "Indicá la denominación.";
        if (string.IsNullOrWhiteSpace(row.Quantity)) return "Indicá la cantidad.";
        if (!decimal.TryParse(row.Denomination, DecimalStyles, CultureInfo.CurrentCulture, out var denomination))
            return "La denominación no es un número decimal válido, sin separador de miles.";
        if (!int.TryParse(row.Quantity, IntegerStyles, CultureInfo.CurrentCulture, out var quantity))
            return "La cantidad debe ser un número entero.";
        input = new CashCountLineInput(denomination, quantity);
        return null;
    }

    private bool TryBuildLines(out List<CashCountLineInput> lines, out string? error)
    {
        lines = new List<CashCountLineInput>();
        error = null;
        for (var i = 0; i < countRows.Count; i++)
        {
            var rowError = ParseRow(countRows[i], out var input);
            if (rowError != null)
            {
                error = $"Fila {i + 1}: {rowError}";
                return false;
            }
            if (input != null) lines.Add(input);
        }
        return true;
    }

    private (CashCountPreview? Preview, string? Error) BuildPreview()
    {
        if (countReview == null) return (null, null);
        if (!TryBuildLines(out var lines, out _)) return (null, "Corregí las filas marcadas antes de continuar.");
        try { return (CashService.PreviewCount(lines, countReview.ExpectedAmount), null); }
        catch (InvalidOperationException ex) { return (null, ex.Message); }
    }

    private CashCountReview? TryGetFreshReview()
    {
        try { return CashService.GetCountReview(); }
        catch (InvalidOperationException) { return null; }
    }

    private string StaleText(CashCountReview? fresh) => countReview == null || fresh == null
        ? "No se pudo verificar el saldo esperado. Actualizá el saldo esperado para continuar."
        : StaleMessage(countReview, fresh);

    private static string StaleMessage(CashCountReview before, CashCountReview now) =>
        $"El saldo esperado cambió mientras contabas (antes {PosFormat.Money(before.ExpectedAmount)}, ahora {PosFormat.Money(now.ExpectedAmount)}). Revisá el arqueo nuevamente.";

    private static string DifferenceLabel(decimal difference) =>
        difference < 0m ? "Faltante" : difference > 0m ? "Sobrante" : "Exacto";

    private static string DifferenceText(decimal difference) =>
        difference == 0m ? DifferenceLabel(difference) : $"{DifferenceLabel(difference)} ({CashFormat.SignedMoney(difference)})";

    private void ResetConfirmation()
    {
        confirmingClose = false;
        zeroConfirmed = false;
    }

    private void ResetCountForm()
    {
        countRows.Clear();
        countRows.Add(new CountRow());
        countReason = null;
        countNotice = null;
        countError = null;
        ResetConfirmation();
    }

    private void AddCountRow()
    {
        countRows.Add(new CountRow());
        ResetConfirmation();
    }

    private void RemoveCountRow(CountRow row)
    {
        countRows.Remove(row);
        if (countRows.Count == 0) countRows.Add(new CountRow());
        ResetConfirmation();
    }

    private void RefreshCountReview()
    {
        if (!EnsureAdmin()) return;
        countError = null;
        countNotice = null;
        ResetConfirmation();
        countReview = TryGetFreshReview();
        if (countReview == null) countError = "No hay caja abierta";
        else toast?.Show("Saldo esperado actualizado.");
    }

    // Step one: validate everything the user can fix, then show the confirmation dialog.
    private void ReviewClose()
    {
        if (!EnsureAdmin()) return;
        countError = null;
        countNotice = null;
        ResetConfirmation();
        var actor = AuthService.CurrentUser;
        if (actor == null || actor.Role != UserRole.Admin)
        {
            EnsureAdmin();
            return;
        }
        cashRegister = CashService.GetCurrent();
        if (cashRegister?.IsOpen != true)
        {
            countError = "No hay caja abierta";
            return;
        }
        var fresh = TryGetFreshReview();
        if (countReview == null || fresh == null || fresh != countReview)
        {
            countNotice = StaleText(fresh);
            return;
        }
        if (!TryBuildLines(out var lines, out var rowError))
        {
            countError = rowError;
            return;
        }
        try
        {
            var preview = CashService.PreviewCount(lines, countReview.ExpectedAmount);
            if (preview.Difference != 0m && string.IsNullOrWhiteSpace(countReason))
            {
                countError = "Debe indicar un motivo para la diferencia.";
                return;
            }
        }
        catch (InvalidOperationException ex)
        {
            countError = ex.Message;
            return;
        }
        confirmingClose = true;
    }

    // Step two: the service revalidates actor, session, review, lines, reason and confirmations.
    private void CloseCash()
    {
        if (!EnsureAdmin()) return;
        countError = null;
        // Resolve again at click time; a singleton service must never retain circuit auth.
        var actor = AuthService.CurrentUser;
        if (actor == null || actor.Role != UserRole.Admin)
        {
            EnsureAdmin();
            return;
        }
        var reviewed = countReview;
        if (!confirmingClose || reviewed == null)
        {
            countError = "Revisá el cierre antes de confirmarlo.";
            return;
        }
        if (!TryBuildLines(out var lines, out var rowError))
        {
            countError = rowError;
            ResetConfirmation();
            return;
        }
        try
        {
            CashService.Close(new CashCountRequest
            {
                Review = reviewed, Lines = lines, Reason = countReason,
                Confirmed = true, ZeroCountConfirmed = zeroConfirmed
            }, actor);
            cashRegister = CashService.GetCurrent();
            countReview = null;
            ResetCountForm();
            closeMessage = "Caja cerrada. Arqueo registrado.";
        }
        catch (CashCountReviewOutdatedException ex)
        {
            ResetConfirmation();
            countNotice = StaleMessage(reviewed, ex.Current);
            countReview = ex.Current;
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            countError = ex.Message;
            cashRegister = CashService.GetCurrent();
        }
    }
}
