@page "/product-categories"
@using GastroApp.Models
@using GastroApp.Services
@using GastroApp.Shared.Catalog
@inject ProductCategoryService CategoryService
@inject ProductService ProductService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Categorías de productos</PageTitle>

@if (AuthService.IsAuthenticated && AuthService.IsInRole(UserRole.Admin))
{
    <CatalogView ActiveTab="CatalogTab.Categories" ProductCount="products.Count" CategoryCount="categories.Count">
        <HeaderActions>
            <button type="button" class="btn btn--primary" @onclick="ShowAddForm">
                <Icon Name="plus" Size="17" />
                <span>Nueva categoría</span>
            </button>
        </HeaderActions>
        <ChildContent>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <Banner Variant="danger">@errorMessage</Banner>
            }

            <p class="text-sm text-secondary">Para eliminar una categoría, primero quitá o cambiá su asignación en los productos.</p>

            @if (categories.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state__icon"><Icon Name="tag" Size="24" /></div>
                    <div class="stack stack--sm">
                        <h3>No hay categorías</h3>
                        <p class="text-sm text-secondary">Creá la primera para agrupar tus productos.</p>
                    </div>
                    <div class="mt-2">
                        <button type="button" class="btn btn--primary" @onclick="ShowAddForm">Crear categoría</button>
                    </div>
                </div>
            }
            else
            {
                <div class="table-wrapper" tabindex="0" role="region" aria-label="Tabla de categorías">
                    <table class="data-table data-table--stack">
                        <thead>
                            <tr>
                                <th scope="col">Categoría</th>
                                <th scope="col" class="col-num">Productos asignados</th>
                                <th scope="col" class="col-actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in categories)
                            {
                                <tr @key="category.Id">
                                    <th scope="row">@category.Name</th>
                                    <td data-label="Productos" class="col-num">@products.Count(p => p.CategoryId == category.Id)</td>
                                    <td class="col-actions">
                                        <div class="flex-wrap-gap catalog-actions">
                                            <button type="button" class="btn btn--sm" aria-label="@($"Editar categoría {category.Name}")" @onclick="() => EditCategory(category)">Editar</button>
                                            <button type="button" class="btn btn--danger-outline btn--sm" aria-label="@($"Eliminar categoría {category.Name}")" @onclick="() => DeleteCategory(category.Id)">Eliminar</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </ChildContent>
    </CatalogView>

    <ModalDialog @ref="formDialog" Title="@(editingCategory.Id == 0 ? "Nueva categoría" : "Editar categoría")" LightDismiss="false" OnClosed="HandleFormClosed">
        <ChildContent>
            <form id="category-form" class="stack catalog-dialog" novalidate @onsubmit="SaveCategory">
                @if (!string.IsNullOrEmpty(formError))
                {
                    <Banner Variant="danger">@formError</Banner>
                }
                <div class="field">
                    <label class="field__label" for="category-name">Nombre <span class="field__req" aria-hidden="true">*</span></label>
                    <input id="category-name" type="text" class="input" required autocomplete="off" placeholder="Ej: Bebidas" @bind="editingCategory.Name" />
                </div>
            </form>
        </ChildContent>
        <Footer>
            <button value="cancel" class="btn">Cancelar</button>
            <button type="submit" form="category-form" class="btn btn--primary">Guardar</button>
        </Footer>
    </ModalDialog>

    <Toast @ref="toast" />
}

@code {
    private List<ProductCategory> categories = new();
    private List<Product> products = new();
    private ProductCategory editingCategory = new();
    private string errorMessage = string.Empty;
    private string formError = string.Empty;
    private ModalDialog? formDialog;
    private Toast? toast;

    protected override void OnInitialized()
    {
        if (EnsureAdmin()) LoadCategories();
    }

    private bool EnsureAdmin()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return false;
        }

        if (!AuthService.IsInRole(UserRole.Admin))
        {
            Navigation.NavigateTo("/unauthorized");
            return false;
        }

        return true;
    }

    private void LoadCategories()
    {
        categories = CategoryService.GetAll();
        products = ProductService.GetAll();
    }

    private async Task ShowAddForm()
    {
        if (!EnsureAdmin()) return;
        editingCategory = new ProductCategory();
        errorMessage = string.Empty;
        formError = string.Empty;
        await OpenFormAsync();
    }

    private async Task EditCategory(ProductCategory category)
    {
        if (!EnsureAdmin()) return;
        editingCategory = new ProductCategory { Id = category.Id, Name = category.Name };
        errorMessage = string.Empty;
        formError = string.Empty;
        await OpenFormAsync();
    }

    private Task OpenFormAsync() => formDialog is null ? Task.CompletedTask : formDialog.ShowAsync();

    private async Task SaveCategory()
    {
        if (!EnsureAdmin()) return;
        formError = string.Empty;
        var creating = editingCategory.Id == 0;
        try
        {
            if (creating)
                CategoryService.Add(editingCategory);
            else
                CategoryService.Update(editingCategory);
        }
        catch (ArgumentException ex)
        {
            formError = ex.Message;
            return;
        }
        catch (InvalidOperationException ex)
        {
            formError = ex.Message;
            return;
        }

        errorMessage = string.Empty;
        LoadCategories();
        if (formDialog is not null) await formDialog.CloseAsync("saved");
        toast?.Show(creating ? "Categoría creada." : "Categoría actualizada.");
    }

    private void DeleteCategory(int id)
    {
        if (!EnsureAdmin()) return;
        errorMessage = string.Empty;
        try
        {
            var name = categories.FirstOrDefault(c => c.Id == id)?.Name;
            CategoryService.Delete(id);
            LoadCategories();
            if (name is not null) toast?.Show($"Categoría «{name}» eliminada.");
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void HandleFormClosed(string _)
    {
        editingCategory = new ProductCategory();
        formError = string.Empty;
    }
}
