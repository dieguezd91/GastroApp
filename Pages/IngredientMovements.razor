@page "/ingredients/movements"
@page "/ingredients/{IngredientId:int}/movements"
@using GastroApp.Models
@using GastroApp.Services
@using GastroApp.Shared.Inventory
@inject IngredientService IngredientService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Movimientos de stock</PageTitle>

@if (AuthService.IsAuthenticated && AuthService.IsInRole(UserRole.Admin))
{
    <InventoryView ActiveTab="InventoryTab.Movements" AlertCount="alertCount">
        <ChildContent>
            @if (IngredientId.HasValue && ingredient == null && !IsDeleted())
            {
                <Banner Variant="danger">
                    <ChildContent>@(notFoundMessage ?? $"No existe un ingrediente con el ID {IngredientId}.") <a href="/ingredients/movements">Ver los movimientos de todos los ingredientes</a></ChildContent>
                </Banner>
            }
            else
            {
                @if (IsDeleted())
                {
                    <section class="card card--compact row-between" aria-label="Ingrediente eliminado">
                        <div>
                            <h2 class="card__title">Historial de stock: @DeletedTitle()</h2>
                            <p class="text-sm text-secondary">El ingrediente ya no existe; se conserva su historial de movimientos.</p>
                        </div>
                        <div class="flex-wrap-gap">
                            <Badge Variant="neutral" Label="Eliminado" />
                            <a href="/ingredients/movements" class="btn btn--sm">Ver todos los ingredientes</a>
                        </div>
                    </section>
                }
                @if (ingredient != null)
                {
                    var status = InventoryFormat.StatusOf(ingredient);
                    <section class="card card--compact row-between" aria-label="Ingrediente seleccionado">
                        <div>
                            <h2 class="card__title">Historial de stock: @ingredient.Name</h2>
                            <p class="text-sm text-secondary">
                                Stock actual: <strong>@InventoryFormat.Qty(ingredient.CurrentStock, ingredient.Unit)</strong>
                                @if (ingredient.MinStock > 0)
                                {
                                    <span class="text-muted"> (Mín: @InventoryFormat.Qty(ingredient.MinStock, ingredient.Unit))</span>
                                }
                            </p>
                        </div>
                        <div class="flex-wrap-gap">
                            @if (ingredient.IsActive)
                            {
                                <Badge Variant="@status.Variant" Icon="@status.Icon" Label="@status.Label" />
                            }
                            else
                            {
                                <Badge Variant="neutral" Label="Inactivo" />
                            }
                            <a href="/ingredients/movements" class="btn btn--sm">Ver todos los ingredientes</a>
                        </div>
                    </section>
                    @if (ingredient.CurrentStock < 0)
                    {
                        <Banner Variant="danger" Title="Stock negativo: requiere ajuste">
                            <ChildContent>Registrá un ajuste de stock o un conteo físico para regularizarlo.</ChildContent>
                            <Actions><a href="/ingredients" class="btn btn--sm">Ir a Stock y alertas</a></Actions>
                        </Banner>
                    }
                    @if (legacyBalance.HasValue)
                    {
                        <Banner Variant="warn" Title="@($"Saldo previo sin historial: {InventoryFormat.Qty(legacyBalance.Value, ingredient.Unit)}")">
                            <ChildContent>Es el stock anterior al primer movimiento registrado.</ChildContent>
                        </Banner>
                    }
                }

                <search class="card card--compact stack stack--sm" aria-label="Filtros de movimientos">
                    <div class="form-grid">
                        <div class="field">
                            <label class="field__label" for="mov-ingredient">Ingrediente</label>
                            <select id="mov-ingredient" class="select select--compact" value="@(IngredientId?.ToString() ?? string.Empty)" @onchange="SelectIngredient">
                                <option value="">Todos los ingredientes</option>
                                @foreach (var option in allIngredients)
                                {
                                    <option value="@option.Id">@option.Name (@option.Unit)</option>
                                }
                                @foreach (var deletedId in deletedIds)
                                {
                                    <option value="@deletedId">@IngredientService.DeletedName(deletedId)</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label class="field__label" for="mov-type">Causa</label>
                            <select id="mov-type" class="select select--compact" @bind="filterType" @bind:after="ApplyFilters">
                                <option value="">Todas</option>
                                @foreach (var type in Enum.GetValues<StockMovementType>())
                                {
                                    <option value="@type">@StockMovementLabels.GetLabel(type)</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label class="field__label" for="mov-from">Desde</label>
                            <input id="mov-from" type="date" class="input input--compact" @bind="filterFrom" @bind:after="ApplyFilters" />
                        </div>
                        <div class="field">
                            <label class="field__label" for="mov-to">Hasta</label>
                            <input id="mov-to" type="date" class="input input--compact" @bind="filterTo" @bind:after="ApplyFilters" />
                        </div>
                    </div>
                    @if (historyError != null)
                    {
                        <Banner Variant="danger">@historyError</Banner>
                    }
                    <div class="flex-wrap-gap">
                        <button type="button" class="btn btn--sm" @onclick="ClearFilters">Limpiar filtros</button>
                        <span class="text-xs text-muted" role="status">@movements.Count movimiento(s)</span>
                    </div>
                </search>

                @if (historyError == null && movements.Count == 0)
                {
                    <div class="empty-state">
                        <div class="empty-state__icon"><Icon Name="history" Size="24" /></div>
                        <div class="stack stack--sm">
                            <h3>No hay movimientos para los filtros seleccionados</h3>
                            <p class="text-sm text-secondary">Probá seleccionando todos los ingredientes o todas las causas.</p>
                        </div>
                    </div>
                }
                else if (movements.Count > 0)
                {
                    <div class="table-wrapper" tabindex="0" role="region" aria-label="Movimientos históricos de inventario">
                        <table class="data-table data-table--stack">
                            <thead>
                                <tr>
                                    <th scope="col">Fecha</th>
                                    <th scope="col">Ingrediente</th>
                                    <th scope="col">Tipo</th>
                                    <th scope="col" class="col-num">Variación</th>
                                    <th scope="col" class="col-num">Anterior → posterior</th>
                                    <th scope="col">Motivo / responsable / origen</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var movement in VisibleMovements())
                                {
                                    var href = OriginHref(movement);
                                    <tr @key="movement.Id">
                                        <th scope="row">@movement.Date.ToString("dd/MM/yyyy HH:mm")</th>
                                        <td data-label="Ingrediente" class="fw-600">
                                            @if (IngredientId.HasValue)
                                            {
                                                @IngredientName(movement)
                                            }
                                            else
                                            {
                                                <a href="/ingredients/@movement.IngredientId/movements">@IngredientName(movement)</a>
                                            }
                                        </td>
                                        <td data-label="Tipo">
                                            <Badge Variant="@InventoryFormat.MovementVariant(movement)" Label="@StockMovementLabels.GetLabel(movement.Type)" />
                                            @if (movement.WasteCategory.HasValue)
                                            {
                                                <span class="text-xs text-muted">@StockMovementLabels.GetLabel(movement.WasteCategory.Value)</span>
                                            }
                                        </td>
                                        <td data-label="Variación" class="col-num fw-700 @(movement.Quantity > 0 ? "text-ok" : "text-danger")">@SignedQuantity(movement)</td>
                                        <td data-label="Saldo" class="col-num">@InventoryFormat.Number(movement.PreviousStock) → <strong>@InventoryFormat.Number(movement.ResultingStock) @movement.Unit</strong></td>
                                        <td data-label="Motivo">
                                            <div>@(movement.Reason ?? "—")</div>
                                            <div class="flex-wrap-gap text-xs text-muted">
                                                <span>@ResponsibleLabel(movement)</span>
                                                @if (href != null)
                                                {
                                                    <a href="@href">@OriginText(movement)</a>
                                                }
                                                else
                                                {
                                                    <span>@OriginText(movement)</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <nav class="row-between" aria-label="Paginación de movimientos">
                        <button type="button" class="btn btn--sm" @onclick="PreviousPage" disabled="@(pageNumber <= 1)">← Anterior</button>
                        <span class="text-sm text-secondary">Página @pageNumber de @TotalPages() (@movements.Count movimientos)</span>
                        <button type="button" class="btn btn--sm" @onclick="NextPage" disabled="@(pageNumber >= TotalPages())">Siguiente →</button>
                    </nav>
                }
            }
        </ChildContent>
    </InventoryView>
}

@code {
    private const int PageSize = 20;

    /// <summary>Present on /ingredients/{id}/movements (ledger pre-filtered to one ingredient); absent on /ingredients/movements.</summary>
    [Parameter] public int? IngredientId { get; set; }

    private Ingredient? ingredient;
    private List<Ingredient> allIngredients = new();
    // IDs of deleted ingredients that still have movements (their history is kept).
    private List<int> deletedIds = new();
    private int alertCount;
    private string? notFoundMessage;
    // Movements that match the applied filters, newest first (one ingredient, or every ingredient without an id).
    private List<StockMovement> movements = new();
    private int pageNumber = 1;
    private decimal? legacyBalance;
    private DateTime? filterFrom;
    private DateTime? filterTo;
    private string filterType = string.Empty;
    private string? historyError;

    // Runs on first load and on every route change, so each navigation rechecks live permissions.
    protected override void OnParametersSet()
    {
        if (!EnsureAdmin()) return;
        allIngredients = IngredientService.GetAll().OrderBy(i => i.Name, StringComparer.CurrentCultureIgnoreCase).ToList();
        deletedIds = IngredientService.GetDeletedIngredientIdsWithHistory();
        alertCount = IngredientService.GetStockAlerts().Count;
        ingredient = IngredientId.HasValue ? IngredientService.GetById(IngredientId.Value) : null;
        notFoundMessage = null;
        legacyBalance = null;
        movements = new();
        if (IngredientId.HasValue && ingredient == null && !IsDeleted())
        {
            notFoundMessage = $"No existe un ingrediente con el ID {IngredientId}.";
            return;
        }
        ComputeLegacyBalance();
        ApplyFiltersCore();
    }

    private bool EnsureAdmin()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return false;
        }
        if (!AuthService.IsInRole(UserRole.Admin))
        {
            Navigation.NavigateTo("/unauthorized");
            return false;
        }
        return true;
    }

    // Stock that existed before the first recorded movement (legacy data or a history that starts above zero).
    // It does not depend on the filters, which only narrow what is listed.
    private void ComputeLegacyBalance()
    {
        legacyBalance = null;
        if (ingredient == null) return;
        var all = IngredientService.GetMovements(ingredient.Id);
        if (all.Count == 0)
        {
            if (ingredient.CurrentStock != 0m) legacyBalance = ingredient.CurrentStock;
            return;
        }
        var oldest = all[^1];
        if (oldest.PreviousStock != 0m) legacyBalance = oldest.PreviousStock;
    }

    private void ApplyFiltersCore()
    {
        historyError = null;
        pageNumber = 1;
        if (filterFrom.HasValue && filterTo.HasValue && filterFrom.Value.Date > filterTo.Value.Date)
        {
            movements = new();
            historyError = "La fecha inicial no puede ser posterior a la fecha final.";
            return;
        }
        var filter = new StockMovementFilter { From = filterFrom, To = filterTo };
        if (Enum.TryParse<StockMovementType>(filterType, out var type) && Enum.IsDefined(type))
            filter.Types = new[] { type };
        movements = IngredientId.HasValue
            ? IngredientService.GetMovements(IngredientId.Value, filter)
            : IngredientService.GetAllMovements(filter);
    }

    private void ApplyFilters()
    {
        if (!EnsureAdmin()) return;
        ApplyFiltersCore();
    }

    private void ClearFilters()
    {
        if (!EnsureAdmin()) return;
        filterFrom = null;
        filterTo = null;
        filterType = string.Empty;
        ApplyFiltersCore();
    }

    // The URL follows the ingredient filter (no reload): /ingredients/{id}/movements or /ingredients/movements.
    private void SelectIngredient(ChangeEventArgs args)
    {
        if (!EnsureAdmin()) return;
        var target = int.TryParse(args.Value?.ToString(), out var id) ? $"/ingredients/{id}/movements" : "/ingredients/movements";
        Navigation.NavigateTo(target);
    }

    private int TotalPages() => Math.Max(1, (movements.Count + PageSize - 1) / PageSize);

    private List<StockMovement> VisibleMovements() => movements.Skip((pageNumber - 1) * PageSize).Take(PageSize).ToList();

    private void PreviousPage()
    {
        if (!EnsureAdmin()) return;
        pageNumber = Math.Max(1, pageNumber - 1);
    }

    private void NextPage()
    {
        if (!EnsureAdmin()) return;
        pageNumber = Math.Min(TotalPages(), pageNumber + 1);
    }

    // A deleted ingredient keeps its movements but has no name left: they show "Ingrediente eliminado (#id)".
    private string IngredientName(StockMovement movement) =>
        allIngredients.FirstOrDefault(i => i.Id == movement.IngredientId)?.Name ?? IngredientService.DeletedName(movement.IngredientId);

    // /ingredients/{id}/movements of an ingredient that was deleted but still has history.
    private bool IsDeleted() => IngredientId.HasValue && ingredient == null && deletedIds.Contains(IngredientId.Value);

    private string DeletedTitle() => IngredientService.DeletedName(IngredientId ?? 0);

    private string SignedQuantity(StockMovement movement) => $"{movement.Quantity.ToString("+0.####;-0.####;0")} {movement.Unit}";

    private string ResponsibleLabel(StockMovement movement) =>
        string.IsNullOrWhiteSpace(movement.Username) ? "Sin registro" : movement.Username;

    private string OriginText(StockMovement movement)
    {
        if (movement.RefundId.HasValue)
            return movement.SaleId.HasValue ? $"Devolución #{movement.RefundId} (venta #{movement.SaleId})" : $"Devolución #{movement.RefundId}";
        if (movement.SaleId.HasValue) return $"Venta #{movement.SaleId}";
        if (movement.InvoiceId.HasValue) return $"Factura #{movement.InvoiceId}";
        if (movement.StockCountId.HasValue) return $"Conteo #{movement.StockCountId}";
        return movement.Type switch
        {
            StockMovementType.Adjustment or StockMovementType.Waste => "Manual",
            StockMovementType.InitialStock => "Alta del ingrediente",
            _ => "—"
        };
    }

    private string? OriginHref(StockMovement movement)
    {
        if (movement.SaleId.HasValue) return $"/sales/history/{movement.SaleId}";
        if (movement.InvoiceId.HasValue) return "/invoices";
        if (movement.StockCountId.HasValue) return $"/stock/count/{movement.StockCountId}";
        return null;
    }
}
