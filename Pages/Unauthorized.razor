@page "/unauthorized"
@using GastroApp.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Acceso Denegado</PageTitle>

<div class="status-stage">
    <section class="status-card" aria-labelledby="unauthorized-heading">
        <h1 id="unauthorized-heading">Acceso denegado</h1>

        <Banner Variant="danger" Title="No tenés permisos para ver esta pantalla">
            No tenés permisos para acceder a esta página.
            @if (AuthService.IsAuthenticated)
            {
                <text> Usuario actual: <strong>@AuthService.CurrentUser?.Username</strong> (@AuthService.CurrentUser?.Role).</text>
            }
        </Banner>

        <div class="flex-wrap-gap">
            <button type="button" class="btn btn--primary" @onclick="GoHome">Volver al Inicio</button>
            @if (AuthService.IsAuthenticated)
            {
                <button type="button" class="btn" @onclick="HandleLogout">Cerrar Sesión</button>
            }
        </div>
    </section>
</div>

@code {
    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }

    private void HandleLogout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/login");
    }
}
