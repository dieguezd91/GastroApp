@page "/ingredients"
@using GastroApp.Models
@using GastroApp.Services
@using GastroApp.Shared.Inventory
@inject IngredientService IngredientService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Ingredientes y stock</PageTitle>

@if (AuthService.IsAuthenticated && AuthService.IsInRole(UserRole.Admin))
{
    <InventoryView ActiveTab="InventoryTab.Stock" AlertCount="alerts?.Count ?? 0">
        <HeaderActions>
            <button type="button" class="btn btn--primary" @onclick="ShowAddForm">
                <Icon Name="plus" Size="17" />
                <span>Nuevo ingrediente</span>
            </button>
        </HeaderActions>
        <ChildContent>
            <section class="card stack stock-alerts" aria-labelledby="stock-alerts-heading">
                <div>
                    <h2 id="stock-alerts-heading" class="card__title">Alertas de stock@(alerts is { Count: > 0 } ? $" ({alerts.Count})" : string.Empty)</h2>
                    <p class="card__desc">Ingredientes activos agotados o por debajo del mínimo configurado, con cobertura estimada según el consumo reciente.</p>
                </div>
                @if (alerts == null || alerts.Count == 0)
                {
                    <Banner Variant="ok">Sin alertas de stock: ningún ingrediente activo está agotado ni bajo su mínimo.</Banner>
                }
                else
                {
                    <div class="table-wrapper" tabindex="0" role="region" aria-labelledby="stock-alerts-heading">
                        <table class="data-table data-table--stack">
                            <thead>
                                <tr>
                                    <th scope="col">Ingrediente</th>
                                    <th scope="col">Estado</th>
                                    <th scope="col" class="col-num">Stock actual</th>
                                    <th scope="col" class="col-num">Mínimo</th>
                                    <th scope="col">Cobertura estimada (consumo de @alerts[0].Days días)</th>
                                    <th scope="col" class="col-actions">Acción rápida</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alert in alerts)
                                {
                                    <tr @key="alert.IngredientId">
                                        <th scope="row"><a href="/ingredients/@alert.IngredientId/movements">@alert.Name</a></th>
                                        <td data-label="Estado">
                                            @if (alert.Level == StockAlertLevel.OutOfStock)
                                            {
                                                <Badge Variant="danger" Icon="alertOctagon" Label="Agotado" />
                                            }
                                            else
                                            {
                                                <Badge Variant="warn" Icon="alertTriangle" Label="Bajo mínimo" />
                                            }
                                            @if (alert.IsNegative)
                                            {
                                                <span class="stock-warning text-xs text-danger fw-700" role="alert">Stock negativo: requiere ajuste</span>
                                            }
                                        </td>
                                        <td data-label="Actual" class="col-num fw-700">@InventoryFormat.Qty(alert.CurrentStock, alert.Unit)</td>
                                        <td data-label="Mínimo" class="col-num">@InventoryFormat.Qty(alert.MinStock, alert.Unit)</td>
                                        <td data-label="Cobertura">@CoverageText(alert)</td>
                                        <td class="col-actions">
                                            <button type="button" class="btn btn--primary btn--sm" aria-label="@($"Ajustar stock de {alert.Name}")"
                                                    @onclick="() => AdjustFromAlert(alert.IngredientId)">Ajustar stock</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <section class="card stack" aria-labelledby="all-ingredients-heading">
                <div>
                    <h2 id="all-ingredients-heading" class="card__title">Listado de ingredientes (@ingredients.Count)</h2>
                    <p class="card__desc">Cada ajuste manual o merma queda auditado en el libro de movimientos.</p>
                </div>

                @if (ingredients.Count == 0)
                {
                    <div class="empty-state">
                        <div class="empty-state__icon"><Icon Name="ingredients" Size="24" /></div>
                        <div class="stack stack--sm">
                            <h3>No hay ingredientes</h3>
                            <p class="text-sm text-secondary">Creá el primero para controlar recetas y stock.</p>
                        </div>
                        <button type="button" class="btn btn--primary" @onclick="ShowAddForm">Crear ingrediente</button>
                    </div>
                }
                else
                {
                    <div class="table-wrapper" tabindex="0" role="region" aria-labelledby="all-ingredients-heading">
                        <table class="data-table data-table--stack">
                            <thead>
                                <tr>
                                    <th scope="col">Ingrediente</th>
                                    <th scope="col">Estado</th>
                                    <th scope="col" class="col-num">Stock actual</th>
                                    <th scope="col" class="col-num">Mínimo</th>
                                    <th scope="col" class="col-num">Último precio</th>
                                    <th scope="col" class="col-actions">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ingredient in ingredients)
                                {
                                    var status = InventoryFormat.StatusOf(ingredient);
                                    var lastPrice = IngredientService.GetLastPrice(ingredient.Id);
                                    <tr @key="ingredient.Id">
                                        <th scope="row">
                                            <div>@ingredient.Name</div>
                                            @if (ingredient.CurrentStock < 0)
                                            {
                                                <div class="stock-warning text-xs text-danger fw-700" role="alert">Stock negativo: requiere ajuste</div>
                                            }
                                            @if (deleteErrorId == ingredient.Id && deleteError != null)
                                            {
                                                <div class="text-xs text-danger fw-700" role="alert">@deleteError</div>
                                            }
                                        </th>
                                        <td data-label="Estado">
                                            @if (ingredient.IsActive)
                                            {
                                                <Badge Variant="@status.Variant" Icon="@status.Icon" Label="@status.Label" />
                                            }
                                            else
                                            {
                                                <Badge Variant="neutral" Label="Inactivo" />
                                            }
                                        </td>
                                        <td data-label="Stock actual" class="col-num fw-700">@InventoryFormat.Qty(ingredient.CurrentStock, ingredient.Unit)</td>
                                        <td data-label="Mínimo" class="col-num">@InventoryFormat.Qty(ingredient.MinStock, ingredient.Unit)</td>
                                        <td data-label="Último precio" class="col-num">
                                            @if (lastPrice.HasValue)
                                            {
                                                @($"{InventoryFormat.Money(lastPrice.Value)} / {ingredient.Unit}")
                                            }
                                            else
                                            {
                                                <span class="text-muted">Sin precio registrado</span>
                                            }
                                        </td>
                                        <td class="col-actions">
                                            <div class="flex-wrap-gap inventory-actions">
                                                <button type="button" class="btn btn--sm" aria-label="@($"Ajustar stock de {ingredient.Name}")" title="Ajustar stock"
                                                        @onclick="() => ShowStockAdjust(ingredient)">Ajustar</button>
                                                <button type="button" class="btn btn--sm" aria-label="@($"Registrar merma de {ingredient.Name}")" title="Registrar merma"
                                                        @onclick="() => ShowWaste(ingredient)">Merma</button>
                                                <a class="btn btn--ghost btn--sm" href="/ingredients/@ingredient.Id/movements" aria-label="@($"Historial de movimientos de {ingredient.Name}")" title="Historial de movimientos">Historial</a>
                                                <button type="button" class="btn btn--ghost btn--sm" aria-label="@($"Editar {ingredient.Name}")" title="Editar"
                                                        @onclick="() => EditIngredient(ingredient)">Editar</button>
                                                <button type="button" class="btn btn--ghost btn--icon" aria-label="@($"Eliminar {ingredient.Name}")" title="Eliminar"
                                                        @onclick="() => ConfirmDelete(ingredient)">
                                                    <Icon Name="trash" Size="15" />
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </ChildContent>
    </InventoryView>

    <ModalDialog @ref="formDialog" Title="@(editingIngredient.Id == 0 ? "Nuevo ingrediente" : $"Editar ingrediente · {editingIngredient.Name}")"
                 LightDismiss="false" OnClosed="HandleFormClosed">
        <ChildContent>
            <form id="ingredient-form" class="stack" novalidate @onsubmit="SubmitIngredientAsync">
                @if (formError != null)
                {
                    <Banner Variant="danger">@formError</Banner>
                }
                <div class="field">
                    <label class="field__label" for="ingredient-name">Nombre <span class="field__req" aria-hidden="true">*</span></label>
                    <input id="ingredient-name" type="text" class="input" required autocomplete="off" placeholder="Ej: Harina" @bind="editingIngredient.Name" />
                </div>
                <div class="form-grid">
                    <div class="field">
                        <label class="field__label" for="ingredient-unit">Unidad de medida</label>
                        <select id="ingredient-unit" class="select" @bind="editingIngredient.Unit" disabled="@(!CanChangeUnit())">
                            <option value="kg">Kilogramo (kg)</option>
                            <option value="lt">Litro (lt)</option>
                            <option value="unidad">Unidad</option>
                            <option value="gr">Gramo (gr)</option>
                            <option value="ml">Mililitro (ml)</option>
                        </select>
                        @if (!CanChangeUnit())
                        {
                            <span class="field__hint">La unidad no puede cambiarse porque el ingrediente tiene stock o movimientos.</span>
                        }
                    </div>
                    <div class="field">
                        <label class="field__label" for="ingredient-min">Stock mínimo (alerta)</label>
                        <input id="ingredient-min" type="number" class="input tnum" step="any" placeholder="0" @bind="editingIngredient.MinStock" />
                    </div>
                </div>
                @if (editingIngredient.Id == 0)
                {
                    <div class="field">
                        <span class="field__label">Stock actual</span>
                        <span class="field__hint">El ingrediente se crea sin stock. El stock se carga con las <a href="/invoices">facturas de compra</a>.</span>
                    </div>
                }
                else
                {
                    <div class="field">
                        <span class="field__label">Stock actual</span>
                        <p class="fw-700">@InventoryFormat.Qty(LiveStock(editingIngredient.Id), editingIngredient.Unit)</p>
                        <span class="field__hint">El stock solo cambia con «Ajustar stock», «Registrar merma», compras, ventas o conteos, y queda en el historial.</span>
                    </div>
                }
                <label class="check-field" for="ingredient-active">
                    <input id="ingredient-active" type="checkbox" @bind="editingIngredient.IsActive" />
                    <span>Activo (disponible para nuevas recetas y alertas)</span>
                </label>
            </form>
        </ChildContent>
        <Footer>
            <button value="cancel" class="btn">Cancelar</button>
            <button type="submit" form="ingredient-form" class="btn btn--primary">Guardar</button>
        </Footer>
    </ModalDialog>

    <ModalDialog @ref="adjustDialog" Title="@($"Ajustar stock · {AdjustTarget?.Name}")"
                 Subtitle="@(AdjustTarget == null ? null : $"Stock actual: {InventoryFormat.Qty(AdjustTarget.CurrentStock, AdjustTarget.Unit)} · Mínimo: {InventoryFormat.Qty(AdjustTarget.MinStock, AdjustTarget.Unit)}")"
                 LightDismiss="false" OnClosed="HandleAdjustClosed">
        <ChildContent>
            @if (AdjustTarget is { } target)
            {
                var difference = GetAdjustDifference();
                <form id="adjust-form" class="stack" novalidate @onsubmit="SubmitAdjustAsync">
                    @if (adjustError != null)
                    {
                        <Banner Variant="danger">@adjustError</Banner>
                    }
                    <div class="field">
                        <label class="field__label" for="adjust-new">Nuevo stock (@target.Unit) <span class="field__req" aria-hidden="true">*</span></label>
                        <input id="adjust-new" type="number" class="input tnum" step="any" placeholder="Nuevo stock" autofocus
                               @bind="adjustNewStock" @bind:event="oninput" />
                    </div>
                    <div class="card card--compact card--subtle stack stack--sm" aria-live="polite">
                        <div class="row-between">
                            <span class="text-sm text-secondary">Diferencia resultante</span>
                            @if (difference.HasValue)
                            {
                                <strong class="tnum stock-difference @DifferenceClass(difference.Value)">@SignedAmount(difference.Value) @target.Unit</strong>
                            }
                            else
                            {
                                <span class="text-sm text-muted">Indicá el nuevo stock</span>
                            }
                        </div>
                        @if (difference.HasValue)
                        {
                            <span class="text-xs text-muted">El stock quedará en @InventoryFormat.Qty(adjustNewStock!.Value, target.Unit)</span>
                        }
                    </div>
                    <div class="field">
                        <label class="field__label" for="adjust-reason">Motivo del ajuste (obligatorio) <span class="field__req" aria-hidden="true">*</span></label>
                        <input id="adjust-reason" type="text" class="input" autocomplete="off" placeholder="Ej: conteo rápido, diferencia detectada" @bind="adjustReason" />
                    </div>
                    <label class="check-field" for="adjust-confirm">
                        <input id="adjust-confirm" type="checkbox" @bind="adjustConfirmed" />
                        <span>Confirmo el ajuste de stock</span>
                    </label>
                </form>
            }
        </ChildContent>
        <Footer>
            <button value="cancel" class="btn">Cancelar</button>
            <button type="submit" form="adjust-form" class="btn btn--primary">Confirmar ajuste</button>
        </Footer>
    </ModalDialog>

    <ModalDialog @ref="wasteDialog" Title="@($"Registrar merma · {WasteTarget?.Name}")"
                 Subtitle="@(WasteTarget == null ? null : $"Disponible: {InventoryFormat.Qty(WasteTarget.CurrentStock, WasteTarget.Unit)}")"
                 LightDismiss="false" OnClosed="HandleWasteClosed">
        <ChildContent>
            @if (WasteTarget is { } target)
            {
                <form id="waste-form" class="stack" novalidate @onsubmit="SubmitWasteAsync">
                    @if (wasteError != null)
                    {
                        <Banner Variant="danger">@wasteError</Banner>
                    }
                    <div class="form-grid">
                        <div class="field">
                            <label class="field__label" for="waste-qty">Cantidad perdida (@target.Unit) <span class="field__req" aria-hidden="true">*</span></label>
                            <input id="waste-qty" type="number" class="input tnum" step="any" placeholder="Cantidad" autofocus @bind="wasteQuantity" />
                        </div>
                        <div class="field">
                            <label class="field__label" for="waste-category">Categoría <span class="field__req" aria-hidden="true">*</span></label>
                            <select id="waste-category" class="select" @bind="wasteCategory">
                                <option value="">Seleccionar...</option>
                                @foreach (var category in Enum.GetValues<WasteCategory>())
                                {
                                    <option value="@category">@StockMovementLabels.GetLabel(category)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="field">
                        <label class="field__label" for="waste-reason">Motivo (obligatorio) <span class="field__req" aria-hidden="true">*</span></label>
                        <input id="waste-reason" type="text" class="input" autocomplete="off" placeholder="Ej: bolsa vencida, se cayó" @bind="wasteReason" />
                    </div>
                    <label class="check-field" for="waste-confirm">
                        <input id="waste-confirm" type="checkbox" @bind="wasteConfirmed" />
                        <span>Confirmo la merma</span>
                    </label>
                </form>
            }
        </ChildContent>
        <Footer>
            <button value="cancel" class="btn">Cancelar</button>
            <button type="submit" form="waste-form" class="btn btn--danger">Confirmar merma</button>
        </Footer>
    </ModalDialog>

    <ModalDialog @ref="deleteDialog" Title="@($"¿Eliminar «{pendingDelete?.Name}»?")" OnClosed="HandleDeleteClosed">
        <ChildContent>
            <p>Solo se pueden eliminar ingredientes sin movimientos, recetas ni facturas asociadas. Si los tiene, desactivalo en lugar de eliminarlo.</p>
        </ChildContent>
        <Footer>
            <button value="cancel" class="btn" autofocus>Cancelar</button>
            <button type="button" class="btn btn--danger" @onclick="ConfirmDeleteAsync">Eliminar ingrediente</button>
        </Footer>
    </ModalDialog>

    <Toast @ref="toast" />
}

@code {
    private List<Ingredient> ingredients = new();
    private IReadOnlyList<StockAlert>? alerts;
    private Ingredient editingIngredient = new();
    private bool showForm = false;
    private string? formError;
    private string? deleteError;
    private int deleteErrorId = 0;
    // Result of the last stock operation (adjustment or waste); also announced through the toast.
    private string? successMessage;
    private Ingredient? pendingDelete;

    // "Ajustar stock" dialog: the ingredient being adjusted (0 = closed).
    private int adjustIngredientId = 0;
    private decimal? adjustNewStock;
    private string? adjustReason;
    private bool adjustConfirmed;
    private string? adjustError;

    // "Registrar merma" dialog: the ingredient (0 = closed).
    private int wasteIngredientId = 0;
    private decimal? wasteQuantity;
    private WasteCategory? wasteCategory;
    private string? wasteReason;
    private bool wasteConfirmed;
    private string? wasteError;

    private ModalDialog? formDialog;
    private ModalDialog? adjustDialog;
    private ModalDialog? wasteDialog;
    private ModalDialog? deleteDialog;
    private Toast? toast;

    private Ingredient? AdjustTarget => adjustIngredientId == 0 ? null : IngredientService.GetById(adjustIngredientId);

    private Ingredient? WasteTarget => wasteIngredientId == 0 ? null : IngredientService.GetById(wasteIngredientId);

    protected override async Task OnInitializedAsync()
    {
        if (!EnsureAdmin()) return;

        LoadIngredients();
        await Task.CompletedTask;
    }

    private bool EnsureAdmin()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return false;
        }
        if (!AuthService.IsInRole(UserRole.Admin))
        {
            Navigation.NavigateTo("/unauthorized");
            return false;
        }
        return true;
    }

    private void LoadIngredients()
    {
        ingredients = IngredientService.GetAll();
        alerts = IngredientService.GetStockAlerts();
    }

    private decimal LiveStock(int id) => IngredientService.GetById(id)?.CurrentStock ?? 0m;

    // The unit is frozen once the ingredient has stock or movements (the service enforces it too).
    private bool CanChangeUnit()
    {
        if (editingIngredient.Id == 0) return true;
        var live = IngredientService.GetById(editingIngredient.Id);
        return live != null && live.CurrentStock == 0m && !IngredientService.HasMovements(live.Id);
    }

    private static string SignedAmount(decimal value) => value.ToString("+0.####;-0.####;0");

    private static string DifferenceClass(decimal difference) =>
        difference > 0m ? "text-ok" : difference < 0m ? "text-danger" : "text-muted";

    private static string CoverageText(StockAlert alert)
    {
        if (alert.RecentConsumption <= 0m) return "Sin consumo reciente";
        if (!alert.CoverageDays.HasValue) return "No calculable";
        return $"{alert.CoverageDays.Value:0.#} días (consumo {alert.RecentConsumption / alert.Days:0.##} {alert.Unit}/día)";
    }

    // ---- Alta / edición ----

    private async Task ShowAddForm()
    {
        if (!EnsureAdmin()) return;
        formError = null;
        editingIngredient = new Ingredient();
        showForm = true;
        if (formDialog is not null) await formDialog.ShowAsync();
    }

    private async Task EditIngredient(Ingredient ingredient)
    {
        if (!EnsureAdmin()) return;
        formError = null;
        editingIngredient = new Ingredient
        {
            Id = ingredient.Id,
            Name = ingredient.Name,
            Unit = ingredient.Unit,
            IsActive = ingredient.IsActive,
            CurrentStock = ingredient.CurrentStock, // display only: Update never writes stock
            MinStock = ingredient.MinStock
        };
        showForm = true;
        if (formDialog is not null) await formDialog.ShowAsync();
    }

    private void SaveIngredient()
    {
        if (!EnsureAdmin()) return;
        if (string.IsNullOrWhiteSpace(editingIngredient.Name))
        {
            formError = "El nombre del ingrediente es obligatorio.";
            return;
        }

        var creating = editingIngredient.Id == 0;
        try
        {
            if (creating)
            {
                IngredientService.Add(editingIngredient, AuthService.CurrentUser);
            }
            else
            {
                IngredientService.Update(editingIngredient);
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            if (EnsureAdmin()) formError = ex.Message;
            return;
        }

        var name = editingIngredient.Name;
        LoadIngredients();
        CancelEdit();
        toast?.Show(creating ? $"Ingrediente «{name}» creado." : $"Ingrediente «{name}» actualizado.");
    }

    private async Task SubmitIngredientAsync()
    {
        SaveIngredient();
        if (!showForm && formDialog is not null) await formDialog.CloseAsync("saved");
    }

    private void CancelEdit()
    {
        if (!EnsureAdmin()) return;
        showForm = false;
        formError = null;
        editingIngredient = new Ingredient();
    }

    private void HandleFormClosed(string _)
    {
        if (showForm) CancelEdit();
    }

    // ---- Eliminar ----

    private async Task ConfirmDelete(Ingredient ingredient)
    {
        if (!EnsureAdmin()) return;
        pendingDelete = ingredient;
        if (deleteDialog is not null) await deleteDialog.ShowAsync();
    }

    private void DeleteIngredient(int id)
    {
        if (!EnsureAdmin()) return;
        deleteError = null;
        deleteErrorId = 0;
        var name = IngredientService.GetById(id)?.Name;
        try
        {
            IngredientService.Delete(id);
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            if (EnsureAdmin())
            {
                deleteError = ex.Message;
                deleteErrorId = id;
            }
            return;
        }
        LoadIngredients();
        if (name != null) toast?.Show($"Ingrediente «{name}» eliminado.");
    }

    private async Task ConfirmDeleteAsync()
    {
        if (pendingDelete is not null) DeleteIngredient(pendingDelete.Id);
        if (deleteDialog is not null) await deleteDialog.CloseAsync("deleted");
    }

    private void HandleDeleteClosed(string _) => pendingDelete = null;

    // ---- Ajustar stock (S6): new stock, mandatory reason, difference preview and confirmation ----

    private async Task ShowStockAdjust(Ingredient ingredient)
    {
        if (!EnsureAdmin()) return;
        ResetDialogs();
        successMessage = null;
        adjustIngredientId = ingredient.Id;
        if (adjustDialog is not null) await adjustDialog.ShowAsync();
    }

    private async Task AdjustFromAlert(int ingredientId)
    {
        var ingredient = ingredients.FirstOrDefault(i => i.Id == ingredientId);
        if (ingredient is not null) await ShowStockAdjust(ingredient);
    }

    // Difference between the typed stock and the live stock, or null while nothing valid is typed.
    private decimal? GetAdjustDifference()
    {
        var ingredient = IngredientService.GetById(adjustIngredientId);
        if (ingredient == null || !adjustNewStock.HasValue) return null;
        try { return checked(adjustNewStock.Value - ingredient.CurrentStock); }
        catch (OverflowException) { return null; }
    }

    private void SaveStockAdjustment()
    {
        if (!EnsureAdmin()) return;
        adjustError = null;
        if (adjustIngredientId == 0) return;
        if (!adjustNewStock.HasValue)
        {
            adjustError = "Indique el nuevo stock.";
            return;
        }
        if (!adjustConfirmed)
        {
            adjustError = "Confirme el ajuste de stock para continuar.";
            return;
        }

        StockMovement movement;
        try
        {
            movement = IngredientService.AdjustStock(adjustIngredientId, adjustNewStock.Value, adjustReason, AuthService.CurrentUser);
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            if (EnsureAdmin()) adjustError = ex.Message;
            return;
        }
        var name = IngredientService.GetById(movement.IngredientId)?.Name;
        ResetDialogs();
        successMessage = $"Stock de {name} ajustado a {movement.ResultingStock} {movement.Unit} ({SignedAmount(movement.Quantity)}).";
        LoadIngredients();
        toast?.Show(successMessage);
    }

    private async Task SubmitAdjustAsync()
    {
        SaveStockAdjustment();
        if (adjustIngredientId == 0 && adjustDialog is not null) await adjustDialog.CloseAsync("saved");
    }

    private void CancelStockAdjustment()
    {
        if (!EnsureAdmin()) return;
        ResetDialogs();
    }

    private void HandleAdjustClosed(string _)
    {
        if (adjustIngredientId != 0) CancelStockAdjustment();
    }

    // ---- Registrar merma (S8): quantity, category, mandatory reason and confirmation ----

    private async Task ShowWaste(Ingredient ingredient)
    {
        if (!EnsureAdmin()) return;
        ResetDialogs();
        successMessage = null;
        wasteIngredientId = ingredient.Id;
        if (wasteDialog is not null) await wasteDialog.ShowAsync();
    }

    private void SaveWaste()
    {
        if (!EnsureAdmin()) return;
        wasteError = null;
        if (wasteIngredientId == 0) return;
        if (!wasteQuantity.HasValue)
        {
            wasteError = "Indique la cantidad de la merma.";
            return;
        }
        if (!wasteCategory.HasValue)
        {
            wasteError = "Debe seleccionar la categoría de la merma.";
            return;
        }
        if (!wasteConfirmed)
        {
            wasteError = "Confirme la merma para continuar.";
            return;
        }

        StockMovement movement;
        try
        {
            movement = IngredientService.RegisterWaste(wasteIngredientId, wasteQuantity.Value, wasteCategory.Value, wasteReason, AuthService.CurrentUser);
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            if (EnsureAdmin()) wasteError = ex.Message;
            return;
        }
        var name = IngredientService.GetById(movement.IngredientId)?.Name;
        ResetDialogs();
        successMessage = $"Merma de {-movement.Quantity} {movement.Unit} de {name} registrada; stock actual {movement.ResultingStock} {movement.Unit}.";
        LoadIngredients();
        toast?.Show(successMessage, "warn");
    }

    private async Task SubmitWasteAsync()
    {
        SaveWaste();
        if (wasteIngredientId == 0 && wasteDialog is not null) await wasteDialog.CloseAsync("saved");
    }

    private void CancelWaste()
    {
        if (!EnsureAdmin()) return;
        ResetDialogs();
    }

    private void HandleWasteClosed(string _)
    {
        if (wasteIngredientId != 0) CancelWaste();
    }

    private void ResetDialogs()
    {
        adjustIngredientId = 0;
        adjustNewStock = null;
        adjustReason = null;
        adjustConfirmed = false;
        adjustError = null;
        wasteIngredientId = 0;
        wasteQuantity = null;
        wasteCategory = null;
        wasteReason = null;
        wasteConfirmed = false;
        wasteError = null;
    }
}
