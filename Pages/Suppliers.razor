@page "/suppliers"
@using GastroApp.Models
@using GastroApp.Services
@using GastroApp.Shared.Purchasing
@inject SupplierService SupplierService
@inject InvoiceService InvoiceService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Proveedores</PageTitle>

@if (AuthService.IsAuthenticated && AuthService.IsInRole(UserRole.Admin))
{
    <PurchasingView ActiveTab="PurchasingTab.Suppliers" InvoiceCount="invoices.Count" SupplierCount="suppliers.Count">
        <HeaderActions>
            <button type="button" class="btn btn--primary" @onclick="ShowAddForm">
                <Icon Name="plus" Size="17" />
                <span>Nuevo proveedor</span>
            </button>
        </HeaderActions>
        <ChildContent>
            <SupplierList Suppliers="suppliers" Invoices="invoices" OnNew="ShowAddForm" OnEdit="EditSupplier" OnDelete="ConfirmDelete" />
        </ChildContent>
    </PurchasingView>

    <ModalDialog @ref="formDialog" Title="@(editingSupplier.Id == 0 ? "Nuevo proveedor" : $"Editar proveedor · {editingSupplier.Name}")" LightDismiss="false" OnClosed="HandleFormClosed">
        <ChildContent>
            <form id="supplier-form" class="stack" novalidate @onsubmit="SaveSupplier">
                @if (!string.IsNullOrEmpty(formError))
                {
                    <Banner Variant="danger">@formError</Banner>
                }
                <div class="field">
                    <label class="field__label" for="supplier-name">Nombre del proveedor <span class="field__req" aria-hidden="true">*</span></label>
                    <input id="supplier-name" type="text" class="input" required autocomplete="off" placeholder="Ej: Distribuidora XYZ" @bind="editingSupplier.Name" />
                </div>
                <div class="field">
                    <label class="field__label" for="supplier-cuit">CUIT <span class="field__req" aria-hidden="true">*</span></label>
                    <input id="supplier-cuit" type="text" class="input" required inputmode="numeric" autocomplete="off" placeholder="Ej: 30-71234567-1" @bind="editingSupplier.Cuit" />
                </div>
                <div class="field">
                    <label class="field__label" for="supplier-tax-condition">Condición frente al IVA <span class="field__req" aria-hidden="true">*</span></label>
                    <select id="supplier-tax-condition" class="select" required @bind="editingSupplier.TaxCondition">
                        <option value="">Seleccionar...</option>
                        @foreach (var condition in Enum.GetValues<TaxCondition>())
                        {
                            <option value="@condition">@FiscalRules.Label(condition)</option>
                        }
                    </select>
                </div>
            </form>
        </ChildContent>
        <Footer>
            <button value="cancel" class="btn">Cancelar</button>
            <button type="submit" form="supplier-form" class="btn btn--primary">@(editingSupplier.Id == 0 ? "Guardar proveedor" : "Guardar cambios")</button>
        </Footer>
    </ModalDialog>

    <ModalDialog @ref="deleteDialog" Title="@($"¿Eliminar a «{pendingDelete?.Name}»?")" Size="md" OnClosed="HandleDeleteClosed">
        <ChildContent>
            <p>@DeleteMessage()</p>
        </ChildContent>
        <Footer>
            <button value="cancel" class="btn" autofocus>Cancelar</button>
            <button type="button" class="btn btn--danger" @onclick="() => DeleteSupplier(pendingDelete?.Id ?? 0)">Eliminar proveedor</button>
        </Footer>
    </ModalDialog>

    <Toast @ref="toast" />
}

@code {
    private List<Supplier> suppliers = new();
    private List<Invoice> invoices = new();
    private Supplier editingSupplier = new();
    private Supplier? pendingDelete;
    private string formError = string.Empty;
    private ModalDialog? formDialog;
    private ModalDialog? deleteDialog;
    private Toast? toast;

    protected override async Task OnInitializedAsync()
    {
        if (!EnsureAdmin()) return;

        LoadSuppliers();
        await Task.CompletedTask;
    }

    private bool EnsureAdmin()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return false;
        }
        if (!AuthService.IsInRole(UserRole.Admin))
        {
            Navigation.NavigateTo("/unauthorized");
            return false;
        }
        return true;
    }

    private void LoadSuppliers()
    {
        suppliers = SupplierService.GetAll();
        invoices = InvoiceService.GetAll();
    }

    private async Task ShowAddForm()
    {
        if (!EnsureAdmin()) return;
        editingSupplier = new Supplier();
        formError = string.Empty;
        await OpenFormAsync();
    }

    private async Task EditSupplier(Supplier supplier)
    {
        if (!EnsureAdmin()) return;
        editingSupplier = new Supplier
        {
            Id = supplier.Id,
            Name = supplier.Name,
            Cuit = supplier.Cuit,
            TaxCondition = supplier.TaxCondition
        };
        formError = string.Empty;
        await OpenFormAsync();
    }

    private Task OpenFormAsync() => formDialog is null ? Task.CompletedTask : formDialog.ShowAsync();

    private async Task SaveSupplier()
    {
        if (!EnsureAdmin()) return;
        if (string.IsNullOrWhiteSpace(editingSupplier.Name))
        {
            formError = "Ingresá un nombre para el proveedor.";
            return;
        }

        formError = string.Empty;
        var creating = editingSupplier.Id == 0;
        try
        {
            if (creating)
            {
                SupplierService.Add(editingSupplier);
            }
            else
            {
                SupplierService.Update(editingSupplier);
            }
        }
        catch (InvalidOperationException ex)
        {
            formError = ex.Message;
            return;
        }

        LoadSuppliers();
        if (formDialog is not null) await formDialog.CloseAsync("saved");
        toast?.Show(creating ? "Proveedor agregado." : "Proveedor actualizado.");
    }

    private async Task ConfirmDelete(Supplier supplier)
    {
        if (!EnsureAdmin()) return;
        pendingDelete = supplier;
        if (deleteDialog is not null) await deleteDialog.ShowAsync();
    }

    private string DeleteMessage()
    {
        var count = pendingDelete == null ? 0 : invoices.Count(i => i.SupplierId == pendingDelete.Id);
        return count == 0
            ? "El proveedor desaparecerá del listado y ya no podrá elegirse en nuevas facturas."
            : $"El proveedor desaparecerá del listado. Sus {count} factura(s) registradas se conservan y quedarán como «Sin proveedor».";
    }

    private async Task DeleteSupplier(int id)
    {
        if (!EnsureAdmin()) return;
        var name = SupplierService.GetById(id)?.Name;
        SupplierService.Delete(id);
        LoadSuppliers();
        if (deleteDialog is not null) await deleteDialog.CloseAsync("deleted");
        if (name is not null) toast?.Show($"Proveedor «{name}» eliminado.", "warn");
    }

    private void HandleFormClosed(string _)
    {
        editingSupplier = new Supplier();
        formError = string.Empty;
    }

    private void HandleDeleteClosed(string _) => pendingDelete = null;
}
