@page "/cash"
@using GastroApp.Models
@using GastroApp.Services
@using System.Globalization
@inject CashRegisterService CashService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Caja</PageTitle>

<div class="page-container">
    <h1>💵 Caja Diaria</h1>
    @{
        // Resolve once per render, so a replaced current pointer cannot leave a stale header.
        cashRegister = CashService.GetCurrent();
        var paymentSummary = CashService.GetCurrentPaymentSummary();
    }
    @if (cashRegister != null)
    {
        <p>Caja #@cashRegister.Id — @(cashRegister.IsOpen ? "Abierta" : "Cerrada") · Apertura: @cashRegister.OpenDate.ToString("dd/MM/yyyy HH:mm")</p>
    }

    @if (!string.IsNullOrEmpty(closeMessage))
    {
        <p role="status">@closeMessage <a href="/summary">Ver resumen del día</a></p>
    }
    @if (!string.IsNullOrEmpty(countError) && cashRegister?.IsOpen != true)
    {
        @* A confirmation rejected because another circuit closed the session must stay visible. *@
        <p role="alert">@countError</p>
    }

    @if (cashRegister == null || !cashRegister.IsOpen)
    {
        <div class="form-card">
            <h3>Abrir Caja</h3>
            <p>Ingresá el monto inicial con el que empezás el día</p>

            <div class="form-group">
                <label>Monto Inicial</label>
                <input type="number" @bind="initialAmount" class="form-control" placeholder="0" step="0.01" />
            </div>

            <button class="btn btn-success btn-large" @onclick="OpenCash">
                ✅ Abrir Caja
            </button>
        </div>
    }
    else
    {
        <div class="cash-info">
            <div class="info-card">
                <h4>Apertura</h4>
                <p>@cashRegister.OpenDate.ToString("dd/MM/yyyy HH:mm")</p>
                <p class="amount">$@cashRegister.InitialAmount</p>
            </div>

            <div class="info-card">
                <h4>Efectivo ingresado en esta caja</h4>
                <p class="amount success">$@CashService.GetCashInflow(cashRegister.Id)</p>
            </div>

            <div class="info-card">
                <h4>Esperado en Caja</h4>
                <p class="amount">$@CashService.GetExpectedCash(cashRegister.Id)</p>
            </div>
        </div>

        <div class="form-card">
            <h3>Movimiento de efectivo</h3>
            <p>Registrá un ingreso, gasto o retiro de la caja abierta. Los movimientos no se pueden editar ni eliminar.</p>
            <div class="form-group">
                <label for="movement-type">Tipo</label>
                <select id="movement-type" @bind="movementType" class="form-control">
                    <option value="@CashMovementType.Income">Ingreso</option>
                    <option value="@CashMovementType.Expense">Gasto</option>
                    <option value="@CashMovementType.Withdrawal">Retiro</option>
                </select>
            </div>
            <div class="form-group">
                <label for="movement-amount">Monto</label>
                <input id="movement-amount" type="text" inputmode="decimal" @bind="movementAmount" class="form-control" placeholder="0" />
                <small>Mayor que cero, sin separador de miles. Separador decimal: @CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator</small>
            </div>
            <div class="form-group">
                <label for="movement-reason">Motivo (obligatorio)</label>
                <input id="movement-reason" type="text" @bind="movementReason" class="form-control" />
            </div>
            <button class="btn btn-success" @onclick="RecordMovement">Registrar movimiento</button>
            @if (!string.IsNullOrEmpty(movementMessage))
            {
                <p role="status">@movementMessage</p>
            }
        </div>

        var fresh = TryGetFreshReview();
        var stale = countReview == null || fresh == null || fresh != countReview;
        var (preview, previewError) = BuildPreview();
        var activeRows = countRows.Where(r => !IsBlank(r)).ToList();
        <div class="form-card">
            <h3>Arqueo y cierre de caja</h3>
            <p>Contá el efectivo por denominación. Las filas vacías se ignoran y el cierre es definitivo.</p>
            <p>Esperado en caja (según tu última revisión): <strong>@(countReview == null ? "—" : $"${countReview.ExpectedAmount}")</strong></p>

            @if (stale)
            {
                <div class="alert alert-warning" role="alert">
                    <p>@StaleText(fresh)</p>
                    <button class="btn btn-secondary" @onclick="RefreshCountReview">Actualizar saldo esperado</button>
                </div>
            }
            @if (!string.IsNullOrEmpty(countNotice))
            {
                <div class="alert alert-warning" role="alert">@countNotice</div>
            }

            @for (var i = 0; i < countRows.Count; i++)
            {
                var row = countRows[i];
                var number = i + 1;
                var rowError = ParseRow(row, out _);
                var activeIndex = activeRows.IndexOf(row);
                <div class="count-row" @key="row">
                    <div class="form-group">
                        <label for="count-denomination-@number">Denominación</label>
                        <input id="count-denomination-@number" type="text" inputmode="decimal" class="form-control" placeholder="0"
                               @bind="row.Denomination" @bind:after="ResetConfirmation" />
                    </div>
                    <div class="form-group">
                        <label for="count-quantity-@number">Cantidad</label>
                        <input id="count-quantity-@number" type="text" inputmode="numeric" class="form-control" placeholder="0"
                               @bind="row.Quantity" @bind:after="ResetConfirmation" />
                    </div>
                    <div class="form-group">
                        <label>Subtotal</label>
                        <div class="count-subtotal">@(preview != null && activeIndex >= 0 ? $"${preview.Lines[activeIndex].Subtotal}" : "—")</div>
                    </div>
                    <div class="form-group">
                        <button class="btn btn-secondary btn-small" type="button" @onclick="() => RemoveCountRow(row)">Quitar</button>
                    </div>
                    @if (rowError != null)
                    {
                        <div class="count-row-error" role="alert">Fila @number: @rowError</div>
                    }
                </div>
            }
            <button class="btn btn-secondary" type="button" @onclick="AddCountRow">Agregar denominación</button>
            <small>Denominación mayor que cero, sin separador de miles. Separador decimal: @CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator</small>

            @if (previewError != null)
            {
                <p role="alert">@previewError</p>
            }
            <div class="cash-info">
                <div class="info-card">
                    <h4>Total contado</h4>
                    <p class="amount">@(preview == null ? "—" : $"${preview.CountedAmount}")</p>
                </div>
                <div class="info-card">
                    <h4>Esperado en caja</h4>
                    <p class="amount">@(countReview == null ? "—" : $"${countReview.ExpectedAmount}")</p>
                </div>
            </div>
            @if (preview != null)
            {
                <div class="difference @DifferenceClass(preview.Difference)">
                    Diferencia: @DifferenceLabel(preview.Difference) (@(preview.Difference > 0m ? "+" : "")$@preview.Difference)
                </div>
            }

            <div class="form-group">
                <label for="count-reason">Motivo de la diferencia (@(preview != null && preview.Difference != 0m ? "obligatorio" : "opcional si el cierre es exacto"))</label>
                <textarea id="count-reason" class="form-control" rows="2" @bind="countReason" @bind:after="ResetConfirmation"></textarea>
            </div>

            @if (!string.IsNullOrEmpty(countError))
            {
                <p role="alert">@countError</p>
            }
            @if (!confirmingClose)
            {
                <button class="btn btn-danger btn-large" @onclick="ReviewClose" disabled="@stale">Revisar cierre</button>
            }
            else if (preview != null && !stale)
            {
                <div class="form-card" role="region" aria-label="Confirmación de cierre">
                    <h4>Confirmá el cierre</h4>
                    <p>Total contado: $@preview.CountedAmount</p>
                    <p>Esperado en caja: $@preview.ExpectedAmount</p>
                    <p>Diferencia: @DifferenceLabel(preview.Difference) ($@preview.Difference)</p>
                    <p>Motivo: @(string.IsNullOrWhiteSpace(countReason) ? "Sin motivo (cierre exacto)" : countReason.Trim())</p>
                    @if (preview.CountedAmount == 0m)
                    {
                        <div class="form-group">
                            <label><input type="checkbox" id="count-zero-confirmed" @bind="zeroConfirmed" /> Confirmo que el efectivo contado es cero</label>
                        </div>
                    }
                    <div class="form-actions">
                        <button class="btn btn-danger" @onclick="CloseCash" disabled="@(preview.CountedAmount == 0m && !zeroConfirmed)">Confirmar cierre definitivo</button>
                        <button class="btn btn-secondary" @onclick="ResetConfirmation">Volver a editar</button>
                    </div>
                </div>
            }
        </div>
    }
    @if (cashRegister != null && !cashRegister.IsOpen)
    {
        var count = CashService.GetCount(cashRegister.Id);
        <div class="form-card">
            @if (count == null)
            {
                <h3>Cierre sin arqueo</h3>
                <p>Esta caja se cerró sin arqueo detallado.</p>
                <p>Esperado: $@cashRegister.ExpectedAmount</p>
                <p>Monto final: $@cashRegister.FinalAmount</p>
                <p>Diferencia: $@cashRegister.Difference</p>
            }
            else
            {
                <h3>Arqueo registrado</h3>
                <p>Responsable: @count.Username (ID @count.UserId)</p>
                <p>Fecha: @count.CountedAt.ToString("dd/MM/yyyy HH:mm")</p>
                <p>Esperado: $@count.ExpectedAmount</p>
                <p>Contado: $@count.CountedAmount</p>
                <div class="difference @DifferenceClass(count.Difference)">
                    Diferencia: @DifferenceLabel(count.Difference) (@(count.Difference > 0m ? "+" : "")$@count.Difference)
                </div>
                <p>Motivo: @(string.IsNullOrWhiteSpace(count.Reason) ? "Sin motivo (cierre exacto)" : count.Reason)</p>
                <div style="overflow-x: auto;">
                    <table class="table">
                        <thead><tr><th>Denominación</th><th>Cantidad</th><th>Subtotal</th></tr></thead>
                        <tbody>
                            @foreach (var line in count.Lines)
                            {
                                <tr><td>$@line.Denomination</td><td>@line.Quantity</td><td>$@line.Subtotal</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    <div class="form-card">
        <h3>Cobros registrados por medio de pago</h3>
        <p>Importes aplicados a las ventas de esta caja, incluidas las canceladas: no se revierten los cobros.
            No son las ventas completadas del día ni el efectivo disponible en caja.
            No incluyen monto inicial, movimientos manuales, efectivo entregado ni vuelto.</p>
        <p role="status">@PaymentStateLabel(paymentSummary.State)</p>
        <div style="overflow-x: auto;">
            <table class="table">
                <thead><tr><th>Medio de pago</th><th>Importe registrado</th></tr></thead>
                <tbody>
                    @foreach (var row in paymentSummary.Rows)
                    {
                        <tr @key="row.Method"><td>@PaymentLabel(row.Method)</td><td>@(row.Amount.HasValue ? $"${row.Amount.Value}" : "No disponible")</td></tr>
                    }
                </tbody>
                <tfoot><tr><th>Total de cobros registrados</th><td>@(paymentSummary.RegisteredTotal.HasValue ? $"${paymentSummary.RegisteredTotal.Value}" : "No disponible")</td></tr></tfoot>
            </table>
        </div>
        @foreach (var warning in paymentSummary.Warnings)
        {
            <p role="alert">@warning.Message Registros afectados: @warning.Count.</p>
        }
    </div>
    @if (cashRegister != null)
    {
        var movements = CashService.GetCurrentMovements();
        <div class="form-card">
            <h3>Movimientos de esta caja</h3>
            @if (movements.Count == 0)
            {
                <p>No hay movimientos registrados.</p>
            }
            else
            {
                <div style="overflow-x: auto;">
                    <table class="table">
                        <thead>
                            <tr><th>ID</th><th>Fecha</th><th>Tipo</th><th>Monto</th><th>Responsable</th><th>Motivo</th><th>Venta</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var movement in movements)
                            {
                                <tr @key="movement.Id">
                                    <td>@movement.Id</td>
                                    <td>@movement.Date.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@MovementLabel(movement.Type)</td>
                                    <td>@(movement.Type == CashMovementType.Expense || movement.Type == CashMovementType.Withdrawal ? "−" : "+")$@movement.Amount</td>
                                    <td>@(string.IsNullOrWhiteSpace(movement.Username) ? "Sin responsable registrado" : movement.Username) @(movement.UserId.HasValue ? $"(ID {movement.UserId})" : "")</td>
                                    <td>@(string.IsNullOrWhiteSpace(movement.Reason) ? "Sin motivo registrado" : movement.Reason)</td>
                                    <td>@(movement.SaleId?.ToString() ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    @if (!string.IsNullOrEmpty(cashError))
    {
        <p role="alert">@cashError</p>
    }
</div>

@code {
    private CashRegister? cashRegister;
    private decimal initialAmount;
    private sealed class CountRow
    {
        public string Denomination { get; set; } = string.Empty;
        public string Quantity { get; set; } = string.Empty;
    }

    private readonly List<CountRow> countRows = new() { new CountRow() };
    private CashCountReview? countReview; // Snapshot the counter reviewed; refreshed only explicitly.
    private string? countReason;
    private bool confirmingClose;
    private bool zeroConfirmed;
    private string? countNotice;
    private string? closeMessage;
    private string? cashError;
    private string? countError; // Count-flow errors render inside the arqueo card, next to its buttons.
    private CashMovementType movementType = CashMovementType.Income;
    private string movementAmount = string.Empty;
    private string? movementReason;
    private string? movementMessage;

    private static string PaymentStateLabel(CashPaymentSummaryState state) => state switch
    {
        CashPaymentSummaryState.NoSession => "Sin sesión de caja seleccionada; no hay cobros atribuibles.",
        CashPaymentSummaryState.Complete => "Resumen completo para esta sesión.",
        CashPaymentSummaryState.Partial => "Resumen parcial: revisá las advertencias. Solo se incluyen ventas con pagos válidos y vinculadas a esta caja.",
        _ => "Resumen no disponible; no se muestran importes por desbordamiento decimal."
    };

    private static string PaymentLabel(PaymentMethod method) => method switch
    {
        PaymentMethod.Cash => "Efectivo",
        PaymentMethod.DebitCard => "Tarjeta de débito",
        PaymentMethod.CreditCard => "Tarjeta de crédito",
        PaymentMethod.Transfer => "Transferencia",
        PaymentMethod.MercadoPago => "Mercado Pago",
        _ => "Otro"
    };

    private static string MovementLabel(CashMovementType type) => type switch
    {
        CashMovementType.Sale => "Venta",
        CashMovementType.Income => "Ingreso",
        CashMovementType.Expense => "Gasto",
        CashMovementType.Withdrawal => "Retiro",
        _ => "Tipo desconocido"
    };

    private void RecordMovement()
    {
        if (!EnsureAdmin()) return;
        cashError = null;
        movementMessage = null;
        // Resolve again at click time; a singleton service must never retain circuit auth.
        var actor = AuthService.CurrentUser;
        if (actor == null || actor.Role != UserRole.Admin)
        {
            EnsureAdmin();
            return;
        }
        if (!decimal.TryParse(movementAmount, NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint
            | NumberStyles.AllowLeadingWhite | NumberStyles.AllowTrailingWhite, CultureInfo.CurrentCulture, out var amount)
            || amount <= 0m)
        {
            cashError = "Ingresá un monto decimal válido mayor que cero, sin separador de miles.";
            return;
        }
        try
        {
            CashService.AddManualMovement(movementType, amount, movementReason, actor);
            cashRegister = CashService.GetCurrent();
            movementMessage = $"{MovementLabel(movementType)} de ${amount} registrado en caja.";
            movementAmount = string.Empty;
            movementReason = null;
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            cashError = ex.Message;
            cashRegister = CashService.GetCurrent();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!EnsureAdmin()) return;

        cashRegister = CashService.GetCurrent();
        if (cashRegister?.IsOpen == true) countReview = TryGetFreshReview();
        await Task.CompletedTask;
    }

    private bool EnsureAdmin()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return false;
        }
        if (!AuthService.IsInRole(UserRole.Admin))
        {
            Navigation.NavigateTo("/unauthorized");
            return false;
        }
        return true;
    }

    private void OpenCash()
    {
        if (!EnsureAdmin()) return;
        cashError = null;
        try
        {
            CashService.Open(initialAmount);
            cashRegister = CashService.GetCurrent();
            initialAmount = 0;
            closeMessage = null;
            ResetCountForm();
            countReview = TryGetFreshReview();
        }
        catch (InvalidOperationException ex) { cashError = ex.Message; }
    }

    private const NumberStyles DecimalStyles = NumberStyles.AllowLeadingSign | NumberStyles.AllowDecimalPoint
        | NumberStyles.AllowLeadingWhite | NumberStyles.AllowTrailingWhite;
    private const NumberStyles IntegerStyles = NumberStyles.AllowLeadingSign
        | NumberStyles.AllowLeadingWhite | NumberStyles.AllowTrailingWhite;

    private static bool IsBlank(CountRow row) =>
        string.IsNullOrWhiteSpace(row.Denomination) && string.IsNullOrWhiteSpace(row.Quantity);

    // Raw-text parsing only; value rules (positive denomination, quantity, duplicates) live in the service.
    private static string? ParseRow(CountRow row, out CashCountLineInput? input)
    {
        input = null;
        if (IsBlank(row)) return null;
        if (string.IsNullOrWhiteSpace(row.Denomination)) return "Indicá la denominación.";
        if (string.IsNullOrWhiteSpace(row.Quantity)) return "Indicá la cantidad.";
        if (!decimal.TryParse(row.Denomination, DecimalStyles, CultureInfo.CurrentCulture, out var denomination))
            return "La denominación no es un número decimal válido, sin separador de miles.";
        if (!int.TryParse(row.Quantity, IntegerStyles, CultureInfo.CurrentCulture, out var quantity))
            return "La cantidad debe ser un número entero.";
        input = new CashCountLineInput(denomination, quantity);
        return null;
    }

    private bool TryBuildLines(out List<CashCountLineInput> lines, out string? error)
    {
        lines = new List<CashCountLineInput>();
        error = null;
        for (var i = 0; i < countRows.Count; i++)
        {
            var rowError = ParseRow(countRows[i], out var input);
            if (rowError != null)
            {
                error = $"Fila {i + 1}: {rowError}";
                return false;
            }
            if (input != null) lines.Add(input);
        }
        return true;
    }

    private (CashCountPreview? Preview, string? Error) BuildPreview()
    {
        if (countReview == null) return (null, null);
        if (!TryBuildLines(out var lines, out _)) return (null, "Corregí las filas marcadas antes de continuar.");
        try { return (CashService.PreviewCount(lines, countReview.ExpectedAmount), null); }
        catch (InvalidOperationException ex) { return (null, ex.Message); }
    }

    private CashCountReview? TryGetFreshReview()
    {
        try { return CashService.GetCountReview(); }
        catch (InvalidOperationException) { return null; }
    }

    private string StaleText(CashCountReview? fresh) => countReview == null || fresh == null
        ? "No se pudo verificar el saldo esperado. Actualizá el saldo esperado para continuar."
        : StaleMessage(countReview, fresh);

    private static string StaleMessage(CashCountReview before, CashCountReview now) =>
        $"El saldo esperado cambió mientras contabas (antes ${before.ExpectedAmount}, ahora ${now.ExpectedAmount}). Revisá el arqueo nuevamente.";

    private static string DifferenceLabel(decimal difference) =>
        difference < 0m ? "Faltante" : difference > 0m ? "Sobrante" : "Exacto";

    private static string DifferenceClass(decimal difference) =>
        difference < 0m ? "negative" : difference > 0m ? "positive" : "exact";

    private void ResetConfirmation()
    {
        confirmingClose = false;
        zeroConfirmed = false;
    }

    private void ResetCountForm()
    {
        countRows.Clear();
        countRows.Add(new CountRow());
        countReason = null;
        countNotice = null;
        countError = null;
        ResetConfirmation();
    }

    private void AddCountRow()
    {
        countRows.Add(new CountRow());
        ResetConfirmation();
    }

    private void RemoveCountRow(CountRow row)
    {
        countRows.Remove(row);
        if (countRows.Count == 0) countRows.Add(new CountRow());
        ResetConfirmation();
    }

    private void RefreshCountReview()
    {
        if (!EnsureAdmin()) return;
        countError = null;
        countNotice = null;
        ResetConfirmation();
        countReview = TryGetFreshReview();
        if (countReview == null) countError = "No hay caja abierta";
    }

    // Step one: validate everything the user can fix, then show the confirmation panel.
    private void ReviewClose()
    {
        if (!EnsureAdmin()) return;
        countError = null;
        countNotice = null;
        ResetConfirmation();
        var actor = AuthService.CurrentUser;
        if (actor == null || actor.Role != UserRole.Admin)
        {
            EnsureAdmin();
            return;
        }
        cashRegister = CashService.GetCurrent();
        if (cashRegister?.IsOpen != true)
        {
            countError = "No hay caja abierta";
            return;
        }
        var fresh = TryGetFreshReview();
        if (countReview == null || fresh == null || fresh != countReview)
        {
            countNotice = StaleText(fresh);
            return;
        }
        if (!TryBuildLines(out var lines, out var rowError))
        {
            countError = rowError;
            return;
        }
        try
        {
            var preview = CashService.PreviewCount(lines, countReview.ExpectedAmount);
            if (preview.Difference != 0m && string.IsNullOrWhiteSpace(countReason))
            {
                countError = "Debe indicar un motivo para la diferencia.";
                return;
            }
        }
        catch (InvalidOperationException ex)
        {
            countError = ex.Message;
            return;
        }
        confirmingClose = true;
    }

    // Step two: the service revalidates actor, session, review, lines, reason and confirmations.
    private void CloseCash()
    {
        if (!EnsureAdmin()) return;
        countError = null;
        // Resolve again at click time; a singleton service must never retain circuit auth.
        var actor = AuthService.CurrentUser;
        if (actor == null || actor.Role != UserRole.Admin)
        {
            EnsureAdmin();
            return;
        }
        var reviewed = countReview;
        if (!confirmingClose || reviewed == null)
        {
            countError = "Revisá el cierre antes de confirmarlo.";
            return;
        }
        if (!TryBuildLines(out var lines, out var rowError))
        {
            countError = rowError;
            ResetConfirmation();
            return;
        }
        try
        {
            CashService.Close(new CashCountRequest
            {
                Review = reviewed, Lines = lines, Reason = countReason,
                Confirmed = true, ZeroCountConfirmed = zeroConfirmed
            }, actor);
            cashRegister = CashService.GetCurrent();
            countReview = null;
            ResetCountForm();
            closeMessage = "Caja cerrada. Arqueo registrado.";
        }
        catch (CashCountReviewOutdatedException ex)
        {
            ResetConfirmation();
            countNotice = StaleMessage(reviewed, ex.Current);
            countReview = ex.Current;
        }
        catch (Exception ex) when (ex is InvalidOperationException or UnauthorizedAccessException)
        {
            countError = ex.Message;
            cashRegister = CashService.GetCurrent();
        }
    }
}
