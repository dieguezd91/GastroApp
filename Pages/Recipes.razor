@page "/recipes"
@using GastroApp.Models
@using GastroApp.Services
@using GastroApp.Shared.Recipes
@inject RecipeService RecipeService
@inject IngredientService IngredientService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Recetas</PageTitle>

@if (AuthService.IsAuthenticated && AuthService.IsInRole(UserRole.Admin))
{
    @if (showForm)
    {
        <RecipeWorkspace Recipe="editingRecipe" Ingredients="activeIngredients" FormError="@formError" BuilderError="@builderError"
                         YieldText="@yieldText" YieldTextChanged="SetYield"
                         SelectedIngredientId="selectedIngredientId" SelectedIngredientIdChanged="SelectIngredient"
                         QuantityText="@ingredientQuantityText" QuantityTextChanged="SetQuantity"
                         Unit="@ingredientUnit" UnitChanged="SetUnit"
                         OnAdd="AddIngredient" OnRemove="RemoveIngredient" OnSave="SaveRecipe" OnCancel="CancelEdit" />
    }
    else
    {
        <div class="page-header">
            <div>
                <h1 tabindex="-1" @ref="listHeading">Recetas y costos</h1>
                <p class="page-header__subtitle">Costo calculado con el último precio de factura de cada ingrediente. Variación: menos de 10% estable, de 10% a 30% media, 30% o más alta.</p>
            </div>
            <div class="page-header__actions">
                <a href="/products" class="btn">
                    <Icon Name="products" Size="17" />
                    <span>Ver productos</span>
                </a>
                <button type="button" class="btn btn--primary" @onclick="ShowAddForm">
                    <Icon Name="plus" Size="17" />
                    <span>Nueva receta</span>
                </button>
            </div>
        </div>

        <div class="stack">
            <p class="proposal-note" role="note">
                <span class="proposal-note__icon"><Icon Name="info" Size="15" /></span>
                <span><strong>Vínculo actual:</strong> el descuento de stock al vender busca una receta con el mismo nombre exacto que el producto.</span>
            </p>

            @if (recipes.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state__icon"><Icon Name="recipes" Size="24" /></div>
                    <div class="stack stack--sm">
                        <h3>Todavía no hay recetas cargadas</h3>
                        <p class="text-sm text-secondary">Creá recetas estandarizadas con varios ingredientes para calcular costos y descontar stock al vender.</p>
                    </div>
                    <div class="mt-2">
                        <button type="button" class="btn btn--primary" @onclick="ShowAddForm">Crear primera receta</button>
                    </div>
                </div>
            }
            else
            {
                <div class="grid-2 recipe-grid">
                    @foreach (var recipe in recipes)
                    {
                        <RecipeCard @key="recipe.Id" Recipe="recipe" OnEdit="EditRecipe" OnRecalculate="RecalculateCostOf" OnDelete="ConfirmDelete" />
                    }
                </div>
            }
        </div>
    }

    <ModalDialog @ref="deleteDialog" Title="@($"¿Eliminar la receta «{pendingDelete?.Name}»?")" Size="md" OnClosed="HandleDeleteClosed">
        <ChildContent>
            <p>Se eliminará la receta estandarizada. Los productos con el mismo nombre dejarán de descontar stock automáticamente al vender.</p>
        </ChildContent>
        <Footer>
            <button value="cancel" class="btn" autofocus>Cancelar</button>
            <button type="button" class="btn btn--danger" @onclick="() => DeleteRecipe(pendingDelete?.Id ?? 0)">Eliminar receta</button>
        </Footer>
    </ModalDialog>

    <Toast @ref="toast" />
}

@code {
    private List<Recipe> recipes = new();
    private List<Ingredient> activeIngredients = new();
    private Recipe editingRecipe = new();
    private Recipe? pendingDelete;
    private bool showForm = false;

    // Form state
    private string yieldText = "1";
    private string formError = string.Empty;
    private string builderError = string.Empty;

    // Ingredient picker
    private int selectedIngredientId = 0;
    private string ingredientQuantityText = string.Empty;
    private string ingredientUnit = string.Empty;

    private ElementReference listHeading;
    private bool focusListHeading;
    private ModalDialog? deleteDialog;
    private Toast? toast;

    protected override async Task OnInitializedAsync()
    {
        if (!EnsureAdmin()) return;

        LoadData();
        await Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Back from the workspace: put focus on the list heading, like the prototype.
        if (!focusListHeading || showForm) return;
        focusListHeading = false;
        await listHeading.FocusAsync();
    }

    private bool EnsureAdmin()
    {
        if (!AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login");
            return false;
        }
        if (!AuthService.IsInRole(UserRole.Admin))
        {
            Navigation.NavigateTo("/unauthorized");
            return false;
        }
        return true;
    }

    private void LoadData()
    {
        recipes = RecipeService.GetAll();
        activeIngredients = IngredientService.GetActive();
    }

    private void ShowAddForm()
    {
        if (!EnsureAdmin()) return;
        activeIngredients = IngredientService.GetActive();
        editingRecipe = new Recipe { Yield = 1 };
        OpenForm();
    }

    private void OpenForm()
    {
        yieldText = editingRecipe.Yield.ToString();
        formError = string.Empty;
        builderError = string.Empty;
        ResetPicker();
        showForm = true;
    }

    private void ResetPicker()
    {
        selectedIngredientId = 0;
        ingredientQuantityText = string.Empty;
        ingredientUnit = string.Empty;
    }

    private void SetYield(string? text)
    {
        if (!EnsureAdmin()) return;
        yieldText = text ?? string.Empty;
        // A value that is not a whole number leaves the yield at 0, which the save validation rejects.
        editingRecipe.Yield = int.TryParse(yieldText, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var parsed) ? parsed : 0;
    }

    private void SelectIngredient(int ingredientId)
    {
        if (!EnsureAdmin()) return;
        selectedIngredientId = ingredientId;
        var ingredient = ingredientId == 0 ? null : IngredientService.GetById(ingredientId);
        // Poka-yoke: the unit always restarts from a unit compatible with the new ingredient (gr / ml preselected).
        ingredientUnit = ingredient == null ? string.Empty : RecipeFormat.DefaultUnit(ingredient.Unit);
        builderError = string.Empty;
    }

    private void SetQuantity(string? text)
    {
        if (!EnsureAdmin()) return;
        ingredientQuantityText = text ?? string.Empty;
    }

    private void SetUnit(string unit)
    {
        if (!EnsureAdmin()) return;
        var ingredient = selectedIngredientId == 0 ? null : IngredientService.GetById(selectedIngredientId);
        if (ingredient == null || !RecipeFormat.UnitOptions(ingredient.Unit).Contains(unit)) return;
        ingredientUnit = unit;
    }

    private void AddIngredient()
    {
        if (!EnsureAdmin()) return;
        if (selectedIngredientId == 0)
        {
            builderError = "Seleccioná un ingrediente.";
            return;
        }
        if (!RecipeFormat.TryParseQuantity(ingredientQuantityText, out var quantity) || quantity <= 0)
        {
            builderError = "Ingresá una cantidad mayor a cero antes de agregar el ingrediente.";
            return;
        }

        var ingredient = IngredientService.GetById(selectedIngredientId);
        if (ingredient == null)
        {
            builderError = "El ingrediente seleccionado ya no existe.";
            return;
        }
        // The control only offers compatible units; this keeps the rule even if a stale unit slips through.
        if (!UnitConverter.AreCompatible(ingredientUnit, ingredient.Unit))
        {
            builderError = $"La unidad {ingredientUnit} no es compatible con {ingredient.Name} ({ingredient.Unit}).";
            return;
        }

        var lastPrice = IngredientService.GetLastPrice(ingredient.Id) ?? 0;

        editingRecipe.Ingredients.Add(new RecipeIngredient
        {
            IngredientId = ingredient.Id,
            IngredientName = ingredient.Name,
            Quantity = quantity,
            Unit = ingredientUnit,
            UnitPrice = lastPrice,
            Subtotal = (UnitConverter.Convert(quantity, ingredientUnit, ingredient.Unit) ?? quantity) * lastPrice
        });

        // Reset
        builderError = string.Empty;
        formError = string.Empty;
        ResetPicker();
    }

    private void RemoveIngredient(RecipeIngredient item)
    {
        if (!EnsureAdmin()) return;
        editingRecipe.Ingredients.Remove(item);
        builderError = string.Empty;
    }

    private string? ValidateRecipe()
    {
        if (string.IsNullOrWhiteSpace(editingRecipe.Name))
            return "Ingresá un nombre para la receta.";
        if (editingRecipe.Yield <= 0)
            return "El rendimiento debe ser de al menos 1 porción.";
        if (!editingRecipe.Ingredients.Any())
            return "Agregá al menos un ingrediente a la receta.";
        return null;
    }

    private void SaveRecipe()
    {
        if (!EnsureAdmin()) return;
        var error = ValidateRecipe();
        if (error != null)
        {
            formError = error;
            return;
        }

        var creating = editingRecipe.Id == 0;
        var name = editingRecipe.Name;
        if (creating)
        {
            RecipeService.Add(editingRecipe);
        }
        else
        {
            RecipeService.Update(editingRecipe);
        }

        LoadData();
        CancelEdit();
        toast?.Show(creating ? $"Receta «{name}» creada y costeada." : $"Receta «{name}» actualizada y recosteada.");
    }

    private void EditRecipe(Recipe recipe)
    {
        if (!EnsureAdmin()) return;
        activeIngredients = IngredientService.GetActive();
        // Crear copia profunda para editar
        editingRecipe = new Recipe
        {
            Id = recipe.Id,
            Name = recipe.Name,
            Yield = recipe.Yield,
            Ingredients = recipe.Ingredients.Select(RecipeFormat.CopyOf).ToList()
        };

        OpenForm();
    }

    private void RecalculateCost(int recipeId)
    {
        if (!EnsureAdmin()) return;
        var recipe = RecipeService.GetById(recipeId);
        if (recipe != null)
        {
            RecipeService.CalculateCosts(recipe);
            RecipeService.Update(recipe);
            LoadData();
            toast?.Show($"Receta «{recipe.Name}» recalculada: {RecipeFormat.Money(recipe.UnitCost)} por porción.");
        }
    }

    private void RecalculateCostOf(Recipe recipe) => RecalculateCost(recipe.Id);

    private async Task ConfirmDelete(Recipe recipe)
    {
        if (!EnsureAdmin()) return;
        pendingDelete = recipe;
        if (deleteDialog is not null) await deleteDialog.ShowAsync();
    }

    private async Task DeleteRecipe(int id)
    {
        if (!EnsureAdmin()) return;
        var name = RecipeService.GetById(id)?.Name;
        RecipeService.Delete(id);
        LoadData();
        if (deleteDialog is not null) await deleteDialog.CloseAsync("deleted");
        if (name is not null) toast?.Show($"Receta «{name}» eliminada.");
    }

    private void HandleDeleteClosed(string _) => pendingDelete = null;

    private void CancelEdit()
    {
        showForm = false;
        focusListHeading = true;
        editingRecipe = new Recipe();
        yieldText = "1";
        formError = string.Empty;
        builderError = string.Empty;
        ResetPicker();
    }
}
